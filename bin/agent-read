#!/usr/bin/env bash
#
# agent-read - Show another Claude, Codex, or pi session's conversation as
# readable turns
#
# Usage:
#   agent-read [path]                     # most-recent session in worktree (default: $PWD)
#   agent-read --all [path]               # list sessions in worktree, newest first
#   agent-read --peers [path]             # like --all but excludes the current Claude
#   agent-read --session <id-or-name>     # show a specific session by ID or rename-name
#   agent-read --console [path]           # the human's terminal recording for that worktree
#   agent-read --record [path]            # print the command that starts such a recording
#
# Render flags (apply to default and --session modes):
#   --turns N                         # render only the last N readable turns
#   --since <when>                    # render turns at/after <when>:
#                                     #   ISO 8601 (2026-05-14T14:30:00Z)
#                                     #   relative duration (30m, 1h, 2d, 90s)
#   --follow, -f                      # after historical render, stream new turns
#                                     # as they're appended (Ctrl-C to stop)
#
# Selection flags (apply to default, --all, and --peers modes):
#   --exclude <id-or-name>            # skip this session (repeatable)
#
# Worktree mode resolves $path → ~/.claude/projects/<encoded-path>/ and picks the
# .jsonl with the newest mtime (the active or most recently active session).
# Path encoding replaces every non-alphanumeric character with '-'.
#
# --codex and --pi read other agents' on-disk transcripts instead (~/.codex,
# ~/.pi/agent/sessions); see the codex_sessions_dir/pi_sessions_dir comments
# below for how their directory layout, path encoding, and file naming differ
# from Claude's.
#
# Session names: if a session has been given a name via /rename, listings show
# it in a 'name' column and --session/--exclude accept it in place of the UUID.
# Names are sourced from ~/.claude/sessions/<pid>.json for live sessions, with
# a fallback to the latest "Session renamed to:" event in the .jsonl for exited
# sessions. Codex and pi record no /rename equivalent, so --session takes only
# a UUID for those sources.
#
# Output is one block per turn (user prompts + assistant text), oldest-first.
# Tool calls, tool results, thinking blocks, and meta entries are filtered out.
#
# Token-economics note for Claude observers:
#   --follow streams every new turn → high token cost when used by a Claude
#   instance. For Claude-driven observation, prefer polling with --since
#   <last-read-ts> on a controlled cadence. --follow is intended for humans
#   watching in a terminal pane (zero tokens).
#
# The human is a peer too. When they run
#   script -F -q .my-console.log
# in their own terminal, everything they see — test runs, server output, stack
# traces — lands in that file, live (-F flushes on every write). --console reads
# it back; --record prints the command to start one. Claude cannot start the
# recording itself: script(1) has to wrap the human's interactive shell, not a
# tool-call subshell.
#
# script(1) typescripts are raw terminal output: ANSI color, OSC title-set
# sequences, carriage-return progress redraws, its own "Script started on"
# banner. --console strips all of that, so what reaches a reader is roughly what
# a human's eye resolved on screen.
#
# Requires: super (SuperDB), perl (console cleaning).
#

set -euo pipefail
shopt -s nullglob

# Silence SIGPIPE write errors when output is piped to head/less/etc.
trap '' PIPE

# Console recordings live at the worktree root, one per terminal pane, named
# .<tag>-console.log — .main-console.log, .tests-console.log, .server-console.log.
# The tag is how a pane is addressed (--tag tests) and how it's labelled on read.
#
# CONSOLE_GLOB is both the discovery pattern and a valid gitignore line: one entry
# in the global excludes file means every log agent-read can find is already
# ignored, in every repo, with no per-repo .gitignore edit ever. It's deliberately
# looser than the .<tag>-console.log convention so an off-convention name (an old
# .my-console.log, say) is still found rather than silently invisible.
CONSOLE_GLOB=".*console*.log"
DEFAULT_CONSOLE_TAG="main"

# How much of each pane --console hands back by default. A day's typescript is
# enormous and every line costs a reader tokens. Applied per pane, so adding a
# quiet server pane can't blow up the cost of reading the busy one.
DEFAULT_TAIL=200

# The window a --new read falls back to the first time it sees a stream, before a
# cursor exists. Deliberately small: a first read is orientation, not archaeology.
DEFAULT_NEW_TURNS=10

usage() {
  cat <<-EOF
	Usage: agent-read <path> [flags]
	       agent-read --all [path] [flags]
	       agent-read --peers [path] [flags]
	       agent-read --session <id-or-name> [render flags]
	       agent-read --console-list [path]
	       agent-read --console [path] [--tag T] [--tail N] [-f]
	       agent-read --record [path] [--tag T]

	Selection:
	  <path>                 most-recent session in that worktree
	  --all [path]           list all agents' sessions in worktree, newest first
	  --peers [path]         like --all but excludes \$CLAUDE_CODE_SESSION_ID
	  --session <id-or-name> show a specific session by UUID or /rename name
	  --exclude <id-or-name> skip this session (repeatable; with --all/--peers)

	Source:
	  (default: auto)        --all/--peers include all three sources. A single-session
	                         read picks the most recently active source and names
	                         the others on stderr. --session tries all three.
	  --codex                force Codex (~/.codex) sessions. The worktree is matched
	                         on each rollout's recorded cwd. Not supported for Codex:
	                         --session by /rename name (no rename source), --all/
	                         --peers -f firehose (no per-turn session id to tag the
	                         merged stream), and console/record.
	  --pi                   force pi (~/.pi/agent/sessions) sessions. Not supported
	                         for pi (same reasons as Codex): --session by /rename
	                         name, --all/--peers -f firehose, and console/record.
	                         --peers also can't self-exclude for pi — there's no
	                         live-session registry to resolve \$CLAUDE_CODE_SESSION_ID
	                         against, so --pi --peers behaves like --pi --all.
	  --claude               force Claude sessions (the pre-auto behaviour).

	Render flags:
	  --new                only what arrived since THIS reader last looked. Works on
	                       sessions and consoles; keeps a cursor per (reader, stream).
	                       The cheap way to keep up — --turns/--tail re-read history
	                       you already paid for.
	  --turns N            render only the last N readable turns (per-session;
	                       not valid with --all/--peers)
	  --since <when>       ISO 8601 timestamp or relative duration (30m, 2h, 1d)
	  --follow, -f         stream new turns. Per-session: render historical then
	                       follow. With --all/--peers: firehose — interleave new
	                       turns from every matched session, tagged by short sid.

	The human's consoles (their terminals, recorded with script -F -q).
	One pane per concern, each in .<tag>-console.log at the worktree root:
	  --console-list [path]  what's recording: tag, modified, lines
	  --console [path]       read every pane, ANSI/redraw-stripped, each headed
	                         by its tag; oldest-written pane first
	  --tag T                with --console: just that pane
	                         with --record: name the pane being started
	  --tail N               with --console: last N lines per pane (default $DEFAULT_TAIL)
	  --record [path]        print the command the human runs to start a recording
	                         (Claude can't: script(1) needs a tty)

	Examples:
	  agent-read .
	  agent-read --peers
	  agent-read --session ee28f782-247b-4c7e-88c4-11417fa87154 --turns 20
	  agent-read --session axon-staging-19 --since 30m   # name set via /rename
	                                                     # cross-worktree
	  agent-read -f --since 5m .                          # human terminal watcher
	  agent-read --peers -f                               # firehose all peers
	  agent-read --console-list                           # which panes are recording
	  agent-read --console --tail 80                      # what the human just saw
	  agent-read --console --tag tests                    # only the test pane
	  agent-read --console --tag tests --new              # …only what's new since I looked
	  agent-read --peers --new                            # what peers said since I looked
	  agent-read --codex --peers                          # Codex sessions in this worktree
	  agent-read --codex --peers --new                    # what Codex peers said since I looked
	  agent-read --pi --peers                             # pi sessions in this worktree
	  agent-read --pi --peers --new                       # what pi peers said since I looked
	  agent-read --record --tag server                    # how they start a pane
	EOF
}

projects_dir="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"

# Codex (the OpenAI CLI) mirrors Claude's on-disk convention under ~/.codex, but
# with two structural differences agent-read has to bridge (issue #18):
#   1. Sessions are date-partitioned (YYYY/MM/DD/rollout-<ts>-<uuid>.jsonl), not
#      per-worktree — the worktree lives inside each file as payload.cwd.
#   2. Turns are typed lines (session_meta header, response_item/message turns),
#      not Claude's top-level {type:user|assistant, message}.
# --codex flips $SOURCE, and the discovery/render seams below dispatch on it. The
# cursor, --since, --follow, and --new machinery is reused unchanged: Codex lines
# carry the same top-level `timestamp` field Claude's do.
codex_sessions_dir="${AGENT_READ_CODEX_DIR:-$HOME/.codex/sessions}"

# pi (pi.dev) is worktree-partitioned like Claude (one directory per cwd, unlike
# Codex's date partitioning) but with its own path encoding and file naming:
#   1. The directory name replaces ONLY '/' with '-' (not every non-alphanumeric
#      char the way Claude's encode_path does — a real cwd's underscore survives
#      untouched) and wraps the whole thing in a DOUBLE leading/trailing '-':
#      /Users/x/y encodes to --Users-x-y-- , not Claude's -Users-x-y. Verified
#      byte-for-byte against real ~/.pi/agent/sessions data; pi_encode_path below
#      reproduces it. Do NOT reuse encode_path for pi — they diverge on any path
#      with a non-slash special character (dot, space, @, underscore, …).
#   2. Filenames are <timestamp>_<uuid>.jsonl — the uuid is the tail after the
#      last '_', not the whole basename like Claude's <uuid>.jsonl. Needs
#      tail-of-filename sid extraction like Codex's codex_sid_for.
#   3. Turns are type=message lines with message.role/message.content (content
#      is always an array, never a bare string). No isMeta field; other header
#      record types (session, model_change, thinking_level_change) are filtered
#      out by requiring type=='message'.
#   4. No /rename mechanism and no live-session registry (no analogue to
#      ~/.claude/sessions/<pid>.json or $CLAUDE_CODE_SESSION_ID) — so --session
#      by name is unsupported (like Codex) and --peers cannot self-exclude for
#      pi (the excluded id is a Claude session id, which just never matches a
#      pi UUID — same "--peers behaves like --all" shape as Codex's, but for a
#      different reason: Codex could in principle be asked to exclude, pi has
#      nothing on disk that could ever tell it which session is "self").
pi_sessions_dir="${AGENT_READ_PI_DIR:-$HOME/.pi/agent/sessions}"

# auto merges listings; single-session reads resolve to the freshest source.
SOURCE=auto

# ── Read cursors ───────────────────────────────────────────────────────────────
#
# Catching up on a peer stream with --tail/--turns re-reads what this reader has
# already seen, so the more often it checks, the more it pays to re-read its own
# history. A cursor makes catch-up cost O(new output) instead.
#
# Cursors are per (reader, stream): two Claudes following the same peer each keep
# their own idea of "what's new for me". The reader is $CLAUDE_CODE_SESSION_ID
# inside Claude Code; a plain shell shares one cursor namespace, which is fine —
# a human's `--new` is curiosity, not bookkeeping.
#
# The stored value differs by stream: a byte offset for a console typescript, the
# timestamp of the last rendered turn for a session .jsonl.
cursor_dir="${AGENT_READ_CURSOR_DIR:-$HOME/.claude/agent-read/cursors}"
reader_id="${CLAUDE_CODE_SESSION_ID:-shell}"

cursor_file() {
  local key="${1//\//-}"
  echo "$cursor_dir/$reader_id/$key"
}

cursor_get() {
  local f
  f="$(cursor_file "$1")"
  [[ -f "$f" ]] || return 0
  cat "$f"
}

cursor_set() {
  local f
  f="$(cursor_file "$1")"
  mkdir -p "${f%/*}"
  printf '%s\n' "$2" > "$f"
}

# Claude Code names a project dir by replacing EVERY non-alphanumeric character in
# the absolute path with '-', not just the slashes. The leading '/' becomes the
# leading '-' for free.
#
# Getting this wrong is a silent false negative — under a path like
#   /Users/me/Library/CloudStorage/GoogleDrive-chris.morris@dscout.com/My Drive/rig
# a '/'-only substitution keeps the '.', '@' and space, points at a directory that
# was never created, and reports "no sessions" while peers are actively running
# (issue #17). Sanitize the same way Claude does, or don't find anything.
encode_path() {
  printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g'
}

project_dir_for() {
  local path
  path="$(cd "$1" 2>/dev/null && pwd)" || {
    echo "agent-read: not a directory: $1" >&2
    exit 1
  }
  local encoded
  encoded="$(encode_path "$path")"
  echo "$projects_dir/$encoded"
}

# pi's encoding: strip the leading '/', replace remaining '/' with '-', wrap
# the result in a double leading/trailing '-'. Confirmed byte-for-byte against
# 13 real ~/.pi/agent/sessions directories — see the pi_sessions_dir comment.
pi_encode_path() {
  local body="${1#/}"
  body="$(printf '%s' "$body" | sed 's/\//-/g')"
  printf -- '--%s--' "$body"
}

pi_project_dir_for() {
  local path
  path="$(cd "$1" 2>/dev/null && pwd)" || {
    echo "agent-read: not a directory: $1" >&2
    exit 1
  }
  local encoded
  encoded="$(pi_encode_path "$path")"
  echo "$pi_sessions_dir/$encoded"
}

is_excluded() {
  # Guard the array expansion: bash 3.2 (macOS) + `set -u` errors on
  # `"${EXCLUDES[@]}"` when the array is empty.
  [[ ${#EXCLUDES[@]} -eq 0 ]] && return 1
  local sid="$1"
  local ex
  for ex in "${EXCLUDES[@]}"; do
    [[ "$sid" == "$ex" ]] && return 0
  done
  return 1
}

# Session names (set via /rename) live in two places:
#  1. ~/.claude/sessions/<pid>.json — for currently-running sessions
#  2. The session's .jsonl, recorded as the local_command stdout
#     "Session renamed to: NAME" — survives after the session exits
# We try (1) first, then fall back to (2).

sessions_meta_dir="${CLAUDE_SESSIONS_META_DIR:-$HOME/.claude/sessions}"

# sessionId<TAB>name lines for every live session that has a /rename name.
# Built lazily with one super call across all metadata files so per-session
# lookups are an in-memory string match. Bash 3.2 has no associative arrays,
# so we keep the cache as a TSV string and walk it.
SID_NAME_MAP_TSV=""
SID_NAME_MAP_LOADED=0

load_sid_name_map() {
  [[ "$SID_NAME_MAP_LOADED" -eq 1 ]] && return 0
  SID_NAME_MAP_LOADED=1
  local files=("$sessions_meta_dir"/*.json)
  [[ -e "${files[0]:-}" ]] || return 0
  SID_NAME_MAP_TSV=$(
    super -i json -f line -c \
      "where ['name'] in fields(this) and ['sessionId'] in fields(this) | values f'{sessionId}\t{name}'" \
      "${files[@]}" 2>/dev/null
  ) || true
}

# Look up a session's name from the live sessions metadata directory.
# Emits the name to stdout; exits 1 if not found.
name_from_live_sessions() {
  load_sid_name_map
  [[ -n "$SID_NAME_MAP_TSV" ]] || return 1
  local sid="$1" line
  while IFS= read -r line; do
    if [[ "$line" == "$sid"$'\t'* ]]; then
      echo "${line#*$'\t'}"
      return 0
    fi
  done <<< "$SID_NAME_MAP_TSV"
  return 1
}

# Reverse lookup: name → sessionId from the live sessions metadata directory.
sid_from_live_sessions() {
  load_sid_name_map
  [[ -n "$SID_NAME_MAP_TSV" ]] || return 1
  local target="$1" line
  while IFS= read -r line; do
    if [[ "$line" == *$'\t'"$target" ]]; then
      echo "${line%%$'\t'*}"
      return 0
    fi
  done <<< "$SID_NAME_MAP_TSV"
  return 1
}

# Cache of /rename names recorded in session .jsonl files across all
# worktrees. Built lazily with one super call so name lookups (forward and
# reverse) are an in-memory walk regardless of how many sessions exist.
#
# Actual rename events have type=='system' and subtype=='local_command', with
# the name in `content` wrapped in <local-command-stdout>…</local-command-stdout>
# tags. Filtering on type+subtype prevents false matches from tool results,
# code reads, or assistant turns that contain the literal phrase
# "Session renamed to:". The subtype test goes through fields(this) rather
# than has(subtype): super resolves a bare field reference at compile time
# against the input types it has inferred so far, and errors "no such field"
# when no record it has read declares that name. Same reason the isMeta
# filters in the render pipelines are written that way.
SID_NAME_DISK_MAP_TSV=""
SID_NAME_DISK_MAP_LOADED=0

load_sid_name_disk_map() {
  [[ "$SID_NAME_DISK_MAP_LOADED" -eq 1 ]] && return 0
  SID_NAME_DISK_MAP_LOADED=1
  local files=("$projects_dir"/*/*.jsonl)
  [[ -e "${files[0]:-}" ]] || return 0
  SID_NAME_DISK_MAP_TSV=$(
    super -i json -f line -c "
      where type == 'system' and ['subtype'] in fields(this) and subtype == 'local_command'
        and grep('Session renamed to:', this)
      | put _name := regexp('Session renamed to: ([^<]+)', cast(this, <string>))[1]
      | sort -r timestamp
      | summarize ns := collect(_name) by sessionId
      | values f'{sessionId}\t{ns[0]}'
    " "${files[@]}" 2>/dev/null
  ) || true
}

# Forward lookup: sessionId → name from the on-disk rename map.
name_from_disk_map() {
  load_sid_name_disk_map
  [[ -n "$SID_NAME_DISK_MAP_TSV" ]] || return 1
  local sid="$1" line
  while IFS= read -r line; do
    if [[ "$line" == "$sid"$'\t'* ]]; then
      echo "${line#*$'\t'}"
      return 0
    fi
  done <<< "$SID_NAME_DISK_MAP_TSV"
  return 1
}

# Reverse lookup: name → sessionId from the on-disk rename map. Scans every
# worktree, so this is the cross-worktree fallback for `--session <name>`.
sid_from_disk_map() {
  load_sid_name_disk_map
  [[ -n "$SID_NAME_DISK_MAP_TSV" ]] || return 1
  local target="$1" line
  while IFS= read -r line; do
    if [[ "$line" == *$'\t'"$target" ]]; then
      echo "${line%%$'\t'*}"
      return 0
    fi
  done <<< "$SID_NAME_DISK_MAP_TSV"
  return 1
}

session_name_for() {
  local sid="$1"
  local name
  name="$(name_from_live_sessions "$sid" 2>/dev/null || true)"
  if [[ -z "$name" ]]; then
    name="$(name_from_disk_map "$sid" 2>/dev/null || true)"
  fi
  echo "$name"
}

is_uuid() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

# Resolve an argument that is either a session UUID or a /rename name into a
# UUID. Searches live sessions first (cheap), then the on-disk rename map
# (covers every worktree). Cross-worktree by design — a name set anywhere on
# this machine will resolve.
resolve_session_id() {
  local arg="$1"
  if is_uuid "$arg"; then
    echo "$arg"
    return 0
  fi
  # Codex has no /rename source (no live-session metadata, no rename event), so a
  # non-UUID can't be resolved. Say so rather than falling through to the Claude
  # name maps, which would silently search the wrong source.
  if [[ "$SOURCE" == codex ]]; then
    echo "agent-read: --codex takes a session UUID; /rename names aren't recorded by Codex: $arg" >&2
    return 1
  fi
  # pi has no /rename source either (no live-session metadata, no rename event).
  if [[ "$SOURCE" == pi ]]; then
    echo "agent-read: --pi takes a session UUID; /rename names aren't recorded by pi: $arg" >&2
    return 1
  fi
  local sid
  if sid=$(sid_from_live_sessions "$arg"); then
    echo "$sid"
    return 0
  fi
  if sid=$(sid_from_disk_map "$arg"); then
    echo "$sid"
    return 0
  fi
  echo "agent-read: no session matching name: $arg" >&2
  return 1
}

filtered_sessions_in() {
  local dir="$1"
  local files=("$dir"/*.jsonl)
  if [[ ${#files[@]} -eq 0 ]]; then
    return 1
  fi
  local f sid f_mtime
  while IFS= read -r f; do
    sid="${f##*/}"
    sid="${sid%.jsonl}"
    is_excluded "$sid" && continue
    if [[ -n "${SINCE_EPOCH:-}" ]]; then
      f_mtime=$(stat -f '%m' "$f")
      [[ $f_mtime -ge $SINCE_EPOCH ]] || continue
    fi
    echo "$f"
  done < <(ls -t "${files[@]}")
}

mixed_session_records() {
  local target="$1" cwd dir pdir codex_out f
  cwd="$(cd "$target" 2>/dev/null && pwd)" || {
    echo "agent-read: not a directory: $target" >&2
    return 1
  }
  dir="$(project_dir_for "$target")"
  pdir="$(pi_project_dir_for "$target")"
  codex_out="$(codex_filtered_files "$cwd")"
  if [[ ! -d "$dir" && ! -d "$pdir" && -z "$codex_out" ]]; then
    if ! codex_freshest_mtime "$cwd" >/dev/null; then
      echo "agent-read: no sessions for $target" >&2
      return 1
    fi
  fi
  {
    while IFS= read -r f; do
      [[ -n "$f" ]] && printf '%s\tcodex\t%s\n' "$(stat -f '%m' "$f")" "$f"
    done <<< "$codex_out"
    if [[ -d "$dir" ]]; then
      while IFS= read -r f; do
        printf '%s\tclaude\t%s\n' "$(stat -f '%m' "$f")" "$f"
      done < <(filtered_sessions_in "$dir")
    fi
    if [[ -d "$pdir" ]]; then
      while IFS= read -r f; do
        printf '%s\tpi\t%s\n' "$(stat -f '%m' "$f")" "$f"
      done < <(pi_filtered_files "$pdir")
    fi
  } | sort -t $'\t' -k1,1nr
}

list_mixed_sessions() {
  local records="$1" epoch source f sid name mtime turns
  load_sid_name_map
  load_sid_name_disk_map
  printf '%-19s  %-8s  %-36s  %-5s  %s\n' 'modified' 'harness' 'sessionId' 'turns' 'name'
  while IFS=$'\t' read -r epoch source f; do
    name=""
    case "$source" in
      codex) sid="$(codex_sid_for "$f")" ;;
      pi) sid="$(pi_sid_for "$f")" ;;
      claude)
        sid="${f##*/}"; sid="${sid%.jsonl}"
        name="$(session_name_for "$sid")"
        ;;
    esac
    mtime=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$f")
    turns=$(wc -l < "$f" | tr -d ' ')
    printf '%-19s  %-8s  %-36s  %-5s  %s\n' "$mtime" "$source" "$sid" "$turns" "$name"
  done <<< "$records"
}

list_sessions() {
  local target="${1:-$PWD}"

  if [[ "$SOURCE" == codex ]]; then
    local cwd
    cwd="$(cd "$target" 2>/dev/null && pwd)" || {
      echo "agent-read: not a directory: $target" >&2
      exit 1
    }
    local any=0 f sid mtime turns
    while IFS= read -r f; do
      if [[ $any -eq 0 ]]; then
        printf '%-19s  %-8s  %-36s  %-5s  %s\n' 'modified' 'harness' 'sessionId' 'lines' 'name'
      fi
      any=1
      sid="$(codex_sid_for "$f")"
      mtime=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$f")
      turns=$(wc -l < "$f" | tr -d ' ')
      # No name column: Codex records no /rename equivalent.
      printf '%-19s  %-8s  %-36s  %-5s  %s\n' "$mtime" 'codex' "$sid" "$turns" ""
    done < <(codex_filtered_files "$cwd")
    if [[ $any -eq 0 ]]; then
      echo "agent-read: no matching Codex sessions for $cwd" >&2
    fi
    return 0
  fi

  if [[ "$SOURCE" == pi ]]; then
    local pdir
    pdir="$(pi_project_dir_for "$target")"
    if [[ ! -d "$pdir" ]]; then
      echo "agent-read: no pi sessions for $target" >&2
      echo "  expected: $pdir" >&2
      exit 1
    fi
    local any=0 f sid mtime turns
    while IFS= read -r f; do
      if [[ $any -eq 0 ]]; then
        printf '%-19s  %-8s  %-36s  %-5s  %s\n' 'modified' 'harness' 'sessionId' 'turns' 'name'
      fi
      any=1
      sid="$(pi_sid_for "$f")"
      mtime=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$f")
      turns=$(wc -l < "$f" | tr -d ' ')
      # No name column: pi records no /rename equivalent.
      printf '%-19s  %-8s  %-36s  %-5s  %s\n' "$mtime" 'pi' "$sid" "$turns" ""
    done < <(pi_filtered_files "$pdir")
    if [[ $any -eq 0 ]]; then
      echo "agent-read: no matching pi sessions in $pdir" >&2
    fi
    return 0
  fi

  local dir
  dir="$(project_dir_for "$target")"
  # Bad path / never-used worktree is an error (the user pointed somewhere
  # Claude has never run). But "directory exists, just no sessions match the
  # window" is a normal answer — exit 0.
  if [[ ! -d "$dir" ]]; then
    echo "agent-read: no Claude sessions for $target" >&2
    echo "  expected: $dir" >&2
    exit 1
  fi
  # Pre-load the name maps in the parent shell. Each `name=$(session_name_for …)`
  # runs in a subshell that can read but not write parent variables; without
  # this, every row would rebuild the disk map from scratch (multi-second
  # super query per row).
  load_sid_name_map
  load_sid_name_disk_map
  local any=0
  while IFS= read -r f; do
    if [[ $any -eq 0 ]]; then
      printf '%-19s  %-8s  %-36s  %-5s  %s\n' 'modified' 'harness' 'sessionId' 'turns' 'name'
    fi
    any=1
    local sid mtime turns name
    sid="${f##*/}"
    sid="${sid%.jsonl}"
    mtime=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$f")
    turns=$(wc -l < "$f" | tr -d ' ')
    name=$(session_name_for "$sid")
    printf '%-19s  %-8s  %-36s  %-5s  %s\n' "$mtime" 'claude' "$sid" "$turns" "$name"
  done < <(filtered_sessions_in "$dir")
  if [[ $any -eq 0 ]]; then
    echo "agent-read: no matching sessions in $dir" >&2
  fi
}

find_by_session_id() {
  local sid="$1"
  local matches=("$projects_dir"/*/"$sid".jsonl)
  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "agent-read: no session file for ID $sid" >&2
    exit 1
  fi
  echo "${matches[0]}"
}

# ── Codex discovery ──────────────────────────────────────────────────────────────

# The rollout's UUID is the tail of its filename (rollout-<ts>-<uuid>.jsonl) and
# equals payload.id — so a session can be addressed by UUID without opening the
# file, exactly like Claude's <uuid>.jsonl.
codex_sid_for() {
  local b="${1##*/}"
  b="${b%.jsonl}"
  echo "${b: -36}"
}

# Every Codex rollout for a worktree, newest mtime first (mirroring the claude
# path's `ls -t`). Codex has no per-worktree directory, so the worktree is matched
# against payload.cwd in each file's session_meta header.
#
# Cost is kept to O(files): only line 1 (the header) of each candidate is read,
# not the whole transcript. One super pass over those headers emits id<TAB>cwd;
# the cwd match is done in the shell so a worktree path with an odd character
# never has to be interpolated into a super program. Subagent rollouts are
# dropped by string-matching the stringified payload for "subagent" — older Codex
# builds omit payload.source entirely, and has(payload.source) would error at
# schema resolution when the field appears in no header at all (the same trap
# the isMeta / subtype filters avoid via fields(this)).
codex_files_for_cwd() {
  local cwd="$1"
  # A worktree under a symlinked parent (/tmp, /var on macOS) has a logical path
  # and a physical one; if Codex recorded the physical form and the shell reports
  # the logical (or vice-versa), an exact match silently finds nothing — the
  # issue-#17 class of false negative. Match either form, the way the console
  # path resolves with physical_path() before comparing.
  local cwd_phys
  cwd_phys="$(cd "$cwd" 2>/dev/null && pwd -P)" || cwd_phys="$cwd"
  local files=("$codex_sessions_dir"/*/*/*/*.jsonl)
  [[ -e "${files[0]:-}" ]] || return 0

  local ordered=()
  local f
  while IFS= read -r f; do ordered+=("$f"); done < <(ls -t "${files[@]}")
  [[ ${#ordered[@]} -gt 0 ]] || return 0

  local headers rows
  headers="$(for f in "${ordered[@]}"; do head -n 1 "$f"; done)"
  # The trailing '-' is required: super reads stdin only when a '-' path is given
  # explicitly; without it, piped input is silently seen as empty.
  # cast(payload, <string>) renders ZSON with unquoted keys, so a subagent header
  # stringifies as `…source:{subagent:{…}}`. Match the bare `subagent` key. (The
  # only false positive would be a worktree path literally containing "subagent",
  # which would merely hide that one session — acceptable, and vanishingly rare.)
  rows="$(
    printf '%s\n' "$headers" | super -i json -f line -c "
      where type == 'session_meta'
        and not grep('subagent', cast(payload, <string>))
      | values f'{payload.id}\t{payload.cwd}'
    " - 2>/dev/null
  )" || return 0
  [[ -n "$rows" ]] || return 0

  # ids matching this cwd, as a newline-delimited set the membership check walks.
  local matching_ids="" line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if [[ "$line" == *$'\t'"$cwd" || "$line" == *$'\t'"$cwd_phys" ]]; then
      matching_ids+="${line%%$'\t'*}"$'\n'
    fi
  done <<< "$rows"
  [[ -n "$matching_ids" ]] || return 0

  # Re-emit files in mtime order, keeping only those whose UUID matched.
  local sid id
  for f in "${ordered[@]}"; do
    sid="$(codex_sid_for "$f")"
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      [[ "$sid" == "$id" ]] && { echo "$f"; break; }
    done <<< "$matching_ids"
  done
}

# codex_files_for_cwd narrowed by the active --exclude / --since filters, so the
# Codex path honours the same selection flags as filtered_sessions_in does for
# Claude.
codex_filtered_files() {
  local cwd="$1"
  local f sid f_mtime
  while IFS= read -r f; do
    sid="$(codex_sid_for "$f")"
    is_excluded "$sid" && continue
    if [[ -n "${SINCE_EPOCH:-}" ]]; then
      f_mtime=$(stat -f '%m' "$f")
      [[ $f_mtime -ge $SINCE_EPOCH ]] || continue
    fi
    echo "$f"
  done < <(codex_files_for_cwd "$cwd")
}

# The rollout file for a Codex UUID, searched across every date partition —
# cross-worktree by design, like find_by_session_id.
find_codex_by_session_id() {
  local sid="$1"
  local matches=("$codex_sessions_dir"/*/*/*/*"$sid".jsonl)
  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "agent-read: no Codex session file for ID $sid" >&2
    exit 1
  fi
  echo "${matches[0]}"
}

# ── pi discovery ─────────────────────────────────────────────────────────────────

# pi's filename is <timestamp>_<uuid>.jsonl — the uuid is everything after the
# last '_', mirroring codex_sid_for's tail-of-filename approach (Claude's
# <uuid>.jsonl bare-basename shortcut doesn't apply here).
pi_sid_for() {
  local b="${1##*/}"
  b="${b%.jsonl}"
  echo "${b##*_}"
}

# pi's directory is worktree-scoped like Claude's (no header-scanning cwd match
# needed, unlike Codex) — so this mirrors filtered_sessions_in, just with
# pi_sid_for's tail-of-filename extraction instead of the bare basename.
pi_filtered_files() {
  local dir="$1"
  local files=("$dir"/*.jsonl)
  [[ ${#files[@]} -eq 0 ]] && return 1
  local f sid f_mtime
  while IFS= read -r f; do
    sid="$(pi_sid_for "$f")"
    is_excluded "$sid" && continue
    if [[ -n "${SINCE_EPOCH:-}" ]]; then
      f_mtime=$(stat -f '%m' "$f")
      [[ $f_mtime -ge $SINCE_EPOCH ]] || continue
    fi
    echo "$f"
  done < <(ls -t "${files[@]}")
}

# The pi session file for a UUID, searched across every worktree directory —
# cross-worktree by design, like find_by_session_id / find_codex_by_session_id.
find_pi_by_session_id() {
  local sid="$1"
  local matches=("$pi_sessions_dir"/*/*"_$sid".jsonl)
  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "agent-read: no pi session file for ID $sid" >&2
    exit 1
  fi
  echo "${matches[0]}"
}

# ── Auto source resolution ───────────────────────────────────────────────────────

# The newest session mtime a source has for a worktree, as a Unix epoch — the
# freshness signal auto uses to choose. Nothing echoed (and non-zero) when the
# source has no sessions here, so the caller can tell "absent" from "epoch 0".
claude_freshest_mtime() {
  local target="$1" dir
  dir="$(project_dir_for "$target" 2>/dev/null)" || return 1
  [[ -d "$dir" ]] || return 1
  local files=("$dir"/*.jsonl)
  [[ -e "${files[0]:-}" ]] || return 1
  stat -f '%m' "${files[@]}" | sort -rn | head -1
}

codex_freshest_mtime() {
  local cwd="$1" out first
  # codex_files_for_cwd already returns mtime-descending, so the first line is
  # the freshest. Capture then slice — never pipe its slow producer into `head`.
  out="$(codex_files_for_cwd "$cwd")"
  first="${out%%$'\n'*}"
  [[ -n "$first" ]] || return 1
  stat -f '%m' "$first"
}

pi_freshest_mtime() {
  local target="$1" dir
  dir="$(pi_project_dir_for "$target" 2>/dev/null)" || return 1
  [[ -d "$dir" ]] || return 1
  local files=("$dir"/*.jsonl)
  [[ -e "${files[0]:-}" ]] || return 1
  stat -f '%m' "${files[@]}" | sort -rn | head -1
}

# Resolve SOURCE=auto to a concrete source for this worktree, in place. The
# source with the most recent session wins; when more than one source has
# sessions here, a hint on stderr names the other(s) being hidden so a mixed
# worktree doesn't silently drop peers on a source that isn't shown. No source
# present → claude, whose downstream error path names where it looked (the
# pre-auto default). A no-op unless SOURCE is 'auto'.
resolve_auto_source() {
  [[ "$SOURCE" == auto ]] || return 0
  local target="$1" cwd cm xm pm
  cwd="$(cd "$target" 2>/dev/null && pwd)" || { SOURCE=claude; return 0; }
  cm="$(claude_freshest_mtime "$target" || true)"
  xm="$(codex_freshest_mtime "$cwd" || true)"
  pm="$(pi_freshest_mtime "$target" || true)"

  # Pick the source with the largest mtime among those present; ties favor
  # claude, then codex, then pi (arbitrary but stable order).
  local winner=claude best=""
  [[ -n "$cm" ]] && { winner=claude; best="$cm"; }
  if [[ -n "$xm" ]] && { [[ -z "$best" ]] || [[ "$xm" -gt "$best" ]]; }; then
    winner=codex; best="$xm"
  fi
  if [[ -n "$pm" ]] && { [[ -z "$best" ]] || [[ "$pm" -gt "$best" ]]; }; then
    winner=pi; best="$pm"
  fi
  SOURCE="$winner"

  # Name every OTHER source that also has sessions here, so a three-way mixed
  # worktree doesn't silently hide two of its three peers behind one flag.
  local others=() flag
  [[ "$winner" != claude && -n "$cm" ]] && others+=("--claude")
  [[ "$winner" != codex && -n "$xm" ]] && others+=("--codex")
  [[ "$winner" != pi && -n "$pm" ]] && others+=("--pi")
  if [[ ${#others[@]} -gt 0 ]]; then
    local joined=""
    for flag in "${others[@]}"; do
      [[ -z "$joined" ]] && joined="$flag" || joined="$joined, $flag"
    done
    echo "agent-read: showing ${winner} (more recent here) — sessions also exist for $joined; pass one of those to see them" >&2
  fi
}

# Translate a --since value (ISO 8601 or relative duration) to a super expression.
since_expr() {
  local v="$1"
  if [[ "$v" =~ ^[0-9]+[smhd]$ ]]; then
    echo "now() - '${v}'::duration"
  else
    # Treat as ISO 8601. Super will error on bad input.
    echo "cast('${v}', <time>)"
  fi
}

# Translate a --since value to a Unix epoch threshold (for mtime filtering).
# Delegates parsing to super, which handles durations and ISO 8601 natively.
# Super returns errors as values (not exit codes), so we detect and surface them.
since_to_epoch() {
  local v="$1"
  local expr
  if [[ "$v" =~ ^[0-9]+(\.[0-9]+)?[smhdwy]$ ]]; then
    expr="cast(now() - '$v'::duration, <int64>) / 1000000000"
  else
    expr="cast(cast('$v', <time>), <int64>) / 1000000000"
  fi
  local result
  result=$(super -f line -c "$expr")
  if [[ "$result" == error\(* ]]; then
    echo "agent-read: invalid --since value: $v" >&2
    echo "  super: $result" >&2
    exit 2
  fi
  echo "$result"
}

# Core filter+normalize pipeline shared by historical and follow rendering.
# Emits {ts, role, text} records, oldest-first when sourced from a finite file.
#
# message.content is either a plain string (simple user prompts) or an array of
# content blocks (tool use, mixed text/images). We coerce strings into a
# one-element array of {type:'text', text:...} so a single unnest path handles
# both shapes. An earlier `switch` design hit a SuperDB quirk where the
# unnest-branch was evaluated against string rows even when the type guard
# routed them to the other case.
# The SINCE/CURSOR guard shared by every filter variant. Both --since and cursors
# key on the top-level `timestamp`, which Claude and Codex lines both carry, so
# this clause is identical across sources.
#
# A cursor is exclusive where --since is inclusive: the turn at the cursor is the
# last one already rendered, so re-emitting it would double-charge the reader for
# output it has seen.
since_and_cursor_clause() {
  local c=""
  if [[ -n "${SINCE:-}" ]]; then
    c=" and cast(timestamp, <time>) >= $(since_expr "$SINCE")"
  fi
  if [[ -n "${CURSOR_TS:-}" ]]; then
    c+=" and cast(timestamp, <time>) > cast('$CURSOR_TS', <time>)"
  fi
  echo "$c"
}

filter_pipeline_claude() {
  local since_clause
  since_clause="$(since_and_cursor_clause)"
  cat <<EOF
where type in ['user','assistant'] and not (['isMeta'] in fields(this))${since_clause}
| put _arr := case
    when typeof(message.content) == <string>
      then [{type: 'text', text: cast(message.content, <string>)}]
      else message.content
    end
| put text := (unnest _arr | where this.type == 'text' | values this.text | collect(this))
| where len(text) > 0
| values {ts: timestamp, role: type, text: join(text, '\n')}
EOF
}

# Codex turns are response_item/message lines; the role and content live under
# payload. Content blocks are always an array (no string coercion needed), typed
# input_text (user), output_text (assistant), or text. Emits the same
# {ts, role, text} shape as the Claude variant so all downstream machinery —
# ordering, cursors, follow, format_clause — is reused unchanged.
filter_pipeline_codex() {
  local since_clause
  since_clause="$(since_and_cursor_clause)"
  cat <<EOF
where type == 'response_item' and payload.type == 'message'
  and payload.role in ['user','assistant']${since_clause}
| put text := (unnest payload.content
    | where this.type in ['input_text','output_text','text']
    | values this.text | collect(this))
| where len(text) > 0
| values {ts: timestamp, role: payload.role, text: join(text, '\n')}
EOF
}

# pi turns are type=message lines; role/content live under message. content is
# ALWAYS an array (never a bare string like Claude's simple-prompt case), mixing
# text/thinking/toolCall blocks — keep only type=='text'. No isMeta field exists
# to filter; non-message header lines (session, model_change,
# thinking_level_change) are excluded by the type=='message' guard itself.
filter_pipeline_pi() {
  local since_clause
  since_clause="$(since_and_cursor_clause)"
  cat <<EOF
where type == 'message' and message.role in ['user','assistant']${since_clause}
| put text := (unnest message.content
    | where this.type == 'text'
    | values this.text | collect(this))
| where len(text) > 0
| values {ts: timestamp, role: message.role, text: join(text, '\n')}
EOF
}

filter_pipeline() {
  case "$SOURCE" in
    codex) filter_pipeline_codex ;;
    pi)    filter_pipeline_pi ;;
    *)     filter_pipeline_claude ;;
  esac
}

# Format a {ts, role, text} record stream as readable blocks.
format_clause() {
  echo "| values f'{strftime(\"%Y-%m-%d %H:%M\", cast(ts, <time>))}  [{role}]\n{text}\n'"
}

render_historical() {
  local file="$1"
  local order_clause
  if [[ -n "${TURNS:-}" ]]; then
    # Sort desc, take N, then sort asc for chronological output.
    order_clause="| sort -r ts | head $TURNS | sort ts"
  else
    order_clause="| sort ts"
  fi
  super -f line -c "$(filter_pipeline) $order_clause $(format_clause)" "$file"
}

# The timestamp of the newest readable turn in a session — what a cursor stores.
# Computed from the unfiltered stream, so it advances past the last turn the
# reader actually saw even when a window (--turns) clipped the render.
last_turn_ts() {
  local file="$1"
  local where_clause="type in ['user','assistant'] and not (['isMeta'] in fields(this))"
  if [[ "$SOURCE" == codex ]]; then
    where_clause="type == 'response_item' and payload.type == 'message' and payload.role in ['user','assistant']"
  elif [[ "$SOURCE" == pi ]]; then
    where_clause="type == 'message' and message.role in ['user','assistant']"
  fi
  CURSOR_TS="" SINCE="" super -f line -c "
    where $where_clause
    | sort -r timestamp
    | head 1
    | values cast(timestamp, <string>)
  " "$file" 2>/dev/null || true
}

# Only the turns added to this session since this reader last looked. Same three
# edges as the console path: no cursor → fall back to the window rather than
# replaying the whole conversation; nothing new → say so rather than printing
# nothing at all.
render_session_new() {
  local file="$1"
  local sid
  if [[ "$SOURCE" == codex ]]; then
    sid="$(codex_sid_for "$file")"
  elif [[ "$SOURCE" == pi ]]; then
    sid="$(pi_sid_for "$file")"
  else
    sid="${file##*/}"
    sid="${sid%.jsonl}"
  fi

  # CURSOR_TS is a global that filter_pipeline reads. The --all/--peers --new loop
  # calls this once per session in the same shell, so a value left over from a
  # prior (cursored) session would leak into a later session's render and wrongly
  # filter it. Reset it every call; the else branch sets it for this session.
  local cursor first_read=0
  cursor="$(cursor_get "$sid")"
  CURSOR_TS=""
  if [[ -z "$cursor" ]]; then
    first_read=1
    TURNS="${TURNS:-$DEFAULT_NEW_TURNS}"
  else
    CURSOR_TS="$cursor"
    TURNS=""
  fi

  local out
  out="$(render_historical "$file")"

  local newest
  newest="$(last_turn_ts "$file")"
  [[ -n "$newest" ]] && cursor_set "$sid" "$newest"

  if [[ -z "$out" ]]; then
    echo "[$sid] no new turns since last read"
    return 0
  fi
  if [[ "$first_read" -eq 1 ]]; then
    echo "[$sid] first read — last $TURNS turns"
  fi
  printf '%s\n' "$out"
}

render_follow() {
  local file="$1"
  # Stream appends through the same filter pipeline (no sort — append order is
  # already chronological). -n 0 means start from end (don't re-emit history).
  tail -f -n 0 "$file" | super -i json -f line -c "$(filter_pipeline) $(format_clause)"
}

# Variant of filter_pipeline that keeps sessionId in the output. Used by the
# multi-session firehose so each turn can be tagged with its source.
filter_pipeline_with_sid() {
  local since_clause=""
  if [[ -n "${SINCE:-}" ]]; then
    since_clause=" and cast(timestamp, <time>) >= $(since_expr "$SINCE")"
  fi
  cat <<EOF
where type in ['user','assistant'] and not (['isMeta'] in fields(this))${since_clause}
| put _arr := case
    when typeof(message.content) == <string>
      then [{type: 'text', text: cast(message.content, <string>)}]
      else message.content
    end
| put text := (unnest _arr | where this.type == 'text' | values this.text | collect(this))
| where len(text) > 0
| values {ts: timestamp, role: type, sid: sessionId, text: join(text, '\n')}
EOF
}

format_clause_with_sid() {
  # Short sid (first 8 chars) keeps the prefix readable. Full sid is in the
  # listing if you need to disambiguate.
  echo "| values f'{strftime(\"%Y-%m-%d %H:%M\", cast(ts, <time>))}  [{role} {sid[0:8]}]\n{text}\n'"
}

# Stream-everything follow: tail -qf all matched files together, interleaved.
# Output is annotated with a short sessionId prefix so turns from different
# sessions can be told apart. `-q` suppresses the per-file ==> headers that
# tail would otherwise emit when output switches files.
render_follow_all() {
  local files=("$@")
  [[ ${#files[@]} -gt 0 ]] || return 0
  tail -qf -n 0 "${files[@]}" | super -i json -f line -c "$(filter_pipeline_with_sid) $(format_clause_with_sid)"
}

# ── The human's console ────────────────────────────────────────────────────────

# A recording that ended and one being written to right now are the same bytes on
# disk. macOS `script -q` leaves no marker either way — no "Script started on",
# no "Script done on" (that's exactly what -q suppresses; util-linux differs). So
# liveness is a question about processes, not content: is a script(1) still
# holding the file open?
#
# One lsof call covers every pane (~300ms); doing it per file would trip over the
# same cost repeatedly. Filtering on the `script` command matters — a human
# tailing their own log holds it open too, and that isn't a recording.
#
# Populates LIVE_CONSOLES, a newline-delimited set of paths. Anything lsof can't
# tell us about is treated as ended: claiming "live" wrongly would invite a reader
# to trust a stale log, and that's the failure this whole distinction exists to
# prevent.
LIVE_CONSOLES=""
load_live_consoles() {
  [[ $# -gt 0 ]] || return 0
  LIVE_CONSOLES=$(
    lsof -Fcn -- "$@" 2>/dev/null | awk '
      /^c/ { cmd = substr($0, 2) }
      /^n/ { if (cmd == "script") print substr($0, 2) }
    ' | sort -u
  ) || true
}

# lsof answers with physical paths (/private/var/…), while ours are logical
# (/var/…) whenever any parent is a symlink — true of /tmp and /var on macOS.
# Comparing the two as strings silently reports a live pane as ended, so resolve
# ours the same way before matching.
physical_path() {
  local dir
  dir="$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)" || {
    echo "$1"
    return 0
  }
  echo "$dir/${1##*/}"
}

console_is_live() {
  [[ -n "$LIVE_CONSOLES" ]] || return 1
  local target line
  target="$(physical_path "$1")"
  while IFS= read -r line; do
    [[ "$line" == "$target" ]] && return 0
  done <<< "$LIVE_CONSOLES"
  return 1
}

console_status() {
  if console_is_live "$1"; then echo "live"; else echo "ended"; fi
}

# "2m ago", "3h ago", "6d ago" — coarse on purpose. The question a reader has is
# "is this from the work I'm doing now, or from Tuesday?", not the exact second.
console_age() {
  local mtime now delta
  mtime=$(stat -f '%m' "$1")
  now=$(date +%s)
  delta=$((now - mtime))
  ((delta < 0)) && delta=0
  if ((delta < 60)); then
    echo "just now"
  elif ((delta < 3600)); then
    echo "$((delta / 60))m ago"
  elif ((delta < 86400)); then
    echo "$((delta / 3600))h ago"
  else
    echo "$((delta / 86400))d ago"
  fi
}

# .tests-console.log → tests. Off-convention names degrade gracefully rather than
# being dropped: .my-console.log → my, .console.log → console.
console_tag_for() {
  local b="${1##*/}"
  b="${b#.}"
  b="${b%.log}"
  b="${b%-console}"
  b="${b#console-}"
  [[ -n "$b" ]] || b="console"
  echo "$b"
}

# Every console recording in a worktree, oldest-written first — so when they're
# rendered in order, the pane the human touched most recently lands last, nearest
# the reader's attention. $CLAUDE_CONSOLE_LOG, if set, is the only console there
# is (absolute, or relative to the worktree). Empty output means "none" — not an
# error here; callers decide what that means.
console_files() {
  local dir="$1"
  if [[ -n "${CLAUDE_CONSOLE_LOG:-}" ]]; then
    local p="$CLAUDE_CONSOLE_LOG"
    [[ "$p" == /* ]] || p="$dir/$p"
    [[ -f "$p" ]] && echo "$p"
    return 0
  fi
  # Unquoted on purpose: CONSOLE_GLOB is a pattern and must expand here.
  # shellcheck disable=SC2206
  local candidates=("$dir"/$CONSOLE_GLOB)
  [[ ${#candidates[@]} -eq 0 ]] && return 0
  ls -tr "${candidates[@]}" 2>/dev/null
}

# The subset of console_files matching $TAG (all of them when TAG is empty).
# Exits 1 — naming the tags that do exist — when a tag matches nothing, because
# a silent empty read looks exactly like "that pane had nothing to say".
selected_console_files() {
  local dir="$1"
  local f files=() tags=""
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    if [[ -z "$TAG" || "$(console_tag_for "$f")" == "$TAG" ]]; then
      files+=("$f")
    fi
    tags+=" $(console_tag_for "$f")"
  done < <(console_files "$dir")

  if [[ ${#files[@]} -eq 0 && -n "$TAG" ]]; then
    echo "agent-read: no console recording tagged '$TAG' in $dir" >&2
    if [[ -n "$tags" ]]; then
      echo "  recording:$tags" >&2
    fi
    exit 1
  fi
  [[ ${#files[@]} -eq 0 ]] && return 0
  printf '%s\n' "${files[@]}"
}

# Reduce a raw script(1) typescript to what a human's eye actually resolved on
# screen: no escape sequences, no intermediate frames of a progress redraw, no
# banner, no long runs of blank lines. Line-buffered ($|) so --follow streams.
clean_console() {
  perl -ne '
    BEGIN { $| = 1; $blank = 0 }
    next if /^Script (started|done) on /;
    s/\e\][^\a\e]*(?:\a|\e\\)//g;          # OSC — window/tab title sets
    s/\e\[[0-9;?]*[ -\/]*[\@-~]//g;        # CSI — color, cursor motion
    s/\e[()][AB0-2]//g;                    # charset selects
    s/\e[=>78Mc]//g;                       # misc two-byte escapes
    s/\r+(?=\n)//g;                        # CRLF → LF
    s/^.*\r//;                             # redraw: last write to the line wins
    s/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]//g; # leftover control bytes
    if (/^\s*$/) { next if $blank++ } else { $blank = 0 }
    print;
  '
}

# One pane, under a heading that names it and dates it. The heading is
# unconditional — even with a single pane — so a reader is never left inferring
# which terminal it's looking at, nor whether that terminal is still alive. An
# "ended, 6d ago" pane is history; read it as history.
render_console_file() {
  local file="$1"
  local n="${TAIL:-$DEFAULT_TAIL}"
  printf '── %s  (%s, %s, last write %s)\n' \
    "$(console_tag_for "$file")" \
    "${file##*/}" \
    "$(console_status "$file")" \
    "$(console_age "$file")"
  tail -n "$n" "$file" | clean_console
}

# Only what's been appended to this pane since this reader last looked.
#
# Three edges decide whether this is trustworthy:
#  - No cursor yet → fall back to the window. A first read must not dump a whole
#    day of terminal history into a context window.
#  - Cursor past EOF → the pane was re-recorded. `script` truncates on start, so
#    this is routine, not corruption. Reset and say so; otherwise a restarted pane
#    would read as "nothing new" forever.
#  - Nothing appended → say so out loud. "No new output" and "I didn't look" must
#    not produce identical silence.
render_console_new() {
  local file="$1"
  local n="${TAIL:-$DEFAULT_TAIL}"
  local key size offset
  key="$(physical_path "$file")"
  size=$(stat -f '%z' "$file")
  offset="$(cursor_get "$key")"

  printf '── %s  (%s, %s, last write %s)\n' \
    "$(console_tag_for "$file")" \
    "${file##*/}" \
    "$(console_status "$file")" \
    "$(console_age "$file")"

  if [[ -z "$offset" ]]; then
    echo "   [first read — showing the last $n lines]"
    tail -n "$n" "$file" | clean_console
    cursor_set "$key" "$size"
    return 0
  fi

  if ((offset > size)); then
    echo "   [pane was re-recorded since the last read — reading from the start]"
    offset=0
  fi

  if ((offset == size)); then
    echo "   [no new output since last read]"
    return 0
  fi

  # Cap the delta at the same window: a pane that exploded while nobody was
  # looking must not be able to blow the context window open.
  tail -c "+$((offset + 1))" "$file" | clean_console | tail -n "$n"
  cursor_set "$key" "$size"
}

render_consoles() {
  local files=("$@")
  load_live_consoles "${files[@]}"
  local i
  for i in "${!files[@]}"; do
    [[ $i -eq 0 ]] || echo
    if [[ "$NEW" -eq 1 ]]; then
      render_console_new "${files[$i]}"
    else
      render_console_file "${files[$i]}"
    fi
  done
}

# --follow is single-pane only. Interleaving several typescripts would produce a
# stream nobody could attribute: script(1) writes no timestamps (macOS `script -t`
# is a flush interval, not util-linux's timing log), and raw appends carry no
# marker of which pane they came from.
render_console_follow() {
  local file="$1"
  local n="${TAIL:-$DEFAULT_TAIL}"
  printf '── %s  (%s)\n' "$(console_tag_for "$file")" "${file##*/}"
  tail -n "$n" -f "$file" | clean_console
}

list_consoles() {
  local dir="$1"
  local f files=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && files+=("$f")
  done < <(console_files "$dir")

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "agent-read: no console recording in $dir" >&2
    echo "  the human starts one in their terminal with: agent-read --record" >&2
    return 0
  fi

  load_live_consoles "${files[@]}"
  printf '%-12s  %-6s  %-11s  %-7s  %s\n' 'tag' 'status' 'last write' 'lines' 'file'
  for f in "${files[@]}"; do
    printf '%-12s  %-6s  %-11s  %-7s  %s\n' \
      "$(console_tag_for "$f")" \
      "$(console_status "$f")" \
      "$(console_age "$f")" \
      "$(wc -l < "$f" | tr -d ' ')" \
      "${f##*/}"
  done
}

# Claude can't start the recording — script(1) has to wrap the human's own
# interactive shell, and a tool-call subshell isn't one (it has no tty; script
# dies with "tcgetattr/ioctl: Operation not supported on socket"). So hand the
# human the command and let them run it.
print_record_command() {
  local target="${1:-$PWD}"
  local dir
  dir="$(cd "$target" 2>/dev/null && pwd)" || {
    echo "agent-read: not a directory: $target" >&2
    exit 1
  }

  local tag="${TAG:-$DEFAULT_CONSOLE_TAG}"
  local logname=".$tag-console.log"

  # Only warn about *this* pane's log. A running server pane is not a reason to
  # hesitate before recording the test pane.
  if [[ -f "$dir/$logname" ]]; then
    echo "Note: $logname already exists — script truncates on start, so this"
    echo "overwrites it. Use 'script -F -q -a' to append to the old one instead."
    echo
  fi

  local logpath="$logname"
  [[ "$dir" == "$PWD" ]] || logpath="$dir/$logname"

  echo "Run this in the terminal you want recorded — script(1) has to wrap an"
  echo "interactive shell, so Claude can't start it for you:"
  echo
  echo "    script -F -q $logpath"
  echo
  echo "Work as usual; exit (or Ctrl-D) ends the recording."
  echo "One pane per concern: --record --tag tests, --tag server, …"
  echo "Claude reads it back with: agent-read --console [--tag $tag]"

  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 &&
    ! git -C "$dir" check-ignore -q "$dir/$logname" 2>/dev/null; then
    echo
    echo "Heads-up: $logname isn't gitignored here. One line in your global"
    echo "excludes covers every repo, forever — it's the same glob agent-read"
    echo "discovers by, so anything it can read is already ignored:"
    echo
    echo "    echo '$CONSOLE_GLOB' >> \$(git config --global core.excludesfile)"
  fi
}

MODE=worktree
POSITIONAL=""
SESSION_ID=""
EXCLUDES=()
TURNS=""
TAIL=""
TAG=""
SINCE=""
FOLLOW=0
NEW=0
CURSOR_TS=""

# Bare invocation prints usage. Rendering the most-recent session "by default"
# was too magical — easy to surprise yourself in the wrong worktree.
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --codex)
      SOURCE=codex
      shift
      ;;
    --pi)
      SOURCE=pi
      shift
      ;;
    --claude)
      SOURCE=claude
      shift
      ;;
    --all)
      MODE=list
      shift
      ;;
    --peers)
      MODE=list
      [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || {
        echo "agent-read: --peers requires \$CLAUDE_CODE_SESSION_ID (only set inside Claude Code); use --all from a regular shell" >&2
        exit 2
      }
      EXCLUDES+=("$CLAUDE_CODE_SESSION_ID")
      shift
      ;;
    --session)
      MODE=session
      SESSION_ID="${2:?--session requires a sessionId}"
      shift 2
      ;;
    --exclude)
      EXCLUDES+=("${2:?--exclude requires a sessionId}")
      shift 2
      ;;
    --console)
      MODE=console
      shift
      ;;
    --console-list)
      MODE=console-list
      shift
      ;;
    --record)
      MODE=record
      shift
      ;;
    --tag)
      TAG="${2:?--tag requires a console tag}"
      shift 2
      ;;
    --new)
      NEW=1
      shift
      ;;
    --turns)
      TURNS="${2:?--turns requires a number}"
      [[ "$TURNS" =~ ^[0-9]+$ ]] || { echo "agent-read: --turns must be a non-negative integer" >&2; exit 2; }
      shift 2
      ;;
    --tail)
      TAIL="${2:?--tail requires a number}"
      [[ "$TAIL" =~ ^[0-9]+$ ]] || { echo "agent-read: --tail must be a non-negative integer" >&2; exit 2; }
      shift 2
      ;;
    --since)
      SINCE="${2:?--since requires a timestamp or duration}"
      shift 2
      ;;
    -f|--follow)
      FOLLOW=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "agent-read: unknown flag: $1" >&2
      exit 2
      ;;
    *)
      [[ -z "$POSITIONAL" ]] || {
        echo "agent-read: too many positional args" >&2
        exit 2
      }
      POSITIONAL="$1"
      shift
      ;;
  esac
done

# --turns counts conversation turns, so it means nothing across a listing or over
# a console recording (which has lines, not turns — that's --tail).
# --follow IS valid with --all/--peers: it streams new turns from every matched
# session interleaved ("firehose" mode).
if [[ -n "$TURNS" && "$MODE" != "worktree" && "$MODE" != "session" ]]; then
  echo "agent-read: --turns is a session render flag; not valid with --all/--peers/--console" >&2
  exit 2
fi

if [[ -n "$TAIL" && "$MODE" != "console" ]]; then
  echo "agent-read: --tail only applies to --console (sessions use --turns)" >&2
  exit 2
fi

if [[ -n "$TAG" && "$MODE" != "console" && "$MODE" != "record" ]]; then
  echo "agent-read: --tag names a console pane; only valid with --console/--record" >&2
  exit 2
fi

# --codex/--pi select a session *source*. The console/record modes read the
# human's terminal typescript, which is provider-agnostic — there's no
# Codex/pi variant of it, so pairing them is a category error, not a mode.
if [[ "$SOURCE" == codex || "$SOURCE" == pi ]]; then
  case "$MODE" in
    console | console-list | record)
      echo "agent-read: --$SOURCE selects a session source; it doesn't apply to console/record" >&2
      exit 2
      ;;
  esac
fi

# Pre-validate --since once; fail fast before any rendering or listing runs.
if [[ -n "$SINCE" ]]; then
  SINCE_EPOCH=$(since_to_epoch "$SINCE")
fi

# Resolve names → UUIDs for --session and --exclude (positional was already
# parsed, so project_dir_for can use it as the worktree fallback for names).
if [[ -n "$SESSION_ID" ]]; then
  SESSION_ID=$(resolve_session_id "$SESSION_ID")
fi
# Codex and pi record no /rename names, so their excludes are matched literally
# by UUID — no resolution step. This also lets --peers work: the excluded
# observer id is a Claude session id, which simply never matches a Codex/pi
# UUID (so --peers ≡ --all for both), instead of erroring in resolve_session_id
# as a non-UUID name.
if [[ ${#EXCLUDES[@]} -gt 0 && "$SOURCE" != codex && "$SOURCE" != pi ]]; then
  resolved=()
  for ex in "${EXCLUDES[@]}"; do
    resolved+=("$(resolve_session_id "$ex")")
  done
  EXCLUDES=("${resolved[@]}")
fi

# Sets $RENDER_FILE to the .jsonl to render, or empty if the worktree has
# no matching sessions (a non-error empty answer — e.g. "no peer activity in
# the last 10m"). Hard errors (bad path, unknown session id) exit non-zero
# from helpers, so we don't need to signal them here.
RENDER_FILE=""
resolve_render_file() {
  case "$MODE" in
    session)
      if [[ "$SOURCE" == codex ]]; then
        RENDER_FILE=$(find_codex_by_session_id "$SESSION_ID")
      elif [[ "$SOURCE" == pi ]]; then
        RENDER_FILE=$(find_pi_by_session_id "$SESSION_ID")
      elif [[ "$SOURCE" == claude ]]; then
        RENDER_FILE=$(find_by_session_id "$SESSION_ID")
      else
        # auto: a UUID could belong to any source. Try Claude, then Codex, then
        # pi, pinning SOURCE to whichever matched so filter_pipeline uses the
        # right variant.
        if RENDER_FILE=$(find_by_session_id "$SESSION_ID" 2>/dev/null); then
          SOURCE=claude
        elif RENDER_FILE=$(find_codex_by_session_id "$SESSION_ID" 2>/dev/null); then
          SOURCE=codex
        elif RENDER_FILE=$(find_pi_by_session_id "$SESSION_ID" 2>/dev/null); then
          SOURCE=pi
        else
          echo "agent-read: no session file for ID $SESSION_ID" >&2
          exit 1
        fi
      fi
      ;;
    worktree)
      local target dir cwd
      target="${POSITIONAL:-$PWD}"
      resolve_auto_source "$target"
      if [[ "$SOURCE" == codex ]]; then
        cwd="$(cd "$target" 2>/dev/null && pwd)" || {
          echo "agent-read: not a directory: $target" >&2
          exit 1
        }
        # Capture the full list, then take the first line by expansion. Piping the
        # (comparatively slow) Codex discovery into `head -n 1` lets head close the
        # pipe after one line while the producer is still emitting, and the PIPE
        # trap surfaces that as a spurious "write error: Broken pipe".
        local codex_out
        codex_out="$(codex_filtered_files "$cwd")"
        RENDER_FILE="${codex_out%%$'\n'*}"
        if [[ -z "$RENDER_FILE" ]]; then
          echo "agent-read: no matching Codex sessions for $cwd" >&2
        fi
        return 0
      fi
      if [[ "$SOURCE" == pi ]]; then
        local pdir
        pdir="$(pi_project_dir_for "$target")"
        if [[ ! -d "$pdir" ]]; then
          echo "agent-read: no pi sessions for $target" >&2
          echo "  expected: $pdir" >&2
          exit 1
        fi
        RENDER_FILE=$(pi_filtered_files "$pdir" | head -n 1)
        if [[ -z "$RENDER_FILE" ]]; then
          echo "agent-read: no matching pi sessions in $pdir" >&2
        fi
        return 0
      fi
      dir="$(project_dir_for "$target")"
      if [[ ! -d "$dir" ]]; then
        echo "agent-read: no Claude sessions for $target" >&2
        echo "  expected: $dir" >&2
        exit 1
      fi
      RENDER_FILE=$(filtered_sessions_in "$dir" | head -n 1)
      if [[ -z "$RENDER_FILE" ]]; then
        echo "agent-read: no matching sessions in $dir" >&2
      fi
      ;;
  esac
}

case "$MODE" in
  record)
    print_record_command "${POSITIONAL:-$PWD}"
    ;;
  console-list)
    target="${POSITIONAL:-$PWD}"
    dir="$(cd "$target" 2>/dev/null && pwd)" || {
      echo "agent-read: not a directory: $target" >&2
      exit 1
    }
    list_consoles "$dir"
    ;;
  console)
    target="${POSITIONAL:-$PWD}"
    dir="$(cd "$target" 2>/dev/null && pwd)" || {
      echo "agent-read: not a directory: $target" >&2
      exit 1
    }
    # Command substitution, not process substitution: selected_console_files
    # exits non-zero on an unknown --tag, and that status has to reach us.
    selected_out="$(selected_console_files "$dir")" || exit $?
    console_files_selected=()
    while IFS= read -r f; do
      [[ -n "$f" ]] && console_files_selected+=("$f")
    done <<< "$selected_out"

    if [[ ${#console_files_selected[@]} -eq 0 ]]; then
      # Unlike an empty session window, this isn't a normal answer — nothing is
      # recording, so there is nothing to wait for. Say how to fix it.
      echo "agent-read: no console recording in $dir" >&2
      echo "  the human starts one in their terminal with: agent-read --record" >&2
      exit 1
    fi

    if [[ "$FOLLOW" -eq 1 ]]; then
      if [[ ${#console_files_selected[@]} -gt 1 ]]; then
        echo "agent-read: --follow needs a single pane — script(1) records no" >&2
        echo "  timestamps, so several typescripts can't be interleaved readably." >&2
        echo "  pick one with --tag (see: agent-read --console-list)" >&2
        exit 2
      fi
      render_console_follow "${console_files_selected[0]}"
    else
      render_consoles "${console_files_selected[@]}"
    fi
    ;;
  list)
    if [[ "$SOURCE" == auto ]]; then
      records="$(mixed_session_records "${POSITIONAL:-$PWD}")" || exit $?
      if [[ -z "$records" ]]; then
        echo "agent-read: no matching sessions for ${POSITIONAL:-$PWD}" >&2
        exit 0
      fi
      if [[ "$FOLLOW" -eq 1 ]]; then
        files=()
        while IFS=$'\t' read -r epoch source f; do
          if [[ "$source" != claude ]]; then
            echo "agent-read: --all/--peers -f doesn't support $source; use --new for all agents or --claude to follow Claude only" >&2
            exit 2
          fi
          files+=("$f")
        done <<< "$records"
        SOURCE=claude
        render_follow_all "${files[@]}"
      elif [[ "$NEW" -eq 1 ]]; then
        while IFS=$'\t' read -r epoch SOURCE f; do
          render_session_new "$f"
        done <<< "$records"
      else
        list_mixed_sessions "$records"
      fi
      exit 0
    fi
    if [[ "$FOLLOW" -eq 1 || "$NEW" -eq 1 ]]; then
      target="${POSITIONAL:-$PWD}"
      resolve_auto_source "$target"
      # The firehose (render_follow_all) tags each streamed turn with its source
      # session's id. Codex lines carry no per-line sessionId — the id is only in
      # the filename — and tail -qf merges the files, erasing which one each append
      # came from. So Codex can't do firehose-follow; --new (per-file, cursored) is
      # the supported way to catch up on several Codex peers, and it's cheaper too.
      if [[ ( "$SOURCE" == codex || "$SOURCE" == pi ) && "$FOLLOW" -eq 1 ]]; then
        echo "agent-read: --$SOURCE --all/--peers -f (firehose) isn't supported — $SOURCE" >&2
        echo "  lines carry no per-turn session id to tag the merged stream with." >&2
        echo "  use --$SOURCE --peers --new to catch up on every $SOURCE peer instead." >&2
        exit 2
      fi
      files=()
      if [[ "$SOURCE" == codex ]]; then
        cwd="$(cd "$target" 2>/dev/null && pwd)" || {
          echo "agent-read: not a directory: $target" >&2
          exit 1
        }
        while IFS= read -r f; do
          files+=("$f")
        done < <(codex_filtered_files "$cwd")
        if [[ ${#files[@]} -eq 0 ]]; then
          echo "agent-read: no matching Codex sessions for $cwd" >&2
          exit 0
        fi
      elif [[ "$SOURCE" == pi ]]; then
        pdir="$(pi_project_dir_for "$target")"
        if [[ ! -d "$pdir" ]]; then
          echo "agent-read: no pi sessions for $target" >&2
          echo "  expected: $pdir" >&2
          exit 1
        fi
        while IFS= read -r f; do
          files+=("$f")
        done < <(pi_filtered_files "$pdir")
        if [[ ${#files[@]} -eq 0 ]]; then
          echo "agent-read: no matching pi sessions in $pdir" >&2
          exit 0
        fi
      else
        dir="$(project_dir_for "$target")"
        if [[ ! -d "$dir" ]]; then
          echo "agent-read: no Claude sessions for $target" >&2
          echo "  expected: $dir" >&2
          exit 1
        fi
        while IFS= read -r f; do
          files+=("$f")
        done < <(filtered_sessions_in "$dir")
        if [[ ${#files[@]} -eq 0 ]]; then
          echo "agent-read: no matching sessions in $dir" >&2
          exit 0
        fi
      fi
      if [[ "$NEW" -eq 1 ]]; then
        # Catch up on every peer at once: each session gets its own cursor, so
        # this returns only what each has said since this reader last looked.
        for f in "${files[@]}"; do
          render_session_new "$f"
        done
      else
        # Firehose mode: stream new turns from every matched session interleaved.
        render_follow_all "${files[@]}"
      fi
    else
      list_sessions "${POSITIONAL:-$PWD}"
    fi
    ;;
  *)
    resolve_render_file
    [[ -z "$RENDER_FILE" ]] && exit 0
    file="$RENDER_FILE"
    if [[ "$NEW" -eq 1 ]]; then
      render_session_new "$file"
    elif [[ "$TURNS" != "0" ]]; then
      # --turns 0 means "no history" — skip the historical render.
      render_historical "$file"
    fi
    if [[ "$FOLLOW" -eq 1 ]]; then
      render_follow "$file"
    fi
    ;;
esac
