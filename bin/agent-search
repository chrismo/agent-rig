#!/usr/bin/env bash
#
# agent-search - Search Claude and pi prompt history by keyword
#
# Usage: agent-search <term> [days]
#
# Searches ~/.claude/projects/*/*.jsonl and ~/.pi/agent/sessions/*/*.jsonl
# session transcripts for user prompts whose content matches <term>
# (case-insensitive regex). Limits results to the last N days (default: 30).
# Prints date, source, project, sessionId, and an 89-char excerpt as a barred
# table.
#
# Use the sessionId with `claude --resume <sessionId>` (claude source) or
# `pi --resume <sessionId>` (pi source) to resume a session.
#
# Date filter uses UTC. Excludes meta entries, compact-summary continuations,
# and tool-result messages so only real user prompts are returned.
#
# Requires: super (SuperDB), grdy, python3.

set -euo pipefail
shopt -s nullglob

usage() {
  cat <<-EOF
	Usage: agent-search <term> [days]

	Searches ~/.claude/projects/*/*.jsonl and ~/.pi/agent/sessions/*/*.jsonl
	for user prompts matching <term> (case-insensitive). Defaults to last 30
	days.

	Examples:
	  agent-search fivetran
	  agent-search "redis snapshot" 7
	EOF
}

# Escape a value for interpolation into a SuperSQL single-quoted literal:
# backslash first, then the quote. Without this, a term as ordinary as
# "don't" closes the literal early and the search dies with a parse error
# instead of searching.
sq_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\'/\\\'}"
  printf '%s' "$s"
}

resolve_super() {
  [[ -n "${AGENT_SEARCH_SUPER_BIN:-}" ]] && return 0
  local executable
  executable="$(type -P super)" || return 1
  if [[ "$executable" == */shims/super ]]; then
    executable="$(asdf which super)" || return 1
  fi
  [[ -x "$executable" ]] || return 1
  AGENT_SEARCH_SUPER_BIN="$executable"
}

super() {
  resolve_super || return 1
  "$AGENT_SEARCH_SUPER_BIN" "$@"
}

search_claude_projects() {
  # Search Claude Code's ~/.claude/projects/*/*.jsonl transcripts.
  #
  # Every optional field is tested through fields(this) rather than has():
  # super resolves a bare field reference at compile time against the input
  # types it has inferred so far, and errors "no such field" when no record it
  # has read carries that name. isCompactSummary appears only on a compact
  # boundary, so most transcripts never mention it.
  local term days projects_dir
  term="$(sq_escape "$1")" days="$2" projects_dir="$3"
  local files=("$projects_dir"/*/*.jsonl)
  [[ ${#files[@]} -eq 0 ]] && return 0

  super -j -c "
    where type=='user'
      and not (['isMeta'] in fields(this))
      and not (['isCompactSummary'] in fields(this))
      and ['cwd'] in fields(this)
      and ['sessionId'] in fields(this)
      and typeof(message.content) == <string>
      and cast(timestamp, <time>) >= now() - '${days}d'::duration
      and grep('(?i)${term}', cast(message.content, <string>))
    | values {
        date: strftime('%Y-%m-%d %H:%M', cast(timestamp, <time>)),
        source: 'claude',
        project: split(cwd, '/')[-1],
        sessionId,
        prompt: replace(cast(message.content, <string>)[0:89], '\n', ' ')
      }
  " "${files[@]}"
}

search_pi_sessions() {
  local term days sessions_dir
  term="$(sq_escape "$1")" days="$2" sessions_dir="$3"
  local files=("$sessions_dir"/*/*.jsonl)
  [[ ${#files[@]} -eq 0 ]] && return 0

  python3 - "${files[@]}" <<'PY' | super -j -c "
    where cast(timestamp, <time>) >= now() - '${days}d'::duration
      and grep('(?i)${term}', prompt)
    | values {
        date: strftime('%Y-%m-%d %H:%M', cast(timestamp, <time>)),
        source: 'pi',
        project,
        sessionId,
        prompt: replace(prompt[0:89], '\n', ' ')
      }
  " -
import json
import os
import sys

for path in sys.argv[1:]:
    with open(path, "rb") as transcript:
        header = None
        for line in transcript:
            try:
                record = json.loads(line)
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue
            if not isinstance(record, dict):
                continue
            if header is None and record.get("type") == "session":
                header = record
                cwd = header.get("cwd", "")
                project = (os.path.basename(cwd.rstrip("/")) if cwd else
                           os.path.basename(os.path.dirname(path)).removeprefix("--")
                           .removesuffix("--").rsplit("-", 1)[-1])
            if not header or not header.get("id") or record.get("type") != "message":
                continue
            message = record.get("message")
            if not isinstance(message, dict) or message.get("role") != "user":
                continue
            content = message.get("content")
            if not isinstance(content, list):
                continue
            texts = [block["text"] for block in content
                     if isinstance(block, dict) and block.get("type") == "text"
                     and isinstance(block.get("text"), str)]
            if not texts:
                continue
            print(json.dumps({"timestamp": record.get("timestamp"),
                              "project": project, "sessionId": header["id"],
                              "prompt": " ".join(texts)}, ensure_ascii=False))
PY
}

agent_search_main() {
  local term="$1" days="${2:-30}"
  local projects_dir="${CLAUDE_SEARCH_PROJECTS_DIR:-$HOME/.claude/projects}"
  local pi_sessions_dir="${CLAUDE_SEARCH_PI_SESSIONS_DIR:-$HOME/.pi/agent/sessions}"

  if [[ ! "$days" =~ ^[0-9]+$ ]]; then
    echo "agent-search: days must be a whole number, got: $days" >&2
    return 2
  fi

  if [[ ! -d "$projects_dir" && ! -d "$pi_sessions_dir" ]]; then
    echo "No session files found under $projects_dir or $pi_sessions_dir" >&2
    return 1
  fi

  resolve_super || { echo "agent-search: super binary not found" >&2; return 1; }

  # Each source is collected on its own so one failing reader reports itself
  # and the other's results still print — inside a single pipeline component,
  # errexit would abort the group and erase both.
  local claude_rows="" pi_rows=""
  claude_rows="$(search_claude_projects "$term" "$days" "$projects_dir")" ||
    echo "agent-search: reading Claude transcripts failed" >&2
  pi_rows="$(search_pi_sessions "$term" "$days" "$pi_sessions_dir")" ||
    echo "agent-search: reading pi transcripts failed" >&2

  if [[ -z "$claude_rows" && -z "$pi_rows" ]]; then
    echo "agent-search: no prompts matching '$term' in the last ${days}d" >&2
    return 0
  fi

  printf '%s\n%s\n' "$claude_rows" "$pi_rows" |
    super -j -c "where ['date'] in fields(this) | sort -r date" - | grdy
}

# Allow bats to source this file (for unit-testing the search_* functions)
# without running main or exiting the shell. Note that sourcing also imports
# this script's `set -euo pipefail` and `shopt -s nullglob` into the caller.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || -z "${1:-}" ]]; then
    usage
    exit 0
  fi
  agent_search_main "$1" "${2:-30}"
fi
