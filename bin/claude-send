#!/usr/bin/env bash
#
# claude-send - list and message live Claude sessions, from a shell
#
# Claude's own ListAgents/SendMessage tools are only callable by Claude. This
# does the same two jobs from outside: any script, cron job, CI step or git hook
# can see which sessions are running and drop a message into one.
#
#   claude-send                       # reachable peers: name, pid, ref, age, cwd
#   claude-send --all                 # include sessions that no longer answer
#   claude-send --send <target> <msg> # deliver a message; target is name|pid|ref
#   claude-send --send <target> -     # read the message body from stdin
#   claude-send --watch               # block until any peer's status changes
#   claude-send --watch --for idle    # block until a peer reaches that status
#   claude-send --ask <target> <q>    # ask, block for the reply, print it
#   claude-send --ask ... --register  # also be findable on the roster while asking
#
#   claude-send --send builder "deploy finished, tests green"
#   ./run-tests.sh || claude-send --send builder "suite went red"
#   claude-send --watch --for idle && say "a session went idle"
#
# --watch is a doorbell, not a poller: it blocks and prints one line when
# something changes, so a caller pays for one wake-up rather than one per tick.
# Exit 0 on a change, 2 on --timeout, so `if claude-send --watch …` reads right.
#
# How it works (see docs/inter-claude-protocol.md — none of this is a supported
# API, and bin/claude-contract.bats is what tells you when it stops being true):
#
#   discovery  every ~/.claude/sessions/<pid>.json, filename filtered to
#              /^\d+\.json$/, liveness by kill -0, then a connect probe
#   reachable  a recorded messagingSocketPath does NOT mean reachable — a
#              registry file outlives the process, so the socket is probed
#   ref        sha256("session:" + messagingSocketPath), first 6 hex, which is
#              the same [ref] Claude prints in a ListAgents roster
#   send       one line of JSON on the peer's unix socket; the receiver treats
#              it as an ordinary user turn
#
# A message sent this way carries no reply address, so no delivery receipt comes
# back. Fire and forget: a zero exit means the bytes were accepted by the
# socket, not that a human or model has read them.
#
# Requires: nc, shasum, super (SuperDB, for all JSON parse and encode).

set -uo pipefail

SESSIONS_DIR="${CLAUDE_SESSIONS_META_DIR:-$HOME/.claude/sessions}"
SELF_SOCK="${CLAUDE_CODE_MESSAGING_SOCKET:-}"
PROBE_TIMEOUT="${CLAUDE_SEND_PROBE_TIMEOUT:-1}"
SOCKET_DIR="${CLAUDE_SEND_SOCKET_DIR:-/tmp/cc-socks}"

die() { echo "claude-send: $*" >&2; exit 1; }

usage() {
  sed -n '3,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

pid_is_live() { kill -0 "$1" 2>/dev/null; }

# Connect and hang up. Distinguishes a live listener from both a missing path
# and a leftover socket file with nobody behind it.
socket_answers() {
  nc -U -w "$PROBE_TIMEOUT" "$1" < /dev/null > /dev/null 2>&1
}

ref_for() { printf '%s' "session:$1" | shasum -a 256 | cut -c1-6; }

# One TSV row per live registry record: pid, name, kind, status, sock, cwd.
# The filename is the pid and is the only thing trusted to identify the file;
# Claude applies the same filter.
collect_rows() {
  [[ -d "$SESSIONS_DIR" ]] || return 0

  local f pid
  for f in "$SESSIONS_DIR"/*.json; do
    [[ -f "$f" ]] || continue
    pid="${f##*/}"; pid="${pid%.json}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    pid_is_live "$pid" || continue

    # Spread defaults under the record first: most of these fields are optional
    # (`name` is absent on a session that was never named, `statusUpdatedAt` on
    # one that has not changed status) and referencing an absent field is an
    # error, not a null. Same {...defaults, ...this} idiom install.sh uses.
    super -f line -c 'values {...{pid:0,name:"",kind:"",status:"",
        messagingSocketPath:"",cwd:"",statusUpdatedAt:0}, ...this}
      | values join([cast(pid, <string>), name, kind, status,
                     messagingSocketPath, cwd, cast(statusUpdatedAt, <string>)], "\t")' \
      "$f" 2>/dev/null
  done
}

# Milliseconds-since-epoch to a short age. Only `status` and `statusUpdatedAt`
# are actually written by live sessions — `tempo`, `waitingFor`, `needs`,
# `state` and `detail` are parsed by Claude's own reader but populated in none
# of the registry files observed, so nothing here is built on them.
fmt_age() {
  local ms="$1"
  [[ "$ms" =~ ^[0-9]+$ ]] || { printf '%s' "-"; return; }
  # 0 is the "absent" default from the spread above, not an epoch.
  [[ "$ms" == "0" ]] && { printf '%s' "-"; return; }
  local now delta
  now=$(date +%s)
  delta=$(( now - ms / 1000 ))
  (( delta < 0 )) && delta=0
  if   (( delta < 60 ));    then printf '%ds' "$delta"
  elif (( delta < 3600 ));  then printf '%dm' "$(( delta / 60 ))"
  elif (( delta < 86400 )); then printf '%dh' "$(( delta / 3600 ))"
  else                           printf '%dd' "$(( delta / 86400 ))"
  fi
}

# "pid<TAB>name<TAB>status", one line per peer, self excluded. The unit --watch
# diffs. Deliberately does NOT probe: a probe per peer per tick would make the
# doorbell cost scale with roster size, and a dead session's status is frozen
# anyway, so it can never produce a spurious wake-up.
status_snapshot() {
  local pid name kind status sock cwd supd
  while IFS=$'\t' read -r pid name kind status sock cwd supd; do
    [[ -n "$sock" ]] || continue
    [[ -n "$SELF_SOCK" && "$sock" == "$SELF_SOCK" ]] && continue
    printf '%s\t%s\t%s\n' "$pid" "$name" "$status"
  done <<< "$(collect_rows)"
}

status_of() {
  local want_pid="$1" snap="$2" pid name status
  while IFS=$'\t' read -r pid name status; do
    [[ "$pid" == "$want_pid" ]] && { printf '%s' "$status"; return; }
  done <<< "$snap"
}

cmd_list() {
  local show_all="$1"
  local rows pid name kind status sock cwd supd ref reach age
  rows=$(collect_rows)
  [[ -n "$rows" ]] || return 0

  local out=""
  while IFS=$'\t' read -r pid name kind status sock cwd supd; do
    [[ -n "$sock" ]] || continue
    # Never list yourself; Claude excludes self the same way, by socket path.
    [[ -n "$SELF_SOCK" && "$sock" == "$SELF_SOCK" ]] && continue

    if socket_answers "$sock"; then
      reach=""
    else
      [[ "$show_all" == "yes" ]] || continue
      reach="unreachable"
    fi

    ref=$(ref_for "$sock")
    age=$(fmt_age "$supd")
    out+=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
      "${name:-(unnamed)}" "$pid" "$ref" "$kind" "$status" "$age" "$cwd" "$reach")
    out+=$'\n'
  done <<< "$rows"

  [[ -n "$out" ]] || return 0

  {
    printf 'NAME\tPID\tREF\tKIND\tSTATUS\tFOR\tCWD\t\n'
    printf '%s' "$out"
  } | column -t -s $'\t'
}

cmd_watch() {
  local interval=1 timeout=0 want=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="${2:-1}"; shift 2 ;;
      --timeout)  timeout="${2:-0}"; shift 2 ;;
      --for)      want="${2:-}"; shift 2 ;;
      *)          die "unknown --watch option '$1'" ;;
    esac
  done

  local prev started now pid name status was
  prev=$(status_snapshot)
  started=$(date +%s)

  while true; do
    sleep "$interval"

    if [[ "$timeout" != "0" ]]; then
      now=$(date +%s)
      (( now - started >= timeout )) && exit 2
    fi

    local cur
    cur=$(status_snapshot)
    [[ "$cur" == "$prev" ]] && continue

    while IFS=$'\t' read -r pid name status; do
      [[ -n "$pid" ]] || continue
      was=$(status_of "$pid" "$prev")
      [[ "$was" == "$status" ]] && continue
      # A change we were not asked about still advances the baseline, so the
      # one we ARE waiting for is seen as a change when it lands.
      [[ -n "$want" && "$status" != "$want" ]] && continue
      printf '%s\t%s\t%s -> %s\n' "${name:-(unnamed)}" "$pid" "${was:-(new)}" "$status"
      exit 0
    done <<< "$cur"

    prev="$cur"
  done
}

# Resolve a target to "sock<TAB>name<TAB>pid". Matches a name exactly, a pid
# exactly, or a ref by prefix — the same three handles a roster row shows.
resolve_target() {
  local want="$1" rows pid name kind status sock cwd ref
  rows=$(collect_rows)
  [[ -n "$rows" ]] || return 1

  local match="" count=0
  while IFS=$'\t' read -r pid name kind status sock cwd supd; do
    [[ -n "$sock" ]] || continue
    ref=$(ref_for "$sock")
    if [[ "$name" == "$want" || "$pid" == "$want" || "$ref" == "$want"* ]]; then
      match="$sock"$'\t'"$name"$'\t'"$pid"
      count=$((count + 1))
    fi
  done <<< "$rows"

  [[ "$count" -eq 0 ]] && return 1
  [[ "$count" -gt 1 ]] && { echo "claude-send: '$want' matches $count sessions; use a pid or ref" >&2; return 2; }
  printf '%s\n' "$match"
}

cmd_send() {
  local want="${1:-}" body="${2:-}"
  [[ -n "$want" ]] || usage 1
  [[ $# -ge 2 ]] || die "no message body (use - to read stdin)"

  [[ "$body" == "-" ]] && body=$(cat)

  local resolved rc sock name pid
  resolved=$(resolve_target "$want"); rc=$?
  [[ $rc -eq 2 ]] && exit 1
  [[ $rc -ne 0 ]] && die "no session matching '$want' (try: claude-send --all)"

  IFS=$'\t' read -r sock name pid <<< "$resolved"

  if [[ -n "$SELF_SOCK" && "$sock" == "$SELF_SOCK" ]]; then
    die "'$want' is this session; refusing to message yourself"
  fi

  socket_answers "$sock" \
    || die "'$name' (pid $pid) is listed but its socket does not answer — the session likely exited"

  # super does the escaping; hand-rolling it breaks on quotes and backslashes,
  # and a malformed line is silently discarded by the receiver. Reading the body
  # as `line` input and re-joining keeps multi-line messages intact — one record
  # per line otherwise, which would send the first line only.
  local line
  line=$(printf '%s' "$body" | super -i line -f json -c \
    'collect(this) | values {type:"user", message:{role:"user", content:join(this, "\n")}}' - \
    | tr -d '\n') || die "failed to encode message"

  printf '%s\n' "$line" | nc -U -w 2 "$sock" > /dev/null 2>&1 \
    || die "failed to write to $sock"
}

# Ask a peer a question and block for the answer.
#
# A reply cannot come back via the `from` field: attribution is text that the
# SendMessage tool embeds inside message.content, so a raw write reaches the
# peer with no sender the model can see, and it has nothing to reply to. What
# works is being *addressable* — the roster lists any registry entry whose pid
# is alive and whose socket answers. So we register for exactly as long as the
# question is outstanding, then remove ourselves.
cmd_ask() {
  local want="${1:-}" question="${2:-}"
  [[ -n "$want" ]] || usage 1
  [[ $# -ge 2 ]] || die "no question (use - to read stdin)"
  shift 2

  local timeout=60 ask_name="claude-send-ask"
  # NOT local: the EXIT trap fires after this function has returned, and bash
  # locals are gone by then — cleanup would run with empty paths and delete
  # nothing, silently leaking a socket and a registry entry.
  register="no"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout)  timeout="${2:-60}"; shift 2 ;;
      --name)     ask_name="${2:-claude-send-ask}"; shift 2 ;;
      --register) register="yes"; shift ;;
      *)          die "unknown --ask option '$1'" ;;
    esac
  done

  [[ "$question" == "-" ]] && question=$(cat)

  # Resolve BEFORE registering, so a bad target never leaves an entry behind.
  local resolved rc sock name pid
  resolved=$(resolve_target "$want"); rc=$?
  [[ $rc -eq 2 ]] && exit 1
  [[ $rc -ne 0 ]] && die "no session matching '$want' (try: claude-send --all)"
  IFS=$'\t' read -r sock name pid <<< "$resolved"

  [[ -n "$SELF_SOCK" && "$sock" == "$SELF_SOCK" ]] && die "'$want' is this session"

  socket_answers "$sock" || die "'$name' (pid $pid) does not answer"

  mkdir -p "$SOCKET_DIR" 2>/dev/null
  chmod 700 "$SOCKET_DIR" 2>/dev/null

  mkdir -p "$SOCKET_DIR" 2>/dev/null
  chmod 700 "$SOCKET_DIR" 2>/dev/null

  # NOT "<pid>.sock" — that is the shape a real session uses, and this is not a
  # session. The registry entry, when we write one, is keyed by pid regardless.
  sock_path="$SOCKET_DIR/peer-ask-$$.sock"
  reg_path="$SESSIONS_DIR/$$.json"
  reply_file=$(mktemp) || die "cannot create temp file"

  # A leaked socket or registry entry is exactly the stale row the roster
  # garbage-collects, so clean up on every exit path including signals.
  ask_cleanup() {
    [[ -n "${nc_pid:-}" ]] && kill "$nc_pid" 2>/dev/null
    rm -f "$sock_path" "$reply_file"
    [[ "$register" == "yes" ]] && rm -f "$reg_path"
    return 0
  }
  trap ask_cleanup EXIT INT TERM

  rm -f "$sock_path"
  nc -lU "$sock_path" > "$reply_file" 2>/dev/null &
  nc_pid=$!

  # Bind before sending, or the peer can answer into a socket that is not there.
  local i=0
  while [[ ! -S "$sock_path" && $i -lt 50 ]]; do sleep 0.1; i=$((i + 1)); done
  [[ -S "$sock_path" ]] || die "could not bind $sock_path"

  # Registration is opt-in. It puts a non-Claude process on the roster of every
  # live session, worth it only when you WANT to be found — a human running
  # ListAgents seeing who is asking, or a peer messaging the asker unprompted.
  # The reply never needs it: it comes back to the uds: address in the prompt.
  if [[ "$register" == "yes" ]]; then
    local now
    now=$(( $(date +%s) * 1000 ))
    mkdir -p "$SESSIONS_DIR" 2>/dev/null
    printf '%s' "$ask_name" | super -i line -f json -c \
      "values {pid:$$, name:this, kind:\"interactive\", status:\"waiting\",
               startedAt:$now, statusUpdatedAt:$now, peerProtocol:1,
               cwd:\"$PWD\", messagingSocketPath:\"$sock_path\"}" - | tr -d '\n' > "$reg_path" \
      || die "could not register at $reg_path"
  fi

  # Reply to the raw uds: path, NOT to the name. Pins are keyed to a ref, and
  # this process gets a fresh pid -> socket -> ref on every invocation, so a
  # bare-name reply bounces every time no matter how many succeeded before.
  # A uds: path needs no pin, no ref and no roster entry.
  local body
  body="$question

[Asked by $ask_name, a shell process blocked on your reply. Reply with SendMessage to \"uds:$sock_path\" — address it exactly like that, not by name. Your reply is printed to a terminal, so keep it short and plain.]"

  local line
  line=$(printf '%s' "$body" | super -i line -f json -c \
    'collect(this) | values {type:"user", message:{role:"user", content:join(this, "\n")}}' - \
    | tr -d '\n') || die "failed to encode question"
  printf '%s\n' "$line" | nc -U -w 2 "$sock" > /dev/null 2>&1 \
    || die "failed to write to $sock"

  local waited=0
  while [[ ! -s "$reply_file" ]]; do
    sleep 0.2
    waited=$(( waited + 1 ))
    (( waited * 2 / 10 >= timeout )) && exit 2
  done
  # nc exits once the peer closes; give the last bytes a moment to land.
  sleep 0.2

  # Attribution is a text wrapper inside content, not a field. Strip it so
  # callers get the answer rather than protocol furniture.
  super -f line -c 'values {...{message:{role:"",content:""}}, ...this}
                    | values message.content' "$reply_file" 2>/dev/null \
    | sed -e '/^<cross-session-message/d' -e '/^<\/cross-session-message>/d' \
    | sed -e '/./,$!d'
}

main() {
  local show_all="no"
  case "${1:---list}" in
    --list)        cmd_list "no" ;;
    --all)         cmd_list "yes" ;;
    --watch)       shift; cmd_watch "$@" ;;
    --ask)         shift; cmd_ask "$@" ;;
    --send)        shift; cmd_send "$@" ;;
    -h|--help)     usage 0 ;;
    *)             die "unknown option '$1' (try --help)" ;;
  esac
}

main "$@"
