#!/bin/bash
#
# claude-tabs - Save and restore Ghostty Claude Code sessions
#
# Usage: claude-tabs save          Save active sessions to manifest
#        claude-tabs restore       Restore sessions from manifest
#        claude-tabs list-active   Show running sessions (dry-run of save)
#        claude-tabs list-saved    Show the saved manifest (what restore uses)
#        claude-tabs history       fzf-pick a saved snapshot and restore it
#
# Detection: Claude Code keeps its own registry. Every session writes
# ~/.claude/sessions/<pid>.json while it runs — cwd, sessionId, kind, name,
# status — and removes it on a clean exit. We read that directory instead of
# asking the OS what's running.
#
# Registry fields we use (the file carries many more):
#   pid         also the filename
#   cwd         the session's working directory
#   sessionId   the UUID `claude --resume` takes
#   kind        interactive | bg | daemon | daemon-worker — only the first is a tab
#
# Killed sessions (Ghostty quit, SIGKILL) leave their file behind, so each
# entry is liveness-checked against its own PID before it counts.
#
# Path encoding: /Users/chris/dev/ds5 → -Users-chris-dev-ds5
# Resume: `claude --resume <session-id>` resumes by UUID.
#
# Manifest: ~/.claude/tab-state.json (JSON array of {name, path, session_id})
#
# Known limitations:
#   - Pane layout is lost. The registry records processes, not terminal
#     geometry. Sessions in Ghostty panes (splits) are detected and saved
#     correctly, but restore opens each as a separate tab.
#   - Stale session UUIDs: `claude --resume` with an invalid UUID should
#     fail gracefully or start fresh.
#   - Resuming an active session: `claude --resume` does not error — it
#     creates a second writer to the same JSONL. Both instances interleave
#     on disk but are oblivious to each other in-memory. Not destructive,
#     but not the intended workflow (save → kill Ghostty → restore).
#   - Restore adds tabs; it doesn't replace existing ones. Kill Ghostty
#     first for a clean slate.
#   - PID reuse is not guarded. The registry records a `procStart` timestamp
#     Claude checks against the live process, but it writes that field in UTC
#     while `ps -o lstart=` prints local time, so the strings don't compare
#     directly. A reused PID at most restores a tab for an exited session.
#   - Incomplete detection from non-interactive contexts. Observed 2026-06-03,
#     under the previous `pgrep`/`lsof` detection: `claude-tabs save` run from
#     the Stop hook (or any claude-spawned subprocess) sometimes could not see
#     running `claude` processes, yielding `[]` and overwriting a good manifest
#     with empty. Reading the registry doesn't depend on process-argv
#     visibility, so that mechanism no longer applies — but this has not been
#     re-observed under load, so the recovery paths stay: every save is
#     archived to the history dir, and `work-context` (the worktree walk) can
#     reconstruct active work.
#     TODO: guard `cmd_save` so it never replaces a populated manifest with an
#     empty detection result (add a `--allow-empty` escape hatch for the
#     intentional "record nothing" case).
#
# Restore uses Ghostty's native scripting (Ghostty 1.3+) — `new tab`,
# `input text to terminal`, `send key "enter" to terminal` — instead of
# clipboard+keystroke routing through System Events. This avoids focus races
# where a paste meant for a new tab landed in the prior tab's claude prompt.
#
# Pane-aware restore is possible but unimplemented: the dictionary exposes
# `split direction:right/left/down/up` on terminals, so save could enumerate
# terminals-per-tab and restore could create splits. Panes are typically temp
# helpers, so tabs-only remains the practical choice.
# See also: ghostty-workspace (YAML-driven layouts via AppleScript).
#

set -euo pipefail

CLAUDE_TABS_PROJECTS_DIR="${CLAUDE_TABS_PROJECTS_DIR:-$HOME/.claude/projects}"
CLAUDE_TABS_MANIFEST="${CLAUDE_TABS_MANIFEST:-$HOME/.claude/tab-state.json}"
CLAUDE_TABS_HISTORY_DIR="${CLAUDE_TABS_HISTORY_DIR:-$HOME/.claude/tab-history}"
CLAUDE_TABS_SESSIONS_DIR="${CLAUDE_TABS_SESSIONS_DIR:-$HOME/.claude/sessions}"

# ─────────────────────────────────────────────────────────────────────────────
# Functions (sourced by tests)
# ─────────────────────────────────────────────────────────────────────────────

encode_project_path() {
  local path="$1"
  # Strip trailing slash
  path="${path%/}"
  # Replace / with -
  echo "${path//\//-}"
}

# Keep only the sessions that are terminal tabs, and reduce each to the two
# fields the manifest needs. `kind` predates nothing else we read, so entries
# written before it existed are kept rather than dropped.
#
# Presence is tested through fields(this) rather than has(): super resolves a
# bare field reference at compile time whenever it can infer the input schema
# up front, and errors "no such field" when no record declares that name. It
# defers to runtime for stdin, which is how this filter is fed today — so the
# has() form worked here, but only by way of the input being a pipe.
REGISTRY_TO_TSV='
  where (["kind"] in fields(this) ? kind == "interactive" : true)
    and ["cwd"] in fields(this) and ["sessionId"] in fields(this)
  | values f"{cwd}\t{sessionId}"
'

# detect_sessions <registry_ndjson>
# Turns registry lines into the manifest array: {name, path, session_id}.
#
# The registry names each session's own sessionId, so three sessions in one
# directory produce three exact pairings. (The previous lsof path could only
# rank that directory's transcripts by mtime and hope the pairing was right —
# each restored tab got *a* real session, just not necessarily its own.)
#
# A session with no transcript on disk is skipped: `claude --resume <id>` has
# nothing to reopen. Observed on a tab that was opened but never typed into.
detect_sessions() {
  local ndjson="$1"
  local entries=()

  if [[ -n "$ndjson" ]]; then
    local cwd session_id
    while IFS=$'\t' read -r cwd session_id; do
      [[ -n "$cwd" && -n "$session_id" ]] || continue

      local project_dir
      project_dir="$CLAUDE_TABS_PROJECTS_DIR/$(encode_project_path "$cwd")"
      [[ -f "$project_dir/$session_id.jsonl" ]] || continue

      entries+=("{\"name\": \"$(basename "$cwd")\", \"path\": \"$cwd\", \"session_id\": \"$session_id\"}")
    done < <(printf '%s\n' "$ndjson" | super -i json -f line -c "$REGISTRY_TO_TSV" - 2>/dev/null)
  fi

  # Build JSON array
  if [[ ${#entries[@]} -eq 0 ]]; then
    echo "[]"
    return 0
  fi

  local json="["
  local first=true
  for entry in "${entries[@]}"; do
    if [[ "$first" == true ]]; then
      first=false
    else
      json+=","
    fi
    json+=$'\n  '"$entry"
  done
  json+=$'\n]'
  echo "$json"
}

# pid_is_live <pid>
# Factored out so the test suite can run fixture PIDs through detection.
pid_is_live() {
  kill -0 "$1" 2>/dev/null
}

# read_registry [dir]
# Emits one line of JSON per live session in Claude's own session registry.
read_registry() {
  local dir="${1:-$CLAUDE_TABS_SESSIONS_DIR}"
  [[ -d "$dir" ]] || return 0

  local f pid
  for f in "$dir"/*.json; do
    [[ -f "$f" ]] || continue

    # The filename IS the pid — anything else in this directory isn't a
    # session record. (Claude applies the same /^\d+\.json$/ filter.)
    pid="${f##*/}"
    pid="${pid%.json}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue

    pid_is_live "$pid" || continue

    # One JSON object per file, not necessarily newline-terminated.
    cat "$f"
    echo
  done
}

cmd_save() {
  local json
  json=$(detect_sessions "$(read_registry)")

  if [[ "$json" == "[]" ]]; then
    echo "[]" > "$CLAUDE_TABS_MANIFEST"
  else
    echo "$json" | super -J -c 'unnest this | sort name | collect(this)' - > "$CLAUDE_TABS_MANIFEST"
  fi

  # Copy to history
  mkdir -p "$CLAUDE_TABS_HISTORY_DIR"
  cp "$CLAUDE_TABS_MANIFEST" "$CLAUDE_TABS_HISTORY_DIR/tab-state-$(date +%Y%m%d-%H%M%S).json"

  local count
  count=$(echo "$json" | super -f line -c 'unnest this | count()' -)
  echo "Saved $count sessions to $CLAUDE_TABS_MANIFEST"
}

# list-active: what's running right now (the set `save` would capture).
# Reads the live session registry — does NOT read the manifest.
cmd_list_active() {
  local json
  json=$(detect_sessions "$(read_registry)")

  if [[ "$json" == "[]" ]]; then
    return 0
  fi

  echo "$json" | super -J -c 'unnest this | sort name | collect(this)' - | grdy
}

# list-saved: what's in the manifest (the set `restore` would reopen).
# Reads the manifest file — does NOT inspect live processes.
cmd_list_saved() {
  if [[ ! -f "$CLAUDE_TABS_MANIFEST" ]]; then
    echo "No saved manifest at $CLAUDE_TABS_MANIFEST"
    return 0
  fi

  local content
  content=$(cat "$CLAUDE_TABS_MANIFEST")
  if [[ -z "$content" || "$content" == "[]" ]]; then
    echo "Saved manifest is empty: $CLAUDE_TABS_MANIFEST"
    return 0
  fi

  super -J -c 'unnest this | sort name | collect(this)' "$CLAUDE_TABS_MANIFEST" | grdy
}

# history_label <snapshot-filename-or-path>
# tab-state-20260501-083328.json → "2026-05-01 08:33:28"
history_label() {
  local base="${1##*/}"
  local stamp="${base#tab-state-}"
  stamp="${stamp%.json}"
  local d="${stamp%%-*}"   # 20260501
  local t="${stamp##*-}"   # 083328
  printf '%s-%s-%s %s:%s:%s' \
    "${d:0:4}" "${d:4:2}" "${d:6:2}" "${t:0:2}" "${t:2:2}" "${t:4:2}"
}

# history_rows [dir]
# Emits one "path<TAB>label" row per snapshot, newest-first.
history_rows() {
  local dir="${1:-$CLAUDE_TABS_HISTORY_DIR}"
  local files
  # No matches → ls fails; under `pipefail` that must not bubble up as an error.
  files=$(ls -t "$dir"/tab-state-*.json 2>/dev/null) || return 0
  [[ -z "$files" ]] && return 0
  while IFS= read -r f; do
    printf '%s\t%s\n' "$f" "$(history_label "$f")"
  done <<< "$files"
}

build_restore_applescript() {
  local cmd_dir="$1"
  local count="$2"

  # Uses Ghostty's native scripting commands (Ghostty 1.3+):
  #   - `new tab in window`   — returns a tab object directly, no focus race
  #   - `input text ... to terminal`  — delivers to a specific terminal surface
  #   - `send key "enter" to terminal` — Enter to that same terminal
  #
  # The old implementation routed cmd+v through System Events, which delivered
  # to whatever tab happened to be frontmost when the keystroke landed. Under
  # load, the new tab hadn't taken focus yet and the paste ended up in the
  # prior tab where `claude` was already booting.
  #
  # Note: we keep `tell application id "com.mitchellh.ghostty"` blocks small and avoid using
  # any identifier that might collide with terminology Ghostty's dictionary
  # loads into scope (e.g. `date`, `time`).
  #
  # `tell application id "com.mitchellh.ghostty" to activate` does NOT reliably open a window:
  # launching Ghostty cold (or waking it from a backgrounded, zero-window
  # state) leaves it running with no windows. So we don't wait for a window to
  # appear — we ask the scripting dictionary for one with `new window` when the
  # count is zero, and reuse that fresh window's default tab for cmd-0.
  cat <<EOF
on readCmd(cmdFile)
    return do shell script "cat " & quoted form of cmdFile
end readCmd

on sendToTerminal(term, cmdFile)
    set cmdText to my readCmd(cmdFile)
    tell application id "com.mitchellh.ghostty"
        input text cmdText to term
        send key "enter" to term
    end tell
end sendToTerminal

set cmdDir to "${cmd_dir}"
set sessionCount to ${count}

tell application id "com.mitchellh.ghostty" to activate

-- Acquire a target window. If Ghostty has no windows (cold launch, or a
-- backgrounded zero-window state), create one and reuse its default tab for
-- cmd-0 so we don't strand an empty shell. If a window already exists, add
-- our tabs to it without disturbing the user's existing tabs.
tell application id "com.mitchellh.ghostty"
    if (count of windows) is 0 then
        set targetWindow to (new window)
        set reuseFirstTab to true
    else
        set targetWindow to front window
        set reuseFirstTab to false
    end if
end tell

set startIdx to 0
if reuseFirstTab then
    -- Give the freshly created window's shell a moment to come up before we
    -- paste into it.
    delay 0.3
    tell application id "com.mitchellh.ghostty"
        set firstTerm to terminal 1 of tab 1 of targetWindow
    end tell
    my sendToTerminal(firstTerm, cmdDir & "/cmd-0.txt")
    set startIdx to 1
end if

repeat with i from startIdx to (sessionCount - 1)
    tell application id "com.mitchellh.ghostty"
        set newT to new tab in targetWindow
        set newTerm to terminal 1 of newT
    end tell
    my sendToTerminal(newTerm, cmdDir & "/cmd-" & i & ".txt")
end repeat
EOF
}

cmd_restore() {
  local manifest="${1:-$CLAUDE_TABS_MANIFEST}"

  if [[ ! -f "$manifest" ]]; then
    echo "Manifest not found: $manifest"
    return 1
  fi

  local count
  count=$(super -f line -c 'unnest this | count()' "$manifest")
  echo "Restoring $count sessions from $manifest"

  # Write per-session command files
  local cmd_dir="${CLAUDE_TABS_CMD_DIR:-$(mktemp -d "${TMPDIR:-/tmp}/claude-tabs-restore.XXXXXX")}"
  mkdir -p "$cmd_dir"

  local i=0
  while IFS=, read -r path session_id; do
    if [[ -n "${CLAUDE_TABS_DRY_RUN:-}" ]]; then
      echo "cd $path && claude --resume $session_id"
    else
      local wt_name
      wt_name=$(basename "$path")
      echo "cd $path && printf '\\033]0;%s\\007' '$wt_name' && claude --resume $session_id" \
        > "$cmd_dir/cmd-$i.txt"
    fi
    ((i++)) || true
  done < <(super -f csv -c 'unnest this | cut path, session_id' "$manifest" | tail -n +2)

  if [[ -n "${CLAUDE_TABS_DRY_RUN:-}" ]]; then
    return 0
  fi

  # Batch restore via single AppleScript invocation
  build_restore_applescript "$cmd_dir" "$count" | osascript

  # Cleanup temp dir (only if we created it)
  if [[ -z "${CLAUDE_TABS_CMD_DIR:-}" ]]; then
    rm -rf "$cmd_dir"
  fi
}

# history: browse timestamped save snapshots in an fzf picker and restore the
# selected one. The preview window renders that snapshot's sessions (grdy).
# Reads only the history dir — does NOT inspect live processes or the manifest.
cmd_history() {
  if [[ ! -d "$CLAUDE_TABS_HISTORY_DIR" ]]; then
    echo "No history dir at $CLAUDE_TABS_HISTORY_DIR"
    return 0
  fi

  local rows
  rows=$(history_rows)
  if [[ -z "$rows" ]]; then
    echo "No history snapshots in $CLAUDE_TABS_HISTORY_DIR"
    return 0
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not found — install it to browse tab history interactively." >&2
    return 1
  fi

  # fzf field 1 (tab-delimited) is the snapshot path; column 2 (the label) is
  # what's shown in the list. On cancel fzf exits non-zero — swallow it.
  local selected
  selected=$(printf '%s\n' "$rows" | fzf \
    --delimiter='\t' \
    --with-nth=2 \
    --prompt='tab-history> ' \
    --header='enter: restore   esc: cancel' \
    --preview='grdy {1}' \
    --preview-window='right:72%:wrap') || return 0

  [[ -z "$selected" ]] && return 0

  local file="${selected%%$'\t'*}"
  echo "Restoring snapshot from $(history_label "$file")"
  cmd_restore "$file"
}

# ─────────────────────────────────────────────────────────────────────────────
# Main (skipped when sourced)
# ─────────────────────────────────────────────────────────────────────────────

# Guard: when sourced, define functions but don't run main
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0 2>/dev/null || true
fi

usage() {
  echo "Usage: claude-tabs <command>"
  echo ""
  echo "Commands:"
  echo "  save          Save running Claude sessions to the manifest"
  echo "  restore       Reopen the sessions in the manifest"
  echo "  list-active   Show currently running sessions (dry-run of save)"
  echo "  list-saved    Show the saved manifest (what restore will reopen)"
  echo "  history       Browse saved snapshots in fzf and restore one"
  echo ""
  echo "Manifest: $CLAUDE_TABS_MANIFEST"
  echo "Every save is also archived (timestamped) under:"
  echo "  $CLAUDE_TABS_HISTORY_DIR"
}

case "${1:-}" in
  save)        cmd_save ;;
  restore)     shift; cmd_restore "$@" ;;
  list-active) cmd_list_active ;;
  list-saved)  cmd_list_saved ;;
  history)     cmd_history ;;
  -h|--help)   usage ;;
  *)
    usage
    exit 1
    ;;
esac
