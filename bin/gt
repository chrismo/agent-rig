#!/usr/bin/env bash
#
# gt - Fuzzy-select a Ghostty tab or window and jump to it.
#
# Usage: gt
# Requires: fzf and Ghostty/Moestty's native AppleScript API.
# Selection uses stable tab IDs, not titles or Window-menu positions.

set -euo pipefail

# Where worktrees live, so a title's dir leaf resolves to a real path for the
# preview. Worktrees live at ~/dev/<name>.
DEV_ROOT="${DEV_ROOT:-$HOME/dev}"

# ── pure helpers (unit-tested in gt.bats) ─────────────────────────────────────

# Extract the "dir" leaf from a menu title.
#   "🔵 agent-rig (main)"  -> "agent-rig"
#   "dscout (main)"         -> "dscout"
#   "⚪ dscout-finance"     -> "dscout-finance"
#   "devops-2081-foo"       -> "devops-2081-foo"
# Strips a leading status emoji + space (if present) and a trailing
# " (branch)" suffix (if present).
gt_title_leaf() {
  local title="$1"
  # Drop a leading non-space "emoji" token followed by a space, but only when
  # what remains still has content. Status emojis are 🔵🟡🟢⚪🔴; matching the
  # generic "first token is followed by more tokens and isn't itself the dir"
  # is fragile, so key off the known emoji set.
  case "$title" in
    "🔵 "*|"🟡 "*|"🟢 "*|"⚪ "*|"🔴 "*) title="${title#* }" ;;
  esac
  # Drop a trailing " (branch)" suffix.
  title="${title% (*)}"
  printf '%s\n' "$title"
}

# Keep "id<TAB>tab title<TAB>window name" rows, dropping blanks. Kept as a seam so fzf input is defined in one place.
# `|| true`: grep exits 1 when nothing matches (all-blank/empty input). That
# empty case is expected and handled by the caller's `[[ -z "$dump" ]]` check,
# so it must not propagate as a pipeline failure under set -e/pipefail.
gt_parse_menu() {
  grep -v '^[[:space:]]*$' || true
}

# Print a preview for a title: the resolved worktree path plus a short git
# status, or a graceful fallback if the dir does not resolve under DEV_ROOT.
gt_preview() {
  local title="$1" leaf path
  leaf="$(gt_title_leaf "$title")"
  path="$DEV_ROOT/$leaf"

  printf '%s\n' "$title"
  if [[ -d "$path" ]]; then
    printf '%s\n\n' "$path"
    # `|| true` on these pipes: `head` closes the pipe early, giving the
    # upstream command SIGPIPE (exit 141), which pipefail would turn into a
    # non-zero return and blank the preview pane for large repos.
    if git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
      git -C "$path" -c color.status=always status --short --branch 2>/dev/null | head -40 || true
    else
      ls -A "$path" 2>/dev/null | head -40 || true
    fi
  else
    printf '(no worktree at %s)\n' "$path"
  fi
}

# ── AppleScript integration ───────────────────────────────────────────────────

gt_dump_tabs() {
  osascript <<'APPLESCRIPT'
tell application id "com.mitchellh.ghostty"
  set out to ""
  repeat with w in windows
    repeat with t in tabs of w
      set out to out & (id of t) & (ASCII character 9) & (name of t) & (ASCII character 9) & (name of w) & linefeed
    end repeat
  end repeat
  return out
end tell
APPLESCRIPT
}

gt_select_tab() {
  osascript - "$1" <<'APPLESCRIPT'
on run argv
  set tabID to item 1 of argv
  tell application id "com.mitchellh.ghostty"
    repeat with w in windows
      repeat with t in tabs of w
        if (id of t) is tabID then
          select tab t
          activate
          return
        end if
      end repeat
    end repeat
    error "gt: selected tab is no longer available"
  end tell
end run
APPLESCRIPT
}

# ── main ──────────────────────────────────────────────────────────────────────

gt_main() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "gt: fzf not found" >&2
    return 1
  fi

  local dump
  dump="$(gt_dump_tabs | gt_parse_menu)" || return $?
  if [[ -z "$dump" ]]; then
    echo "gt: no Ghostty tabs/windows found (is Ghostty running?)" >&2
    return 1
  fi

  # fzf hides the stable ID in field 1.
  local selected rc
  selected="$(
    printf '%s\n' "$dump" | fzf \
      --height=40% --reverse \
      --with-nth=2.. --delimiter='\t' \
      --preview "'$0' --preview {2}" --preview-window=right,50%,wrap
  )" || {
    rc=$?
    # 130 = user aborted (Esc/Ctrl-C), 1 = no match: both clean exits.
    # Anything else is a real fzf failure worth surfacing.
    [[ "$rc" -eq 130 || "$rc" -eq 1 ]] && return 0
    return "$rc"
  }

  [[ -z "$selected" ]] && return 0

  gt_select_tab "${selected%%$'\t'*}"
}

# Sourced (by bats) → expose functions only. Executed → run main, or serve a
# preview request for fzf's --preview callback.
if [[ "${BASH_SOURCE[0]:-}" == "${0}" ]]; then
  if [[ "${1:-}" == "--preview" ]]; then
    shift
    gt_preview "$*"
  else
    gt_main "$@"
  fi
fi
