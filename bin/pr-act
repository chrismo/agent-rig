#!/usr/bin/env bash5
#
# pr-act - verbs that change a branch's PR.
#
# Usage:
#   pr-act enroll   [<branch>]
#   pr-act unenroll [<branch>]
#   pr-act address  [--force] [--no-publish] [--harness <h>] [<branch>]
#   pr-act ack      [--id <id>]... [<branch>]
#   pr-act restack  [--force] [<branch>]
#   pr-act push     [--force] [<branch>]
#
# Examples:
#   pr-act enroll                      pr-watch starts tracking this branch
#   pr-act address --no-publish        the agent fixes locally; nothing pushed or posted
#   pr-act address --harness pi
#   pr-act ack                         after reading pr-state --long: the i items are done
#   pr-act restack && pr-act push      catch up with the parent, then publish
#
# Verbs:
#   enroll    mark the branch for pr-watch, and register this repo
#   unenroll  clear the mark
#   address   hand owed bot feedback to an agent, then commit, verify, push,
#             reply and resolve; items the agent marks "ask" are left for chrismo
#   ack       mark owed bot review bodies and comments read, with no reply:
#             every i item, or only the --id ones (ids from pr-state --json)
#   restack   rebase --onto the parent (the default branch once the parent
#             merged), check the branch's own change came through unchanged,
#             else roll back; never pushes
#   push      publish: a plain push for new commits; rewritten history is
#             force-pushed with a lease, only over a remote head of our own.
#             Never over commits that aren't yours, --force or not
#
# --force:
#   address         run even if the branch is unpushed, diverged or taken over
#   restack, push   run even if taken over
#
# address options:
#   --no-publish    stop after the local commit (the agent still runs: tokens)
#   --harness <h>   claude (default) or pi; remembered for the branch
#
# Config (pr-config show):
#   settings  remote, verify, stepTimeout, replyPrefix, botLogin
#   harness   model, effort, provider (pi), args
#
# State (git config): branch.<b>.pr-tend, .pr-session, .pr-harness, .pr-handled;
# pr-tend.repo (global) lists the enrolled repos.
#
# <branch> defaults to the current one. See docs/pr-workflow/design.md, "Act".

set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/pr-tend.sh"
source "$(dirname "$(realpath "$0")")/../lib/pr-config.sh"

die() { echo "pr-act: $*" >&2; exit 1; }
help() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }
usage() { help >&2; exit 1; }

(( $# )) || usage
verb=$1; shift
if [[ $verb == -h || $verb == --help ]]; then help; exit 0; fi

force=false no_publish=false harness_opt="" branch=""
ids=()
while (( $# )); do
  case $1 in
    --force) force=true ;;
    --no-publish) no_publish=true ;;
    --harness) (( $# > 1 )) || die "--harness needs a value"; harness_opt=$2; shift ;;
    --id) (( $# > 1 )) || die "--id needs a value"; ids+=("$2"); shift ;;
    -*) die "unknown option: $1" ;;
    *) branch=$1 ;;
  esac
  shift
done

prc_super_init || exit 1
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
branch=${branch:-$(git branch --show-current)}
[[ -n $branch ]] || die "detached HEAD; name a branch"

# ── address ──────────────────────────────────────────────────────────────────

# Hard refusals (no PR, closed, GitHub unreadable) can't be forced; soft ones
# can; warnings never block.
read -r -d '' GATE <<'EOF' || true
[ if .pr == null then {hard: "no PR for \(.branch)"}
  elif .pr.state != "OPEN" then {hard: "PR #\(.pr.number) is \(.pr.state | ascii_downcase)"}
  elif .threads.owed_bot == null then {hard: "can't read the PR from GitHub: \(.errors // [] | join("; "))"}
  else empty end,
  if .session.locked then {soft: "taken over (branch.\(.branch).pr-lock is set)"} else empty end,
  if .sync.conflict then {soft: "restack due, and it would conflict"}
  elif .sync.up_to_date == null then {soft: "sync with \(.sync.target // "the parent") unknown"}
  else empty end,
  if .push.remote_sha == null then {soft: "not pushed"}
  elif .push.diverged then {soft: "diverged from the remote branch"}
  elif .push.behind > 0 then {soft: "the remote branch has \(.push.behind) commit(s) you don't"}
  elif .push.ahead > 0 then {soft: "\(.push.ahead) unpushed commit(s)"}
  else empty end,
  if .sync.up_to_date == false and (.sync.conflict | not) then {warn: "behind \(.sync.target) by \(.sync.behind)"} else empty end,
  if .ci.verdict == "pending" then {warn: "CI is still running"} else empty end ]
EOF

read -r -d '' NODES_Q <<'EOF' || true
query($ids: [ID!]!) {
  viewer { login }
  nodes(ids: $ids) {
    __typename
    ... on PullRequestReviewThread { id path line isOutdated
      comments(first: 50) { nodes { author { __typename login } body } } }
    ... on PullRequestReview { id url author { __typename login } body }
    ... on IssueComment { id url author { __typename login } body }
  }
}
EOF

read -r -d '' SCHEMA <<'EOF' || true
{"type": "object", "required": ["outcome", "commit_message", "summary", "items"],
 "properties": {
   "outcome": {"enum": ["done", "needs-input", "gave-up"]},
   "commit_message": {"type": ["string", "null"]},
   "summary": {"type": "string"},
   "items": {"type": "array", "items": {"type": "object", "required": ["id", "action", "reply"],
     "properties": {"id": {"type": "string"},
                    "action": {"enum": ["fixed", "reply", "pushback", "ask"]},
                    "reply": {"type": "string"}}}}}}
EOF

read -r -d '' PROMPT <<'EOF' || true
You are addressing automated code-review feedback on a pull request. The
working tree is the PR branch, checked out and clean.

For each finding below, pick exactly one action:
- fixed:    you changed code to address it
- reply:    no change needed (already handled, or a question you can answer)
- pushback: you disagree; say why
- ask:      it needs a decision from the PR's author; say what the question is

Make fixes by editing files. Keep edits to what the findings ask for. Do not
commit, push, or run gh: the pipeline commits your edits, runs checks, pushes,
and posts each `reply` on the PR as written, so keep replies short and
specific. Return one item per finding id, a one-line commit_message if you
changed anything (else null), and outcome "done", "needs-input" (anything you
marked ask) or "gave-up" (you couldn't make sense of it; nothing is posted).
EOF

# soft_gate <gate-json> <doing>: unless --force, list the soft refusals and exit.
soft_gate() {
  if $force || [[ $(jq '[.[] | .soft // empty] | length' <<<"$1") -eq 0 ]]; then return 0; fi
  { echo "pr-act: not $2:"
    jq -r '.[] | .soft // empty | "  - \(.)"' <<<"$1"
    echo "(--force to run anyway)"; } >&2
  exit 1
}

worktree_for() { # the worktree that has refs/heads/<branch> checked out
  git worktree list --porcelain \
    | awk -v ref="refs/heads/$1" '/^worktree / { wt = substr($0, 10) } $0 == "branch " ref { print wt; exit }'
}

gql() { gh api graphql "$@"; }

where() { jq -r 'if .type == "thread" then "\(.path):\(.line)" elif .type == "review" then "review body" else "PR comment" end' <<<"$1"; }

report() { # report <plan> <summary>
  local item
  echo "$branch: $2"
  while IFS= read -r item; do
    printf '  %-9s %-20s %s\n' "$(jq -r .action <<<"$item")" "$(where "$item")" "$(jq -r .reply <<<"$item")"
  done < <(jq -c '.[] | select(.action != "ask")' <<<"$1")
  if [[ $(jq '[.[] | select(.action == "ask")] | length' <<<"$1") -gt 0 ]]; then
    echo "needs chrismo:"
    while IFS= read -r item; do
      printf '  %-20s %s\n' "$(where "$item")" "$(jq -r .reply <<<"$item")"
    done < <(jq -c '.[] | select(.action == "ask")' <<<"$1")
  fi
}

address() {
  local b=$branch wt remote state gate line owed nodes findings bots
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  remote=$(prc_get settings.remote "$b" false) || die "pr-config failed"
  git -C "$wt" fetch --quiet "$remote" || die "fetch from $remote failed"
  state=$(cd "$wt" && pr-state --json "$b") || die "pr-state failed"

  gate=$(jq -c "$GATE" <<<"$state")
  line=$(jq -r '.[] | .hard // empty' <<<"$gate" | head -1)
  [[ -z $line ]] || die "$line"
  owed=$(jq -c '[.threads.items[] | select(.kind == "bot")]' <<<"$state")
  if [[ $owed == '[]' ]]; then
    echo "nothing to address on $b ($(jq -r '.threads.owed_human // 0' <<<"$state") human item(s) are chrismo's)"
    return
  fi
  soft_gate "$gate" "addressing $b"
  jq -r '.[] | .warn // empty | "pr-act: warning: \(.)"' <<<"$gate" >&2

  local -a id_args=()
  (( $(jq length <<<"$owed") <= 100 )) || echo "pr-act: warning: over 100 owed items; taking the first 100" >&2
  while IFS= read -r line; do id_args+=(-f "ids[]=$line"); done < <(jq -r '.[:100][].id' <<<"$owed")
  nodes=$(gql -f query="$NODES_Q" "${id_args[@]}") || die "couldn't fetch the findings' text"
  # Anyone else in a thread is untrusted: their text would steer edits that
  # verify runs and the push publishes.
  bots=$(prc_get settings.botLogin "$b" false json) || die "pr-config failed"
  findings=$(jq -c --argjson bots "$bots" '
    def unbot: sub("\\[bot\\]$"; "");
    .data.viewer.login as $me
    | [.data.nodes[] | select(. != null)
       | {id, type: {PullRequestReviewThread: "thread", PullRequestReview: "review", IssueComment: "comment"}[.__typename],
          url, path, line, outdated: .isOutdated,
          conversation: [(.comments.nodes[]? // .) | {author: .author.login, bot: (.author.__typename == "Bot"), body}]}
       | .untrusted = ([.conversation[] | select((.bot or .author == $me or (.author | unbot | IN($bots[] | unbot))) | not)
                        | .author] | unique)
       | .conversation |= map(del(.bot))]' <<<"$nodes")
  [[ $findings != '[]' ]] || die "none of the owed items could be fetched"
  local held
  held=$(jq -c '[.[] | select(.untrusted != [])
    | del(.untrusted) + {action: "ask", reply: "joined by \(.untrusted | join(", ")): yours to answer"}]' <<<"$findings")
  findings=$(jq -c '[.[] | select(.untrusted == []) | del(.untrusted)]' <<<"$findings")
  if [[ $findings == '[]' ]]; then
    report "$held" "no bot feedback the agent can take"
    return
  fi

  local stored_h sid h mode result outcome plan timeout cfg forced verify
  stored_h=$(git config --get "branch.$b.pr-harness" || true)
  sid=$(git config --get "branch.$b.pr-session" || true)
  forced=${harness_opt:-$stored_h}
  cfg=$(prc_step address "$b" "$forced") || die "pr-config failed"
  h=$(jq -r .harness <<<"$cfg")
  if [[ -n $sid ]]; then
    [[ $h == "${stored_h:-claude}" ]] \
      || die "branch.$b.pr-session belongs to ${stored_h:-claude}; unset it to start a $h session"
    mode=resume
  else
    sid=$(uuidgen | tr 'A-F' 'a-f') mode=new
  fi
  timeout=$(prc_get settings.stepTimeout "$b" false) || die "pr-config failed"
  [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"
  verify=$(cd "$wt" && prc_get settings.verify "$b" false) || die "pr-config failed"
  [[ $verify != *$'\n'* ]] || die "verify must be a single command, not a list"
  echo "pr-act: $h ($mode session $sid) is addressing $(jq length <<<"$findings") item(s) on $b…" >&2
  result=$(cd "$wt" && harness_run "$h" "$sid" "$mode" "$timeout" \
             "$PROMPT"$'\n\nPR '"$(jq -r '.pr.url' <<<"$state")"$'\nFindings:\n'"$(jq . <<<"$findings")" "$SCHEMA" "$cfg") \
    || die "the $h step failed or returned no usable result (session $sid)"
  git config "branch.$b.pr-session" "$sid"
  git config "branch.$b.pr-harness" "$h"

  # pi has no schema enforcement, so check the shape here too.
  outcome=$(jq -r .outcome <<<"$result")
  case $outcome in
    done|needs-input) ;;
    gave-up) die "the agent gave up: $(jq -r .summary <<<"$result"). Any edits are left uncommitted in $wt" ;;
    *) die "the agent returned outcome \"$outcome\"; edits (if any) are left uncommitted in $wt" ;;
  esac
  local changed=false
  [[ -n $(git -C "$wt" status --porcelain) ]] && changed=true
  plan=$(jq -c --argjson r "$result" --argjson changed "$changed" --argjson held "$held" '
    [.[] | . as $f | ([$r.items[]? | select(.id == $f.id)][0] // {}) as $a
     | $f + if ($a.action | IN("fixed", "reply", "pushback", "ask") | not) then {action: "ask", reply: "(the agent did not answer this one)"}
            elif ($a.reply | type) != "string" or ($a.reply | test("\\S") | not) then {action: "ask", reply: "(the agent gave no reply text)"}
            elif $a.action == "fixed" and ($changed | not) then {action: "ask", reply: "(said fixed but changed nothing): \($a.reply)"}
            else {action: $a.action, reply: $a.reply} end] + $held' <<<"$findings")

  local msg
  if $changed; then
    msg=$(jq -r '(.commit_message // "") | if test("\\S") then . else "Address review feedback" end' <<<"$result")
    git -C "$wt" add -A && git -C "$wt" commit -q -m "$msg" || die "commit failed; the edits are left in $wt"
  fi
  if [[ -n $verify ]]; then
    (cd "$wt" && sh -c "$verify") || die "verify failed ($verify); the commit is kept in $wt, nothing pushed or posted"
    [[ -z $(git -C "$wt" status --porcelain) ]] \
      || die "verify changed files in $wt (a formatter?); commit them and rerun. Nothing pushed or posted"
  fi

  report "$plan" "$(jq -r .summary <<<"$result")"
  if $no_publish; then
    echo "not published: nothing pushed or posted"
    return
  fi

  push_branch "$b" "$remote" || die "not pushed, so nothing posted"
  local prefix id failed=0 pr_id body=""
  prefix=$(prc_get settings.replyPrefix "$b" false) || die "pr-config failed"
  while IFS= read -r item; do
    id=$(jq -r .id <<<"$item")
    gql -f query='mutation($thread: ID!, $body: String!) {
          addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $thread, body: $body}) { comment { id } } }' \
        -f thread="$id" -f body="$prefix$(jq -r .reply <<<"$item")" >/dev/null \
      || { echo "pr-act: replying to $(where "$item") failed" >&2; failed=1; continue; }
    if [[ $(jq -r .action <<<"$item") != pushback ]]; then
      gql -f query='mutation($thread: ID!) { resolveReviewThread(input: {threadId: $thread}) { thread { id } } }' \
          -f thread="$id" >/dev/null \
        || { echo "pr-act: resolving $(where "$item") failed" >&2; failed=1; }
    fi
  done < <(jq -c '.[] | select(.type == "thread" and .action != "ask")' <<<"$plan")

  # Review bodies and PR comments can't be replied to or resolved: answer them
  # in one PR comment and remember them in branch.<b>.pr-handled. Link, don't
  # quote: quoted text can carry what other bots act on (/commands, @mentions).
  body=$(jq -r --arg p "$prefix" '[.[] | select(.type != "thread" and .action != "ask")]
    | if length == 0 then empty else
        "\($p)Addressed review feedback:\n\n" + (map("[\(if .type == "review" then "Review" else "Comment" end)](\(.url))\n\n\(.reply)") | join("\n\n"))
      end' <<<"$plan")
  if [[ -n $body ]]; then
    # By URL, not {owner}/{repo}: gh's default repo may be a fork.
    if pr_id=$(gql -f url="$(jq -r .pr.url <<<"$state")" \
                 -f query='query($url: URI!) { resource(url: $url) { ... on PullRequest { id } } }' \
                 --jq .data.resource.id) \
       && gql -f query='mutation($subject: ID!, $body: String!) { addComment(input: {subjectId: $subject, body: $body}) { clientMutationId } }' \
              -f subject="$pr_id" -f body="$body" >/dev/null; then
      while IFS= read -r id; do git config --add "branch.$b.pr-handled" "$id"; done \
        < <(jq -r '.[] | select(.type != "thread" and .action != "ask") | .id' <<<"$plan")
    else
      echo "pr-act: posting the PR comment failed" >&2; failed=1
    fi
  fi
  return "$failed"
}

# ── push ─────────────────────────────────────────────────────────────────────

plural() { if (( $1 == 1 )); then echo "1 $2"; else echo "$1 $2s"; fi; }

# push_branch <branch> <remote>: publish <branch> as fetched just now. Rewritten
# history is force-pushed with a lease on that remote head, and only when the
# head is in the branch's reflog (we put it there). Never over others' commits.
push_branch() {
  local b=$1 remote=$2 rsha ahead behind n reflog theirs
  git fetch --quiet --prune "$remote" || { echo "pr-act: fetch from $remote failed" >&2; return 1; }
  rsha=$(git rev-parse -q --verify "refs/remotes/$remote/$b^{commit}" || true)
  if [[ -z $rsha ]]; then
    push_ref "$b" "$remote" "" -u || return
    echo "pushed $b to $remote (new branch)"
    return
  fi
  ahead=$(git rev-list --count "$rsha..refs/heads/$b")
  behind=$(git rev-list --count "refs/heads/$b..$rsha")
  if (( ahead == 0 && behind == 0 )); then
    echo "nothing to push on $b"
  elif (( ahead == 0 )); then
    echo "pr-act: $remote/$b has $(plural "$behind" commit) you don't; take them with: git merge --ff-only $remote/$b" >&2
    return 1
  elif (( behind == 0 )); then
    push_ref "$b" "$remote" "$rsha" || return
    echo "pushed $b to $remote ($(plural "$ahead" commit))"
  else
    # Not piped into grep -q: under pipefail, git dying of SIGPIPE would read as "not ours".
    reflog=$(git reflog show --format=%H "refs/heads/$b")
    if ! grep -qx "$rsha" <<<"$reflog"; then
      theirs=$(sed 's/^/^/' <<<"$reflog" | git rev-list --count --stdin "$rsha")
      if (( theirs == 1 )); then n="1 commit that isn't"; else n="$theirs commits that aren't"; fi
      echo "pr-act: $remote/$b has $n yours; not pushing over it." \
           "Look: git log $b..$remote/$b, then bring it into $b" >&2
      return 1
    fi
    push_ref "$b" "$remote" "$rsha" --force-with-lease="refs/heads/$b:$rsha" || return
    echo "force-pushed $b to $remote (rewritten; the remote head ${rsha:0:7} was ours)"
  fi
}

# push_ref <branch> <remote> <expected-remote-sha> [push options...]
push_ref() {
  local b=$1 remote=$2 expected=$3 err now
  shift 3
  if ! err=$(git push --quiet "$@" "$remote" "refs/heads/$b:refs/heads/$b" 2>&1); then
    now=$(git ls-remote "$remote" "refs/heads/$b" 2>/dev/null | cut -f1)
    if [[ $now != "$expected" ]]; then
      echo "pr-act: $remote/$b moved while pushing; nothing pushed. Run it again to see what changed" >&2
    else
      echo "pr-act: push to $remote failed: ${err//$'\n'/ }" >&2
    fi
    return 1
  fi
}

push() {
  local remote
  git rev-parse -q --verify "refs/heads/$branch" >/dev/null || die "no such branch: $branch"
  if ! $force && [[ -n $(git config --get "branch.$branch.pr-lock" || true) ]]; then
    die "not pushing $branch: taken over (branch.$branch.pr-lock is set; --force to push anyway)"
  fi
  remote=$(prc_get settings.remote "$branch" false) || die "pr-config failed"
  push_branch "$branch" "$remote" || exit 1
}

# ── restack ──────────────────────────────────────────────────────────────────

# -U0: an upstream edit next to the branch's lines must not read as a change.
patch_id() { git diff -U0 "$1" "$2" | git patch-id --stable | cut -d' ' -f1; }

read -r -d '' RESTACK_GATE <<'EOF' || true
(.errors // [] | join("; ")) as $why
| "\($remote)/\(.sync.target)" as $onto
| [ if .parent.merged == null and .parent.name != .sync.default
      then {hard: "can't tell whether \(.parent.name) merged: \($why)"} else empty end,
    if .sync.up_to_date == null or (.sync.up_to_date == false and .sync.old_base == null)
      then {hard: "can't restack \(.branch): \($why)"}
    elif .sync.up_to_date then {done: "\(.branch) is already on \($onto)"}
    elif .sync.conflict == null then {hard: "can't tell whether restacking \(.branch) would conflict: \($why)"}
    elif .sync.conflict
      then {hard: "restacking \(.branch) onto \($onto) would conflict; resolve it by hand: git rebase --onto \($onto) \(.sync.old_base[0:12])"}
    else empty end,
    if .session.locked then {soft: "taken over (branch.\(.branch).pr-lock is set)"} else empty end ]
EOF

restack() {
  local b=$branch wt remote state gate line target new_base old_base old_head new_head before
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  remote=$(prc_get settings.remote "$b" false) || die "pr-config failed"
  git -C "$wt" fetch --quiet --prune "$remote" || die "fetch from $remote failed"
  state=$(cd "$wt" && pr-state --json "$b") || die "pr-state failed"

  gate=$(jq -c --arg remote "$remote" "$RESTACK_GATE" <<<"$state")
  line=$(jq -r '.[] | .hard // empty' <<<"$gate" | head -1)
  [[ -z $line ]] || die "$line"
  line=$(jq -r '.[] | .done // empty' <<<"$gate")
  if [[ -n $line ]]; then echo "$line"; return; fi
  soft_gate "$gate" "restacking $b"

  target=$(jq -r .sync.target <<<"$state")
  old_base=$(jq -r .sync.old_base <<<"$state")
  new_base=$(git rev-parse "refs/remotes/$remote/$target^{commit}")
  old_head=$(git rev-parse "refs/heads/$b")
  before=$(patch_id "$old_base" "$old_head")
  if ! git -C "$wt" rebase --quiet --onto "$new_base" "$old_base" "$b" >/dev/null 2>&1; then
    git -C "$wt" rebase --abort 2>/dev/null || true
    [[ $(git rev-parse "refs/heads/$b") == "$old_head" ]] || git -C "$wt" reset --quiet --hard "$old_head"
    die "the rebase onto $remote/$target stopped on a conflict partway through; rolled back to ${old_head:0:7}." \
        "Resolve it by hand: git rebase --onto $remote/$target ${old_base:0:12}"
  fi
  new_head=$(git rev-parse "refs/heads/$b")
  if [[ $(patch_id "$new_base" "$new_head") != "$before" ]]; then
    git -C "$wt" reset --quiet --hard "$old_head"
    die "$b's change came out different on $remote/$target (part of it may be there already); rolled back to ${old_head:0:7}." \
        "Compare: git range-diff ${old_base:0:12}..${old_head:0:12} ${new_base:0:12}..${new_head:0:12}"
  fi
  git update-ref -m "pr-act restack" "refs/pr-tend/$b/base" "$new_base"
  echo "restacked $b onto $remote/$target ($(plural "$(git rev-list --count "$new_base..$new_head")" commit)); not pushed: pr-act push"
}

# ── ack ──────────────────────────────────────────────────────────────────────

# One line per picked item: id|why it can't be acked (empty if it can)|what it is.
read -r -d '' ACK_Q <<'EOF' || true
unnest {ids, it: s.threads.items}
| where (len(ids) == 0 and it.mark == "i") or it.id in ids
| values f"{it.id}|{it.type == "thread" ? "is a thread; resolve it on GitHub"
                    : it.kind != "bot" ? f"is a human {it.type}; reply to it" : ""}|{it.type}  {coalesce(it.author, it.last, "")}  {coalesce(it.excerpt, "")}  {coalesce(it.url, "")}"
EOF

ack() {
  local b=$branch state check out id why what ids_json="" sep=""
  local -a picked=() shown=() bad=()
  local -A found=()
  state=$(pr-state --json "$b") || die "pr-state failed"
  check=$(printf '%s\n' "$state" | prc_super -i json -f line -c \
    'values threads.owed_bot is null ? f"can'"'"'t read the PR from GitHub: {join(coalesce(errors, []), "; ")}" : "ok"' -) \
    || die "can't parse pr-state's answer"
  [[ $check == ok ]] || die "$check"
  for id in "${ids[@]}"; do ids_json+=$sep$(prc_json_string "$id") || exit 1; sep=,; done
  out=$(printf '{"ids":[%s],"s":%s}\n' "$ids_json" "$state" | prc_super -i json -f line -c "$ACK_Q" -) \
    || die "can't parse pr-state's answer"
  while IFS='|' read -r id why what; do
    [[ -n $id ]] || continue
    found[$id]=1
    if [[ -n $why ]]; then bad+=("$id $why"); else picked+=("$id"); shown+=("$what"); fi
  done <<<"$out"
  for id in "${ids[@]}"; do [[ -n ${found[$id]:-} ]] || bad+=("$id isn't owed on $b"); done
  if (( ${#bad[@]} )); then printf 'pr-act: %s\n' "${bad[@]}" >&2; exit 1; fi
  if (( ! ${#picked[@]} )); then echo "nothing to ack on $b"; return; fi
  for id in "${picked[@]}"; do git config --add "branch.$b.pr-handled" "$id"; done
  echo "acked ${#picked[@]} on $b:"
  printf '  %s\n' "${shown[@]}"
}

case $verb in
  enroll)
    git rev-parse -q --verify "refs/heads/$branch" >/dev/null || die "no such branch: $branch"
    git config "branch.$branch.pr-tend" true
    main_worktree=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
    if ! grep -qxF "$main_worktree" <<<"$(git config --global --get-all pr-tend.repo || true)"; then
      git config --global --add pr-tend.repo "$main_worktree"
    fi
    ;;
  unenroll)
    git config --unset "branch.$branch.pr-tend" || (( $? == 5 ))  # 5: wasn't set
    ;;
  address) address ;;
  ack) ack ;;
  restack) restack ;;
  push) push ;;
  *) die "unknown verb: $verb" ;;
esac
