#!/usr/bin/env bash5
#
# pr-config - harness and settings for the PR pipeline.
#
# Usage:
#   pr-config get   [--no-branch] [--json] <path> [<branch>]
#   pr-config step  [--harness <h>] <step> [<branch>]
#   pr-config set   [--global | --branch <b>] [--json] <path> <value>
#   pr-config unset [--global | --branch <b>] <path>
#   pr-config show  [--no-branch] [<branch>]
#   pr-config files [--no-branch] [<branch>]
#   pr-config init  --global [--force]
#   pr-config init  [--force] [<branch>]
#
# Examples:
#   pr-config get settings.verify                    one value
#   pr-config step address                           what a step runs with (JSON)
#   pr-config set --global harnesses.claude.model opus
#   pr-config set --json settings.botLogin '["marge"]'
#   pr-config unset steps.address.harness            inherit it again
#   pr-config show                                   everything, merged
#   pr-config files                                  where the files are
#
# Layers (top wins):
#   branch    <main repo>/.git/pr-tend/<branch>.json, shared by all worktrees
#             (pr-config files prints the paths)
#   global    ~/.config/pr-tend/config.json ($PR_TEND_CONFIG, $XDG_CONFIG_HOME)
#   defaults  harness claude; settings.remote origin, stepTimeout 1800,
#             interval 300, replyPrefix "🤖 "; the other settings empty
#
# Notes:
#   - null in a file removes the key; a default still applies
#   - get prints strings raw, lists one per line, objects as JSON (--json: all)
#   - exit 3: no value and no default. exit 1: an error
#   - <branch> defaults to the current one; --no-branch skips the branch file
#   - set/unset write the current branch's file unless --global or --branch
#   - set values are strings; --json takes a number, list, object or null
#   - step: the harness's block, with the step's block for it laid over it
#
# See docs/pr-workflow/design.md, "Config files".

set -euo pipefail

# shellcheck source=../lib/pr-config.sh
source "$(dirname "$(realpath "$0")")/../lib/pr-config.sh"

die() { echo "pr-config: $*" >&2; exit 1; }
help() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }
usage() { help >&2; exit 1; }

# `|| exit $?` turns errexit off inside each prc_ call, as in pr-act and pr-watch.
(( $# )) || usage
verb=$1; shift
case $verb in
  -h|--help) help ;;
  get)
    nobranch=false json=
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --no-branch) nobranch=true ;;
        --json) json=json ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    (( $# )) || usage
    prc_get "$1" "${2:-}" "$nobranch" $json || exit $? ;;
  files|show)
    nobranch=false
    if [[ ${1:-} == --no-branch ]]; then nobranch=true; shift; fi
    if [[ $verb == files ]]; then
      prc_paths "${1:-}" "$nobranch" || exit $?
    else
      prc_show "${1:-}" "$nobranch" || exit $?
    fi ;;
  step)
    forced=
    if [[ ${1:-} == --harness ]]; then (( $# >= 2 )) || usage; forced=$2; shift 2; fi
    (( $# )) || usage
    prc_step "$1" "${2:-}" "$forced" || exit $? ;;
  init)
    force=false global=false
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --force) force=true ;;
        --global) global=true ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    if $global; then
      (( $# == 0 )) || usage
      prc_init_global "$force" || exit $?
    else
      branch=$(prc_branch_arg "${1:-}") || exit $?
      prc_init "$force" "$branch" || exit $?
    fi ;;
  set|unset)
    global=false json=false branch=
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --global) global=true ;;
        --branch) (( $# >= 2 )) || usage; branch=$2; shift ;;
        --json) [[ $verb == set ]] || die "unknown option: $1"; json=true ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    file=$(prc_target_file "$global" "$branch") || exit $?
    if [[ $verb == unset ]]; then
      (( $# == 1 )) || usage
      prc_unset "$file" "$1" || exit $?
    else
      (( $# == 2 )) || usage
      prc_set "$file" "$1" "$2" "$json" || exit $?
    fi ;;
  *) die "unknown verb: $verb" ;;
esac
