#!/usr/bin/env bash5
#
# pr-config - harness and settings for the PR pipeline.
#
# Usage:
#   pr-config init --global [--force]            create the global file
#   pr-config init [--force] [<branch>]          copy the global file to <branch>
#   pr-config get [--harness <h>] <step> [<branch>]
#                                                what <step> runs with, as JSON
#   pr-config setting [--no-branch] <key> [<branch>]
#                                                one setting; exit 3 when unset
#   pr-config set [--global | --branch <b>] [--json] <path> <value>
#                                                write one value
#   pr-config unset [--global | --branch <b>] <path>
#                                                remove a key so it inherits
#
# Files:
#   global  $PR_TEND_CONFIG, else ~/.config/pr-tend/config.json ($XDG_CONFIG_HOME)
#   branch  <git common dir>/pr-tend/<branch>.json, shared by all worktrees
#
# Lookup: branch file, then global file, then git config pr-tend.<key>, then
# the built-in default (remote origin, stepTimeout 1800, interval 300,
# replyPrefix "🤖 "; verify, notify and botLogin empty). null in a file skips to
# the default. <branch> defaults to the current one; --no-branch skips the
# branch file. --harness reads that harness's blocks instead of the configured
# one. A list setting prints one element per line. Exit 1 is always an error.
# set/unset write the current branch's file unless --global or --branch; <path>
# is dotted, e.g. harnesses.claude.model, steps.address.harness, settings.verify.
# Values are strings; --json takes a number, list, object or null.
# See docs/pr-workflow/design.md, "Config files".

set -euo pipefail

# shellcheck source=../lib/pr-config.sh
source "$(dirname "$(realpath "$0")")/../lib/pr-config.sh"

die() { echo "pr-config: $*" >&2; exit 1; }
help() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }
usage() { help >&2; exit 1; }

# `|| exit $?` turns errexit off inside each prc_ call, as in pr-act and pr-watch.
(( $# )) || usage
verb=$1; shift
case $verb in
  -h|--help) help ;;
  get)
    forced=
    if [[ ${1:-} == --harness ]]; then (( $# >= 2 )) || usage; forced=$2; shift 2; fi
    (( $# )) || usage
    step=$1
    branch=$(prc_branch_arg "${2:-}") || exit $?
    prc_get "$step" "$branch" "$forced" || exit $? ;;
  setting)
    nobranch=false
    if [[ ${1:-} == --no-branch ]]; then nobranch=true; shift; fi
    (( $# )) || usage
    prc_setting "$1" "${2:-}" "$nobranch" || exit $? ;;
  init)
    force=false global=false
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --force) force=true ;;
        --global) global=true ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    if $global; then
      (( $# == 0 )) || usage
      prc_init_global "$force" || exit $?
    else
      branch=$(prc_branch_arg "${1:-}") || exit $?
      prc_init "$force" "$branch" || exit $?
    fi ;;
  set|unset)
    global=false json=false branch=
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --global) global=true ;;
        --branch) (( $# >= 2 )) || usage; branch=$2; shift ;;
        --json) [[ $verb == set ]] || die "unknown option: $1"; json=true ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    file=$(prc_target_file "$global" "$branch") || exit $?
    if [[ $verb == unset ]]; then
      (( $# == 1 )) || usage
      prc_unset "$file" "$1" || exit $?
    else
      (( $# == 2 )) || usage
      prc_set "$file" "$1" "$2" "$json" || exit $?
    fi ;;
  *) die "unknown verb: $verb" ;;
esac
