#!/usr/bin/env bash5
#
# pr-config - harness and settings for the PR pipeline.
#
# Usage:
#   pr-config init --global [--force]            create the global file
#   pr-config init [--force] [<branch>]          copy the global file to <branch>
#   pr-config get [--no-branch] [--json] <path> [<branch>]
#                                                one value; exit 3 when unset
#   pr-config step [--harness <h>] <step> [<branch>]
#                                                what <step> runs with, as JSON
#   pr-config set [--global | --branch <b>] [--json] <path> <value>
#                                                write one value
#   pr-config unset [--global | --branch <b>] <path>
#                                                remove a key so it inherits
#
# Files:
#   global  $PR_TEND_CONFIG, else ~/.config/pr-tend/config.json ($XDG_CONFIG_HOME)
#   branch  <git common dir>/pr-tend/<branch>.json, shared by all worktrees
#
# The branch file is merged over the global file, and both over the built-in
# defaults (harness claude; settings remote origin, stepTimeout 1800, interval
# 300, replyPrefix "🤖 "; verify, notify, botLogin, botIgnore and botIgnoreBody
# empty). null in a file removes the key from the files; a default still
# applies. <path> is dotted, e.g. settings.verify, harnesses.claude.model,
# steps.address.harness. <branch> defaults to the current one; --no-branch
# skips the branch file. get prints a string raw, a list one element per line
# and an object as JSON; --json prints JSON for all of them. step merges the
# step's block for its harness over that harness's block; --harness picks the
# harness instead. Exit 1 is always an error. set/unset write the current
# branch's file unless --global or --branch. Values are strings; --json takes a
# number, list, object or null.
# See docs/pr-workflow/design.md, "Config files".

set -euo pipefail

# shellcheck source=../lib/pr-config.sh
source "$(dirname "$(realpath "$0")")/../lib/pr-config.sh"

die() { echo "pr-config: $*" >&2; exit 1; }
help() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }
usage() { help >&2; exit 1; }

# `|| exit $?` turns errexit off inside each prc_ call, as in pr-act and pr-watch.
(( $# )) || usage
verb=$1; shift
case $verb in
  -h|--help) help ;;
  get)
    nobranch=false json=
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --no-branch) nobranch=true ;;
        --json) json=json ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    (( $# )) || usage
    prc_get "$1" "${2:-}" "$nobranch" $json || exit $? ;;
  step)
    forced=
    if [[ ${1:-} == --harness ]]; then (( $# >= 2 )) || usage; forced=$2; shift 2; fi
    (( $# )) || usage
    prc_step "$1" "${2:-}" "$forced" || exit $? ;;
  init)
    force=false global=false
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --force) force=true ;;
        --global) global=true ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    if $global; then
      (( $# == 0 )) || usage
      prc_init_global "$force" || exit $?
    else
      branch=$(prc_branch_arg "${1:-}") || exit $?
      prc_init "$force" "$branch" || exit $?
    fi ;;
  set|unset)
    global=false json=false branch=
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --global) global=true ;;
        --branch) (( $# >= 2 )) || usage; branch=$2; shift ;;
        --json) [[ $verb == set ]] || die "unknown option: $1"; json=true ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    file=$(prc_target_file "$global" "$branch") || exit $?
    if [[ $verb == unset ]]; then
      (( $# == 1 )) || usage
      prc_unset "$file" "$1" || exit $?
    else
      (( $# == 2 )) || usage
      prc_set "$file" "$1" "$2" "$json" || exit $?
    fi ;;
  *) die "unknown verb: $verb" ;;
esac
