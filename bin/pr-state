#!/usr/bin/env bash5
#
# pr-state - where a branch's PR stands.
#
# Usage: pr-state [--json | --long] [<branch>]
#
# Reports, for <branch> (default: the current one):
#   pr        the branch's PR (an open one wins over closed/merged)
#   parent    pr-parent config, else the PR base, else the default branch;
#             a merged parent retargets sync to the default branch
#   sync      behind the parent? would `rebase --onto` conflict?
#   push      local vs remote branch; whether the remote SHA is ours (reflog)
#   ci        checks on the PR head commit
#   review    coverage of HEAD by refs/pr-tend/<branch>/{local,bot,accepted}
#   threads   what's owed, marked ! (blocks: unresolved threads, reviews
#             requesting changes) or i (to read: bot review bodies and PR
#             comments not yet marked handled)
#   session   pipeline enrollment, harness, session id, takeover lock
#   fresh     false when GitHub's PR / parent-PR head differs from the local
#             remote-tracking ref, i.e. sync and push answers need a fetch
#   stored    what pr-tend keeps for the branch: handled ids, refs/pr-tend/<b>/*
#   next      what to do, in order: {key, who, say, cmd} (lib/pr-next.sh)
#
# Output:
#   default   the one-liner, then NEXT: the first step and how many follow
#   --long    the one-liner, every step, then a line per owed item
#             (mark, type, author, excerpt, url)
#   --json    everything
#
# Read-only: never fetches or writes. Remote refs are as fresh as the last
# fetch. One gh GraphQL call, two for a non-default parent. A gh failure is
# recorded in .errors and the git facts are still reported.
#
# Config: read with lib/pr-config.sh (branch file over global file over
# built-in defaults), under settings: remote (origin), botLogin (bots that
# post as users, counted as bots; a [bot] suffix is optional), botIgnore (bots
# whose posts are never owed, e.g. github-actions preview links), botIgnoreBody
# (regexes: bot reviews and PR comments whose body matches are never owed).
# State: branch.<name>.pr-{parent,tend,harness,session,lock}, branch.<name>.pr-handled
# (multi-valued: node ids of bot reviews/comments already dealt with).

set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/pr-config.sh"
source "$(dirname "$(realpath "$0")")/../lib/pr-next.sh"

read -r -d '' QUERY <<'EOF' || true
query($owner: String!, $repo: String!, $branch: String!) {
  viewer { login }
  repository(owner: $owner, name: $repo) {
    defaultBranchRef { name }
    pullRequests(headRefName: $branch, first: 10, orderBy: {field: CREATED_AT, direction: DESC}) {
      nodes {
        number url state isDraft isCrossRepository headRepositoryOwner { login } baseRefName headRefOid mergeable mergedAt
        commits(last: 1) { nodes { commit { oid statusCheckRollup { state contexts(first: 100) { nodes {
          __typename
          ... on CheckRun { name status conclusion }
          ... on StatusContext { context state }
        } } } } } }
        reviewThreads(first: 100) { nodes {
          id isResolved isOutdated path line
          first: comments(first: 1) { nodes { author { __typename login } url body } }
          last: comments(last: 1) { nodes { author { __typename login } } }
        } }
        reviews(last: 50) { nodes { id url state body author { __typename login } } }
        comments(last: 50) { nodes { id url body author { __typename login } } }
      }
    }
  }
}
EOF

die() { echo "pr-state: $*" >&2; exit 1; }

json=false long=false
branch=""
while (( $# )); do
  case $1 in
    --json) json=true ;;
    --long) long=true ;;
    -h|--help) sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) branch=$1 ;;
  esac
  shift
done

! $json || ! $long || die "--json and --long don't combine"
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
[[ -n $branch ]] || branch=$(git branch --show-current)
[[ -n $branch ]] || die "detached HEAD; name a branch"
head=$(git rev-parse -q --verify "refs/heads/$branch^{commit}") || die "no such branch: $branch"
remote=$(prc_get settings.remote "$branch" false) || die "pr-config failed"

errors=()
cfg() { git config --get "branch.$branch.$1" || true; }
ref() { git rev-parse -q --verify "$1^{commit}" || true; }
is_ancestor() { git merge-base --is-ancestor "$1" "$2" 2>/dev/null; }
count() { git rev-list --count "$@"; }
# -U0: an upstream edit next to our lines must not read as a changed patch.
patch_id() { git diff -U0 "$1" "$2" | git patch-id --stable | cut -d' ' -f1; }
jnull() { if [[ -n $1 ]]; then jq -n --arg v "$1" '$v'; else echo null; fi; }
jlist() { { git config --get-all "$1" || true; } | jq -R . | jq -sc .; }
bots=$(prc_get settings.botLogin "$branch" false json) || die "pr-config failed"
ignore=$(prc_get settings.botIgnore "$branch" false json) || die "pr-config failed"
ignore_body=$(prc_get settings.botIgnoreBody "$branch" false json) || die "pr-config failed"
jq -n --argjson r "$ignore_body" '$r[] as $re | "" | test($re)' >/dev/null 2>&1 \
  || die "botIgnoreBody has an invalid regex: $ignore_body"

# -f, not -F, for the branch: -F would send "1234" or "true" as a non-string.
RESP=""
GH_ERR=$(mktemp)
trap 'rm -f "$GH_ERR"' EXIT
gh_query() {
  if ! RESP=$(gh api graphql -F owner='{owner}' -F repo='{repo}' -f branch="$1" -f query="$QUERY" 2>"$GH_ERR"); then
    errors+=("gh ($1): $(tr '\n' ' ' <"$GH_ERR")")
    RESP=""
    return 1
  fi
}
# headRefName also matches strangers' fork PRs from a same-named branch; keep
# same-repo PRs and PRs from the viewer's own fork.
pick_pr() {
  jq '.data.viewer.login as $me
      | (.data.repository.pullRequests.nodes // [])
      | map(select((.isCrossRepository | not) or .headRepositoryOwner.login == $me))
      | (map(select(.state == "OPEN"))[0] // .[0] // null)' <<<"$RESP"
}

# ── O1 PR, O2 parent ─────────────────────────────────────────────────────────

pr=null viewer="" default_branch="" gh_ok=false
if gh_query "$branch"; then
  gh_ok=true
  pr=$(pick_pr)
  viewer=$(jq -r '.data.viewer.login // empty' <<<"$RESP")
  default_branch=$(jq -r '.data.repository.defaultBranchRef.name // empty' <<<"$RESP")
fi
if [[ -z $default_branch ]]; then
  default_branch=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)
  default_branch=${default_branch#"$remote"/}
  [[ -n $default_branch ]] || default_branch=main
fi

parent=$(cfg pr-parent) parent_source=config
if [[ -z $parent ]]; then
  if [[ $pr != null ]]; then
    parent=$(jq -r .baseRefName <<<"$pr") parent_source=pr
  else
    parent=$default_branch parent_source=default
  fi
fi

# parent_ok: whether the parent and its merged state are actually known.
parent_pr=null parent_ok=$gh_ok
[[ $parent_source == config ]] && parent_ok=true
if [[ $parent != "$default_branch" ]]; then
  if gh_query "$parent"; then parent_pr=$(pick_pr); else parent_ok=false; fi
fi
parent_merged=null
if $parent_ok; then
  parent_merged=$(jq -r 'if . == null then false else .state == "MERGED" end' <<<"$parent_pr")
fi
target=$parent
[[ $parent_merged == true ]] && target=$default_branch

# ── O3 sync vs parent ────────────────────────────────────────────────────────

target_ref=$(ref "refs/remotes/$remote/$target")
behind=null up_to_date=null old_base="" conflict=null
if [[ -z $target_ref ]]; then
  errors+=("no $remote/$target ref (not fetched?)")
else
  behind=$(count "$head..$target_ref")
  base_pin=$(ref "refs/pr-tend/$branch/base")
  merged_head=$(jq -r '.headRefOid // empty' <<<"$parent_pr")
  if [[ -n $base_pin ]] && is_ancestor "$base_pin" "$head"; then
    old_base=$base_pin
  elif [[ $parent_merged == true && -n $merged_head ]] && is_ancestor "$merged_head" "$head"; then
    old_base=$merged_head
  elif [[ -n $(ref "refs/remotes/$remote/$parent") ]] \
       && old_base=$(git merge-base --fork-point "refs/remotes/$remote/$parent" "$head" 2>/dev/null); then
    :
  else
    old_base=$(git merge-base "$target_ref" "$head" || true)
  fi

  if is_ancestor "$target_ref" "$head"; then
    up_to_date=true conflict=false
  elif [[ -z $old_base ]]; then
    up_to_date=false
    errors+=("no merge base with $remote/$target")
  else
    up_to_date=false
    rc=0
    mt_err=$(git merge-tree --write-tree --merge-base="$old_base" "$target_ref" "$head" 2>&1 >/dev/null) || rc=$?
    case $rc in
      0) conflict=false ;;
      1) conflict=true ;;
      *) errors+=("merge-tree failed ($rc): ${mt_err%%$'\n'*}") ;;
    esac
  fi
fi

# ── O4 local vs remote ───────────────────────────────────────────────────────

remote_sha=$(ref "refs/remotes/$remote/$branch")
remote_ours=null diverged=false push_behind=0
if [[ -z $remote_sha ]]; then
  ahead=$(count "$head" --not --remotes="$remote")
else
  ahead=$(count "$remote_sha..$head")
  push_behind=$(count "$head..$remote_sha")
  (( ahead > 0 && push_behind > 0 )) && diverged=true
  if grep -qx "$remote_sha" <<<"$(git reflog show --format=%H "refs/heads/$branch" 2>/dev/null)"; then
    remote_ours=true
  else
    remote_ours=false
  fi
fi

# ── freshness ────────────────────────────────────────────────────────────────

stale=()
stale_check() { # stale_check <pr-json> <name>
  local gh_sha; gh_sha=$(jq -r 'select(.state == "OPEN") | .headRefOid' <<<"$1")
  if [[ -n $gh_sha && $gh_sha != "$(ref "refs/remotes/$remote/$2")" ]]; then
    stale+=("$remote/$2 is not at GitHub's ${gh_sha:0:7}")
  fi
}
[[ $pr != null ]] && stale_check "$pr" "$branch"
[[ $parent_pr != null ]] && stale_check "$parent_pr" "$parent"
stale_json='[]'
(( ${#stale[@]} )) && stale_json=$(printf '%s\n' "${stale[@]}" | jq -R . | jq -sc .)

# ── O6 review pins ───────────────────────────────────────────────────────────

pin_status() {
  local pin; pin=$(ref "refs/pr-tend/$branch/$1")
  if [[ -z $pin ]]; then
    jq -n '{sha: null, status: "none"}'
  elif [[ $pin == "$head" ]]; then
    jq -n --arg s "$pin" '{sha: $s, status: "covered"}'
  elif is_ancestor "$pin" "$head"; then
    jq -n --arg s "$pin" --argjson n "$(count "$pin..$head")" '{sha: $s, status: "uncovered", uncovered: $n}'
  else
    local against=${target_ref:-$head} status=unknown pin_base head_base
    pin_base=$(git merge-base "$pin" "$against" || true)
    head_base=$(git merge-base "$head" "$against" || true)
    if [[ -n $pin_base && -n $head_base ]]; then
      status=rewritten-changed
      [[ $(patch_id "$pin_base" "$pin") == "$(patch_id "$head_base" "$head")" ]] && status=rewritten-same
    fi
    jq -n --arg s "$pin" --arg st "$status" '{sha: $s, status: $st}'
  fi
}

declare -A review
for p in local bot accepted; do
  review[$p]=$(pin_status "$p" || true)
  if [[ -z ${review[$p]} ]]; then
    review[$p]=null
    errors+=("review pin $p: could not evaluate")
  fi
done

# ── assemble ─────────────────────────────────────────────────────────────────

state=$(jq -n \
  --arg branch "$branch" --arg head "$head" --argjson pr "$pr" \
  --arg parent "$parent" --arg parent_source "$parent_source" \
  --argjson parent_pr "$parent_pr" --argjson parent_merged "$parent_merged" \
  --arg target "$target" --arg default_branch "$default_branch" --argjson behind "$behind" --argjson up_to_date "$up_to_date" \
  --argjson old_base "$(jnull "$old_base")" --argjson conflict "$conflict" \
  --argjson remote_sha "$(jnull "$remote_sha")" --argjson ahead "$ahead" \
  --argjson push_behind "$push_behind" --argjson diverged "$diverged" --argjson remote_ours "$remote_ours" \
  --argjson stale "$stale_json" \
  --argjson r_local "${review[local]}" --argjson r_bot "${review[bot]}" \
  --argjson r_accepted "${review[accepted]}" \
  --argjson gh_ok "$gh_ok" --argjson parent_ok "$parent_ok" \
  --arg viewer "$viewer" --argjson bots "$bots" \
  --argjson ignore "$ignore" --argjson ignore_body "$ignore_body" \
  --argjson handled "$(jlist "branch.$branch.pr-handled")" \
  --argjson refs "$(git for-each-ref --format='%(refname) %(objectname)' "refs/pr-tend/$branch/" \
                    | jq -Rn --arg p "refs/pr-tend/$branch/" '[inputs | split(" ") | {key: (.[0] | ltrimstr($p)), value: .[1]}] | from_entries')" \
  --arg enrolled "$(cfg pr-tend)" --arg harness "$(cfg pr-harness)" \
  --arg session "$(cfg pr-session)" --arg lock "$(cfg pr-lock)" \
  --args '
  def nn: if . == "" then null else . end;
  def unbot: sub("\\[bot\\]$"; "");
  def is_bot: .__typename == "Bot" or ((.login // "" | unbot) as $l | $l != "" and any($bots[]; unbot == $l));
  def ignored: (.login // "" | unbot) as $l | any($ignore[]; unbot == $l);
  # First line with text, HTML tags and heading / quote markers removed.
  def excerpt: [(. // "") | split("\n")[] | gsub("<[^>]*>"; "") | sub("^[#>\\s]+"; "") | sub("\\s+$"; "")
                | select(. != "")][0] // "" | .[0:100];
  def detail: {author: .author.login, url, excerpt: (.body | excerpt)};
  def ci_class:
    if .__typename == "CheckRun" then
      if .status != "COMPLETED" then "pending" else .conclusion end
    else .state end
    | if . == "pending" or . == "PENDING" or . == "EXPECTED" then "pending"
      elif . == "SUCCESS" or . == "NEUTRAL" or . == "SKIPPED" then "ok"
      elif . == "CANCELLED" or . == "STALE" then "cancelled"
      else "fail" end;
  ($pr.commits.nodes[0].commit // null) as $c
  | ([$c.statusCheckRollup.contexts.nodes // [] | .[] | {name: (.name // .context), k: ci_class}]) as $ctx
  | ([$pr.reviewThreads.nodes // [] | .[]
      | select((.isResolved | not) and ((.last.nodes[0].author.login // "") != $viewer)
               and (.first.nodes[0].author // {} | ignored | not))
      | {id, type: "thread", path, line, outdated: .isOutdated,
         kind: (if .first.nodes[0].author // {} | is_bot then "bot" else "human" end),
         last: .last.nodes[0].author.login, mark: "!"} + (.first.nodes[0] // {} | detail)]
     + [($pr.reviews.nodes // [] | .[] | {n: ., type: "review"}), ($pr.comments.nodes // [] | .[] | {n: ., type: "comment"})
        | select((.n.author // {} | is_bot and (ignored | not)) and (.n.body // "" | test("\\S") and (. as $b | any($ignore_body[]; . as $re | $b | test($re)) | not)) and (.n.id | IN($handled[]) | not))
        | {id: .n.id, type, path: null, line: null, outdated: null, kind: "bot", last: .n.author.login,
           mark: (if .n.state == "CHANGES_REQUESTED" then "!" else "i" end)} + (.n | detail)]
     # A reviewer verdict is their latest approving, requesting or dismissed review.
     + [$pr.reviews.nodes // [] | map(select((.author // {} | is_bot or ignored | not)
                                             and (.state | IN("APPROVED", "CHANGES_REQUESTED", "DISMISSED"))))
        | group_by(.author.login)[] | last | select(.state == "CHANGES_REQUESTED")
        | {id, type: "review", path: null, line: null, outdated: null, kind: "human", last: .author.login,
           mark: "!"} + detail]) as $owed
  | [$owed[] | select(.kind == "bot")] as $ob
  | {
      branch: $branch, head: $head,
      pr: (if $pr == null then null else
             {number: $pr.number, url: $pr.url, state: $pr.state, draft: $pr.isDraft,
              base: $pr.baseRefName, head_sha: $pr.headRefOid, mergeable: $pr.mergeable} end),
      parent: {name: $parent, source: $parent_source, merged: $parent_merged,
               pr: (if $parent_pr == null then null else
                      {number: $parent_pr.number, state: $parent_pr.state, head_sha: $parent_pr.headRefOid} end)},
      sync: {target: $target, default: $default_branch, behind: $behind, up_to_date: $up_to_date, old_base: $old_base, conflict: $conflict},
      push: {remote_sha: $remote_sha, ahead: $ahead, behind: $push_behind, diverged: $diverged, remote_ours: $remote_ours},
      fresh: (if $gh_ok and $parent_ok then $stale == [] else null end), stale: $stale,
      ci: {sha: $c.oid, for_head: (if $c == null then null else $c.oid == $head end),
           verdict: (if ($ctx | length) == 0 then "none"
                     elif any($ctx[]; .k == "fail") then "red"
                     elif any($ctx[]; .k == "pending") then "pending"
                     elif any($ctx[]; .k == "cancelled") then "inconclusive"
                     else "green" end),
           failing: [$ctx[] | select(.k == "fail") | .name],
           pending: [$ctx[] | select(.k == "pending") | .name]},
      review: {local: $r_local, bot: $r_bot, accepted: $r_accepted},
      threads: {owed_bot: (if $gh_ok then $ob | length else null end),
                owed_human: (if $gh_ok then [$owed[] | select(.kind == "human")] | length else null end),
                outdated: (if $gh_ok then [$owed[] | select(.outdated)] | length else null end),
                by_type: (if $gh_ok then reduce $ob[] as $i ({thread: 0, review: 0, comment: 0}; .[$i.type] += 1)
                          else null end),
                blocking: (if $gh_ok then [$owed[] | select(.mark == "!")] | length else null end),
                info: (if $gh_ok then [$owed[] | select(.mark == "i")] | length else null end),
                items: $owed},
      session: {enrolled: ($enrolled == "true"), harness: ($harness | nn), id: ($session | nn),
                locked: ($lock != "")},
      stored: {handled: $handled, refs: $refs},
      errors: $ARGS.positional
    }' "${errors[@]}")
next=$(printf '%s\n' "$state" | prn_next "$remote") || die "pr-next failed"
state=$(jq --argjson next "$next" '. + {next: $next}' <<<"$state")

if $json; then
  echo "$state"
  exit 0
fi

jq -r '
  def plural($n; $w): "\($n) \($w)";
  [ .branch,
    (if .pr == null then "no PR"
     else "#\(.pr.number) \(if .pr.draft then "draft" else .pr.state | ascii_downcase end)" end),
    (if .parent.merged then "parent merged → \(.sync.target)" else empty end),
    (if .sync.up_to_date == false then
       "↓\(.sync.behind) \(.sync.target)\(if .sync.conflict then " (conflict)" else "" end)"
     else empty end),
    (if .push.remote_sha == null then
       (if .push.ahead > 0 then "\(.push.ahead) unpushed" else "not pushed" end)
     elif .push.diverged then
       "diverged from remote\(if .push.remote_ours then "" else " (not ours)" end)"
     else
       ((if .push.ahead > 0 then "\(.push.ahead) unpushed" else empty end),
        (if .push.behind > 0 then "remote +\(.push.behind)" else empty end))
     end),
    (if .pr == null then empty
     else "CI \(.ci.verdict)\(if .ci.failing != [] then " (\(.ci.failing | join(", ")))" else "" end)\(if .ci.for_head == false then " on old head" else "" end)" end),
    (if .pr == null or .threads.blocking == null then empty
     else "!:\(.threads.blocking) i:\(.threads.info)" end),
    (.review | to_entries[] | select(.value != null and .value.status != "none")
     | "\(.key) \({covered: "✓", "rewritten-same": "✓", uncovered: "+\(.value.uncovered)", "rewritten-changed": "✗", unknown: "?"}[.value.status])"),
    (if .session.locked then "locked" else empty end),
    (if .fresh == false then "⚠ stale: fetch" else empty end),
    (if .errors != [] then "⚠ \(.errors | length) error(s)" else empty end)
  ] | join(" · ")' <<<"$state"
printf '%s\n' "$next" | prn_lines "$($long && echo all || echo one)"

$long || exit 0
jq -r '
  def pad($n): . + ([range(length; $n)] | map(" ") | join(""));
  [.threads.items[] | {mark, type, author: (.author // .last // ""),
                       text: ([(if .path then "\(.path):\(.line)" else empty end), .excerpt // ""]
                              | map(select(. != "")) | join("  ")),
                       url: (.url // "")}] as $it
  | ($it | map(.type | length) | max) as $tw | ($it | map(.author | length) | max) as $aw
  | ($it | map(.text | length) | max) as $xw
  | $it[] | "  \(.mark)  \(.type | pad($tw))  \(.author | pad($aw))  \(.text | pad($xw))  \(.url)" | sub("\\s+$"; "")' <<<"$state"
