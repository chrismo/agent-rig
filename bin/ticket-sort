# ── main ──────────────────────────────────────────────────────────────────────

# Prints the header block from "Usage:" down to the last example, so the help
# and the file's own documentation cannot drift apart. Line-number ranges did
# drift - editing the header silently truncated --help mid-sentence.
ts_usage() {
  awk '/^# Usage:/{p=1} p{print} /^#   linear.sh json \| ticket-sort prune/{exit}' \
    "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd='' as_json=no source=stdin file='' apply=no top='' show='' n i

  # Subcommand first, because these are different jobs rather than variants of
  # one: `full` works from an empty store and `place` cannot, they cost an order
  # of magnitude apart, and `report`/`prune` do not sort at all. A flag would
  # imply they are the same operation tuned differently.
  case "${1:-}" in
    full|place|report|prune) cmd="$1"; shift ;;
    -h|--help)               ts_usage; return 0 ;;
    '')                      ts_usage >&2; return 2 ;;
    *)                       printf 'ticket-sort: unknown command: %s\n\n' "$1" >&2
                             ts_usage >&2; return 2 ;;
  esac

  while (( $# )); do
    case "$1" in
      --json)     as_json=yes ;;
      --demo)     source=demo ;;
      --apply)    apply=yes ;;
      --top)      shift; top="${1:-}" ;;
      --show)     shift; show="${1:-}" ;;
      -f|--file)  shift; file="$1"; source=file ;;
      -h|--help)  ts_usage; return 0 ;;
      *)          echo "ticket-sort: unknown option: $1" >&2; return 2 ;;
    esac
    shift
  done

  local report_only=no prune_only=no place_only=no
  case "$cmd" in
    report) report_only=yes ;;
    prune)  prune_only=yes ;;
    place)  place_only=yes ;;
  esac

  if [[ -n "$top" && ! "$top" =~ ^[1-9][0-9]*$ ]]; then
    echo "ticket-sort: --top needs a positive count" >&2
    return 2
  fi

  if [[ -n "$show" && ! "$show" =~ ^[1-9][0-9]*$ ]]; then
    echo "ticket-sort: --show needs a positive count" >&2
    return 2
  fi

  command -v jq >/dev/null || { echo "ticket-sort: jq is required" >&2; return 1; }

  # --report reads the store, not a ticket list: the comparisons already name every
  # ticket you have ranked, so asking "what did I decide?" should not require a
  # round trip to Linear. Piping tickets in is still useful - it supplies titles
  # and narrows the report to that set - but it is optional, and a terminal on
  # stdin means no pipe rather than something to wait for.
  if [[ "$report_only" == yes ]]; then
    if [[ "$source" == file ]]; then
      ts_load < "$file"
    elif [[ "$source" == demo ]]; then
      ts_load < <(ts_demo_data)
    elif [[ -p /dev/stdin || -f /dev/stdin ]]; then
      # A pipe or a redirected file is real input. "Not a tty" is not the same
      # test: stdin can also be closed, and that took this branch straight into
      # a jq that blocks forever.
      ts_load
    else
      ts_load_from_comparisons || return 1
    fi
  else
    case "$source" in
      demo) ts_load < <(ts_demo_data) ;;
      file) ts_load < "$file" ;;
      *)    ts_load ;;
    esac
  fi

  n=${#TS_TICKETS[@]}
  TS_ARR=()
  for (( i = 0; i < n; i++ )); do TS_ARR+=("$i"); done

  # A --top bigger than the backlog is just a full ranking.
  (( ${top:-0} >= n )) && top=''

  # Preview defaults to whatever you asked to see, then to whatever you asked
  # to rank, then 5. --show wins over --top here: watching a 2-row window while
  # ranking is the thing --show exists to fix, and deciding "these are clearly
  # the important ones" needs the wider list during the run, not just after it.
  # An explicit TS_PREVIEW still beats both, including TS_PREVIEW=0 to turn the
  # standing list off.
  if [[ -z "$TS_PREVIEW" ]]; then
    TS_PREVIEW=${show:-${top:-5}}
  fi
  (( TS_PREVIEW > n )) && TS_PREVIEW=$n

  # Comparisons from previous runs become memo entries, so the sort never asks
  # what you have already decided.
  ts_comparisons_load

  # --prune stops here. It needs the input (statuses live there, never in the
  # store) but asks nothing and, without --apply, writes nothing.
  if [[ "$prune_only" == yes ]]; then
    ts_prune "$apply"
    return $?
  fi

  # place stops here: it needs the store loaded and the answer stream open, but
  # never runs the sort.
  if [[ "$place_only" == yes ]]; then
    if [[ ! -f "$TS_COMPARISONS_FILE" && "$TS_COMPARISONS_FILE" != none ]]; then
      echo "ticket-sort: no comparisons yet - run \`full\` first" >&2
      return 1
    fi
    exec {TS_FD}< "$TS_INPUT" ||
      { echo "ticket-sort: cannot read answers from $TS_INPUT" >&2; return 1; }
    # shellcheck disable=SC2154  # assigned inside the trap body, one command earlier
    trap 'ts_comparisons_exit=$?; ts_comparisons_save; exit "$ts_comparisons_exit"' EXIT
    ts_place "$as_json" "${top:-10}"
    return $?
  fi

  # --report stops here: rank from what the store already proves and exit. No
  # answer stream is opened and no save trap is set, so it is read-only by
  # construction rather than by promise.
  if [[ "$report_only" == yes ]]; then
    ts_report_comparisons "$as_json" "${top:-0}"
    return 0
  fi

  # Save on the way out however that happens. Quitting with q, or running out
  # of piped answers, exits straight from ts_ask - and the answers given before
  # that point are exactly the ones worth not asking again.
  #
  # The trap must hand back the status it was called with: an EXIT handler's own
  # result becomes the script's exit code, which would turn `q` (130) into 0.
  # shellcheck disable=SC2154  # assigned inside the trap body, one command earlier
  trap 'ts_comparisons_exit=$?; ts_comparisons_save; exit "$ts_comparisons_exit"' EXIT

  # Ballpark, so the size of the job is clear before it starts.
  #
  # n log2(n) alone is badly wrong once the store has anything in it: 40 ranked
  # tickets plus 5 new predicted ~247 questions for a run that asked 29. An
  # up-front number off by 8x is what stops you running this daily, so count
  # what the memo already knows.
  #
  # Split the list into the chain the store already orders and the newcomers it
  # says nothing useful about. "Already placed" cannot mean "ordered against
  # every ticket here" - a newcomer nobody has met yet would then disqualify the
  # whole chain. It means ordered against everything else IN THE CHAIN, which is
  # what makes a binary insert possible.
  #
  # Greedy and approximate, which is all an estimate needs: walk tickets by how
  # much the memo knows about them, keeping one if it is ordered against
  # everything kept so far.
  local placed=0 n_new=0 i j known
  local -a by_known=() chain=()
  while IFS=' ' read -r _ i; do
    by_known+=("$i")
  done < <(
    for (( i = 0; i < n; i++ )); do
      known=0
      for (( j = 0; j < n; j++ )); do
        (( i == j )) && continue
        [[ -n "${TS_MEMO[$i:$j]:-}" ]] && known=$(( known + 1 ))
      done
      printf '%s %s\n' "$known" "$i"
    done | sort -k1,1nr -k2,2n
  )
  local cand ok m
  for cand in "${by_known[@]}"; do
    ok=yes
    for m in "${chain[@]}"; do
      [[ -n "${TS_MEMO[$cand:$m]:-}" ]] || { ok=no; break; }
    done
    if [[ "$ok" == yes ]]; then
      chain+=("$cand"); placed=$(( placed + 1 ))
    else
      n_new=$(( n_new + 1 ))
    fi
  done

  TS_ESTIMATE=$(awk -v n="$n" -v k="${top:-0}" -v placed="$placed" -v new="$n_new" 'BEGIN {
    if (placed >= 2 && new == 0) {
      # Everything is already ordered - the sort will consult the memo and ask
      # nothing. Saying ~n log n here is the worst version of the lie: it
      # predicts the most work for the run that does the least.
      printf "%d", 0
    } else if (placed >= 2 && new > 0) {
      # Binary-insert each newcomer into the placed chain, then order the
      # newcomers against each other.
      per = log(placed + 1) / log(2)
      printf "%d", new * per + (new > 1 ? new * log(new) / log(2) : 0)
    } else if (k > 0) {
      printf "%d", n + (k > 1 ? k * log(k) / log(2) : 0)
    } else {
      printf "%d", (n > 1 ? n * log(n) / log(2) : 0)
    }
  }')
  TS_PLACED_KNOWN=$placed
  TS_NEW_COUNT=$n_new

  # Let bash pick a high FD rather than claiming 3 - anything sourcing this
  # (bats, for one) may already be using the low ones.
  exec {TS_FD}< "$TS_INPUT" ||
    { echo "ticket-sort: cannot read answers from $TS_INPUT" >&2; return 1; }

  TS_WINDOW=${top:-$n}

  # Say what is already settled before the first question - "5 new, 40 already
  # placed" is the difference between a job you start and one you put off.
  local known_note=''
  if (( TS_PLACED_KNOWN >= 2 && TS_NEW_COUNT > 0 )); then
    known_note=$(printf ' - %d already placed, %d new' \
      "$TS_PLACED_KNOWN" "$TS_NEW_COUNT")
  elif (( TS_PLACED_KNOWN >= 2 )); then
    known_note=' - all already placed'
  fi

  if [[ -n "$top" ]]; then
    printf '%s%d tickets, top %d only%s - ~%d questions.%s\n' \
      "$BOLD" "$n" "$top" "$known_note" "$TS_ESTIMATE" "$RESET" >&2
    ts_select 0 $(( n - 1 )) $(( top - 1 ))
    ts_sort 0 $(( top - 1 ))
  else
    printf '%s%d tickets%s, ~%d questions.%s\n' \
      "$BOLD" "$n" "$known_note" "$TS_ESTIMATE" "$RESET" >&2
    ts_sort 0 $(( n - 1 ))
  fi

  local reused=$(( TS_COMPARISONS - TS_ASKED ))
  printf '\n%sDone - %d question%s' "$GREEN" "$TS_ASKED" "$( (( TS_ASKED == 1 )) || echo s)" >&2
  (( reused > 0 )) &&
    printf ', %d answer%s reused' "$reused" "$( (( reused == 1 )) || echo s)" >&2
  (( TS_MEHS > 0 )) &&
    printf ', %d coin flip%s' "$TS_MEHS" "$( (( TS_MEHS == 1 )) || echo s)" >&2
  (( TS_BULK_RESOLVED > 0 )) &&
    printf ', %d settled by t/b' "$TS_BULK_RESOLVED" >&2
  printf '.%s\n\n' "$RESET" >&2

  ts_report "$as_json" "${top:-$n}" "${show:-0}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
