#!/usr/bin/env bash
#
# ticket-sort - Rank Linear tickets by head-to-head comparison.
#
# Quicksort where every comparison is you. Each one dumps two tickets - title,
# priority, status, due date, SLA, labels, project - and asks which to work first.
# n log n questions later you have a ranked backlog.
#
# Usage: ticket-sort <command> [options]
#
#   full     rank a list from scratch, comparing everything that needs it.
#            The only thing that works with no stored comparisons, and what to
#            run when you have lost touch with your ranking and want to think
#            it through again.
#
#   place    work new tickets into a ranking you already trust. Asks whether
#            each newcomer beats the cut, and only places precisely the ones
#            that do - the rest go to the tail. Needs stored comparisons.
#
#   report   show the current ranking from stored comparisons. Asks nothing,
#            needs no input, works offline.
#
#   prune    forget comparisons for input tickets with finished statuses.
#
# Options:
#   --top N     rank only the top N (full, place, report)
#   --show N    print N rows even though only --top are ranked (full)
#   --json      emit JSON instead of a table
#   --apply     actually write (prune only; it is a dry run otherwise)
#   -f FILE     read tickets from a file instead of stdin
#   --demo      use built-in fake tickets
#
# Examples:
#   linear.sh json | ticket-sort full --top 5
#   linear.sh json | ticket-sort place --top 10
#   ticket-sort report --top 10
#   linear.sh json | ticket-sort prune --apply
#
# At each comparison:
#   l         work the left ticket first        (Enter defaults to this)
#   r         work the right one first
#   m         no preference; decided by coin flip and remembered
#   rt / rb   the right ticket beats / loses to everything left in this pass
#   lt / lb   same, for the left ticket
#             (t / b still work, as aliases for rt / rb)
#   ol / or   open that ticket, then ask again
#   q         quit
# 1 and 2 also work for left and right, as do o1 and o2 for opening.
#
# --top K uses quickselect: it only partitions far enough to isolate the top K,
# then ranks those. Roughly n + K log K questions instead of n log n, and the
# unranked tail is not printed - it has no order to report.
#
# --show N prints N rows even though only K are ranked. Spending questions and
# seeing tickets are different needs: --top 2 --show 10 asks two positions'
# worth and still lists ten, which is often enough to decide the head is right
# and stop. The rows past K are marked with a dot rather than numbered, because
# partitioning left them in an order nobody chose - they are above the cut, not
# ranked among themselves.
#
# Input is a JSON array or NDJSON, one object per ticket. Recognized fields:
#   id, title, priority, status, due, sla, labels[], project, url
# due and sla are both deadlines - a plain date or an ISO datetime. A value
# that will not parse as a date is shown as written.
# Everything except id/title is optional.
#
# The UI goes to stderr and the ranking to stdout, so piping works:
#   linear.sh json | ticket-sort --json > ranked.json
#
# Answers are read from /dev/tty (override with TS_INPUT for scripted runs),
# so the ticket stream on stdin never collides with the prompt.
#
# Environment:
#   TS_WORKSPACE   linear.app slug, for building urls when tickets lack one
#   TS_OPEN        how o1/o2 launch a ticket (default: open)
#   TS_TODAY       pin "today" for due-date math (default: actual today)
#   TS_BASH        bash 4.1+ to re-exec under, if it isn't on the usual paths
#   TS_PRUNE_STATES  statuses --prune treats as finished
#                  (default: Done,Canceled,Duplicated)
#   TS_COMPARISONS_FILE       comparison store path, or "none" to answer fresh every time
#                  (default: $XDG_STATE_HOME/ticket-sort/comparisons.json)
#
# Answers persist between runs, and they compose: A > B and B > C means A > C
# without asking. So re-ranking a backlog you already ranked asks nothing, and
# adding a ticket to it only asks about the new one. Measured on 50 tickets -
# cold 203 questions, warm re-run 0, one new ticket 4.
#
# Priorities drift, so comparisons are timestamped and the newest always wins. If
# today's answer contradicts older ones, the stale edges yield rather than the
# new call - answer a pair again and the implications that disagree with it are
# dropped. One reversal can invalidate several old implications, since they were
# what the derived pairs rested on.
#
# A known pair is never asked again, so changing your mind about one means
# either answering it in a run where it is still unknown, or editing the store -
# small readable JSON keyed by "<id>|<id>" with the winner in "w":
#   jq 'del(."DEVOPS-1904|DEVOPS-2140")' "$store" > t && mv t "$store"
#
# The store grows with your whole ticket universe rather than any one list, so
# --prune forgets comparisons about work that is over. It only drops tickets the
# input SAYS are finished - absence proves nothing, since a scoped query omits
# out-of-scope tickets exactly like closed ones. Dry run unless --apply.
#
# TODO: this script has outgrown the shell, and the two symptoms are related.
#
# It needs three interpreters to work: bash 4.1+ (which macOS does not ship, so
# there is a re-exec guard above just to find one), jq (17 call sites, including
# one per field per rendered ticket), and python3 - 75 lines of it embedded as a
# quoted heredoc in ts_comparisons_closure, where shellcheck cannot see it and no test
# can reach it directly.
#
# Replacing jq with superdb would fit the rest of the rig - install.sh already
# pins ASDF_SUPERDB_VERSION and bin/lib/superdb.sh has an ensure_superdb helper.
# Watch ts_field's fallback semantics (null / "" / [] all collapse to an em
# dash), ts_load accepting both a JSON array and NDJSON, and rank: null
# surviving the round trip in --json.
#
# The python is NOT replaceable that way: transitive closure needs a fixpoint
# loop, and superdb rejects WITH RECURSIVE outright ("recursive WITH queries not
# currently supported", checked 2026-07-28). So the options are a separate
# properly-shebanged script - lintable, testable, an honest dependency - or
# going native.
#
# Which is the real question: a Rust binary would end all three problems at
# once. No interpreter hunt, no subprocess per field, closure in microseconds
# rather than ~140ms at 200 tickets, and a real TUI instead of ANSI printf. The
# cost is porting a 110-test bats suite. Not urgent - 50 tickets warm-start in
# about a second today. Revisit when the interactive loop feels slow, or when
# the embedded python grows past this one function.

# This script needs bash 4.1+ - associative arrays, {fd} allocation, mapfile,
# ${var,,} - but macOS still ships 3.2 as /bin/bash, and a homebrew bash is
# often deliberately left off PATH so `bash` stays 3.2 for everyone else. So
# find a newer one and hand off to it. Homebrew's opt path is used rather than
# a Cellar path because it survives `brew upgrade bash`.
#
# Must stay above the first 4+ construct that actually executes - the
# `declare -gA` globals below. bash parses command-by-command, so later 4+
# syntax is not a parse error; it fails when reached. `declare -gA` fails
# loudly but keeps going, leaving TS_MEMO a plain indexed array that corrupts
# on its first "a:b" subscript, so an unguarded run misbehaves rather than
# stopping. Guarding here means it never gets that far.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 1) )); then
  # Re-exec only when run as a program. When sourced (the test suite does
  # this) $0 is the caller's shell, not this file, so an exec here would try
  # to run the bash binary as a script and take the caller down with it.
  if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    for _ts_bash in "${TS_BASH:-}" \
                    /opt/homebrew/opt/bash/bin/bash \
                    /usr/local/opt/bash/bin/bash \
                    /opt/homebrew/bin/bash \
                    /usr/local/bin/bash; do
      [ -n "$_ts_bash" ] && [ -x "$_ts_bash" ] || continue
      exec "$_ts_bash" "${BASH_SOURCE[0]}" "$@"
    done
  fi
  echo "ticket-sort needs bash 4.1+, found $BASH_VERSION" >&2
  echo "  brew install bash    (or point TS_BASH at one)" >&2
  exit 1
fi

set -euo pipefail

# ── globals ───────────────────────────────────────────────────────────────────

TS_TICKETS=()        # JSON blob per ticket, indexed
TS_ARR=()            # indices into TS_TICKETS - this is what gets sorted
TS_COMPARE=ts_ask    # comparator: "$TS_COMPARE" a b -> 0 if a ranks first
TS_COMPARISONS=0     # logical comparisons the sort performed
TS_ASKED=0           # of those, the ones a human actually answered
TS_MEHS=0            # answered "m" - decided by coin flip, not by you
TS_BULK=''           # standing t/b comparison for the current partition pass
TS_BULK_PIVOT=''     # the right-hand ticket an rt/rb comparison is about
TS_BULK_LEFT=''      # the left-hand ticket an lt/lb comparison is about
TS_BULK_RESOLVED=0   # comparisons settled by a comparison rather than asked
TS_ESTIMATE=0
TS_PLACED_KNOWN=0    # tickets the store already orders against all others
TS_NEW_COUNT=0       # the rest - what this run actually has to work out
TS_WINDOW=0          # positions being ranked: --top K, or the whole backlog
TS_PIVOT=0
# -g because this file gets sourced from inside a function by the test suite,
# where a bare `declare -A` would be function-local - leaving the real global
# a plain indexed array, whose "a:b" subscript is an arithmetic syntax error.
declare -gA TS_MEMO=()    # "a:b" -> 0/1, so no pair is ever asked twice
declare -gA TS_SETTLED=() # position -> 1 once a pivot has landed there
# Pairs TS_MEMO got from the store rather than from you, so saving can leave
# them alone. Persisting a derived pair would both bloat the store and stamp an
# inference with today's date, letting it outrank a real older comparison.
declare -gA TS_FROM_STORE=()
TS_FD=                 # answer stream, assigned by `exec {TS_FD}<` at startup

: "${TS_INPUT:=/dev/tty}"
: "${TS_TODAY:=}"
: "${TS_OPEN:=open}"        # how ol/or launch a ticket
: "${TS_PREVIEW:=}"         # standing-list rows; 0 disables
: "${TS_WORKSPACE:=}"       # linear.app/<slug>, for tickets with no url field
# Comparisons are durable machine-local state, so they go in the XDG state dir -
# not next to the script (generated data inside a git repo, needing a
# .gitignore line and lost on a fresh clone) and not relative to $PWD, which
# would scatter files and forget what it already knew. State rather than cache
# because these are answers you gave: re-running does not regenerate them.
# Set TS_COMPARISONS_FILE to move it, or TS_COMPARISONS_FILE=none to answer fresh every time.
: "${TS_COMPARISONS_FILE:=${XDG_STATE_HOME:-$HOME/.local/state}/ticket-sort/comparisons.json}"

BOLD=$'\033[1m'
DIM=$'\033[2m'
RED=$'\033[31m'
YELLOW=$'\033[33m'
CYAN=$'\033[36m'
GREEN=$'\033[32m'
RESET=$'\033[0m'

if [[ ! -t 2 ]]; then
  BOLD=''; DIM=''; RED=''; YELLOW=''; CYAN=''; GREEN=''; RESET=''
fi

# ── quicksort ─────────────────────────────────────────────────────────────────
# In place on TS_ARR so the comparison counter and any prompt state survive -
# a recursive sort built from command substitution would lose both to
# subshells. Pivot is chosen at random to keep an already-ranked backlog off
# quicksort's O(n^2) path, which here would mean a pile of extra questions.

ts_swap() {
  local tmp="${TS_ARR[$1]}"
  TS_ARR[$1]="${TS_ARR[$2]}"
  TS_ARR[$2]="$tmp"
}

ts_partition() {
  local lo=$1 hi=$2 i j pivot x

  # Everything in this range is about to be shuffled around, so nothing in it
  # is settled until a pivot lands. A plain sort never re-partitions a settled
  # position, but --top does: quickselect settles part of the head, then the
  # head gets sorted, and mid-partition a settled row would otherwise display
  # a ticket that is only passing through.
  for (( x = lo; x <= hi; x++ )); do
    unset 'TS_SETTLED[$x]'
  done

  ts_swap $(( lo + RANDOM % (hi - lo + 1) )) "$hi"
  pivot="${TS_ARR[$hi]}"

  # The pivot is the right-hand ticket for this whole pass, which is what
  # makes a one-key comparison against all of it meaningful. Each pass starts
  # with no standing call.
  TS_BULK=''
  TS_BULK_PIVOT="$pivot"
  TS_BULK_LEFT=''

  i=$lo
  for (( j = lo; j < hi; j++ )); do
    TS_COMPARISONS=$(( TS_COMPARISONS + 1 ))
    if "$TS_COMPARE" "${TS_ARR[$j]}" "$pivot"; then
      ts_swap "$i" "$j"
      i=$(( i + 1 ))
    fi
  done

  ts_swap "$i" "$hi"
  TS_PIVOT=$i
  # A pivot lands in its final position and never moves again - the one thing
  # quicksort actually guarantees mid-run, and what the standing preview
  # numbers. Verified empirically: 1533 placements, zero that later moved.
  TS_SETTLED[$i]=1
}

ts_sort() {
  local lo=$1 hi=$2 p
  if (( lo >= hi )); then
    # A one-element range is final too, but no pivot ever lands on it - mark
    # it here or the preview leaves genuinely-decided rows unnumbered.
    (( lo == hi )) && TS_SETTLED[$lo]=1
    return 0
  fi
  ts_partition "$lo" "$hi"
  p=$TS_PIVOT
  ts_sort "$lo" $(( p - 1 ))
  ts_sort $(( p + 1 )) "$hi"
}

# Quickselect: arrange TS_ARR so positions 0..kidx hold the top kidx+1
# tickets, and stop there. Only ever recurses into the side that still
# overlaps the head, so the tail is partitioned but never ranked - which is
# the whole point. Roughly n comparisons instead of n log n, plus whatever
# it costs to sort the head afterwards.
ts_select() {
  local lo=$1 hi=$2 kidx=$3 p
  if (( lo >= hi )); then
    (( lo == hi )) && TS_SETTLED[$lo]=1
    return 0
  fi
  ts_partition "$lo" "$hi"
  p=$TS_PIVOT
  if (( p > kidx )); then
    ts_select "$lo" $(( p - 1 )) "$kidx"
  elif (( p < kidx )); then
    ts_select $(( p + 1 )) "$hi" "$kidx"
  fi
  # p == kidx: the head is exactly filled, nothing left to select.
}

# ── loading ───────────────────────────────────────────────────────────────────

# Accepts a JSON array or an NDJSON stream and normalizes both to one compact
# object per line. `jq -s` slurps NDJSON into an array; a lone input array
# becomes a one-element array of arrays, which `flatten(1)` undoes.
ts_load() {
  local line normalized
  TS_TICKETS=()

  # A terminal on stdin is never the intent - nobody types a JSON array at a
  # prompt - but jq -s would happily block on it until EOF, which reads as the
  # program hanging. Say what is missing instead.
  if [[ -t 0 ]]; then
    echo "ticket-sort: no tickets on stdin (it is a terminal, not a pipe)" >&2
    echo "  linear.sh json | ticket-sort" >&2
    echo "  ticket-sort -f tickets.json" >&2
    echo "  ticket-sort --demo" >&2
    return 1
  fi

  # jq's own parse error goes straight to stderr - it says far more about a
  # malformed payload than anything this script could.
  if ! normalized=$(jq -c -s 'flatten(1) | .[]'); then
    echo "ticket-sort: could not parse input as JSON" >&2
    return 1
  fi

  while IFS= read -r line; do
    [[ -n "$line" ]] && TS_TICKETS+=("$line")
  done <<< "$normalized"

  if (( ${#TS_TICKETS[@]} == 0 )); then
    echo "ticket-sort: no tickets on input" >&2
    return 1
  fi
}

# ── comparison store ─────────────────────────────────────────────────────────────
# Every answer you give is a fact about two tickets, and it stays true after the
# run ends. Persisting them means a backlog you have already ranked re-ranks for
# free, and adding one ticket to a ranked list costs only the questions that new
# ticket is actually in.
#
# On disk: {"<id>|<id>": {"w": "<winning id>", "at": "<when>"}}, pair key sorted
# so A|B and B|A are the same entry. A saved run merges onto what is already
# there, so comparisons about tickets outside this run survive.
#
# Comparisons are transitive: A > B and B > C means A > C, and applying that is
# what makes the store worth having at any real backlog size. Quicksort derives
# most pair orderings from partition structure rather than asking - about 82% of
# them at n=60 - but the store only records the ones you were asked, so without
# closure a re-run has to re-establish the rest, often by asking again. Measured
# on 50 tickets: re-running the identical list costs ~144 questions from the raw
# store and 0 with closure; adding one ticket costs ~158 against ~8.
#
# Closure needs contradictions resolved, because a single cycle would make
# everything imply everything. Comparisons are timestamped, so recency decides:
# edges are added newest-first, and one that would close a loop against
# already-accepted (newer) edges is dropped as stale. Today's decision always
# survives, which is also how a changed priority is meant to propagate - answer
# the pair again and the older implications that contradict it yield. Note that
# repairing a cycle can drop several old edges for one reversal, since those
# edges were load-bearing for derived pairs.
#
# Derivations are never written back. The store stays a record of what you
# actually answered, so a later comparison is free to undo an inference.
#
# TS_MEMO is keyed by array index because that is what the sort works in, so
# load and save translate between index and ticket id.

# Pair key is order-independent: the same two tickets always hash to one entry
# no matter which side each landed on this run.
ts_comparisons_key() {
  if [[ "$1" < "$2" ]]; then
    printf '%s|%s\n' "$1" "$2"
  else
    printf '%s|%s\n' "$2" "$1"
  fi
}

# index -> ticket id, for the tickets currently loaded. Memoized: this is called
# from n-squared loops, and a jq spawn per call is what made saving slow enough
# to feel between keystrokes.
declare -gA TS_ID_BY_INDEX=()
ts_comparisons_id() {
  if [[ -z "${TS_ID_BY_INDEX[$1]:-}" ]]; then
    TS_ID_BY_INDEX[$1]=$(jq -r '.id // empty' <<< "${TS_TICKETS[$1]}")
  fi
  printf '%s\n' "${TS_ID_BY_INDEX[$1]}"
}

ts_comparisons_path() {
  [[ "$TS_COMPARISONS_FILE" == none ]] && return 1
  printf '%s\n' "$TS_COMPARISONS_FILE"
}

# Cached comparisons become memo entries, which ts_ask already checks before
# asking - so a hit is indistinguishable from a question you answered this run.
ts_comparisons_load() {
  local path line i j stored=0 implied=0 dropped=0
  path=$(ts_comparisons_path) || return 0
  [[ -f "$path" ]] || return 0

  # A hand-edited or truncated cache should cost you nothing but the cache.
  if ! jq -e . "$path" >/dev/null 2>&1; then
    printf '%signoring unreadable comparison store%s %s\n' "$YELLOW" "$RESET" "$path" >&2
    return 0
  fi

  # One pass rather than a jq call per pair: at 50 tickets that inner loop was
  # 1225 subprocesses, and the closure itself is not expressible in bash without
  # a graph walk per pair. Emits "i j winner-index" lines, plus a stats line.
  while IFS=' ' read -r i j winner; do
    case "$i" in
      '#') stored=$j; implied=$winner ;;
      '!') dropped=$j ;;
      *)   if [[ "$winner" == "$i" ]]; then
             TS_MEMO[$i:$j]=0; TS_MEMO[$j:$i]=1
           else
             TS_MEMO[$i:$j]=1; TS_MEMO[$j:$i]=0
           fi
           TS_FROM_STORE[$i:$j]=1 ;;
    esac
  done < <(ts_comparisons_closure "$path")

  if (( dropped > 0 )); then
    printf '%s%d comparison%s stored, %d implied, %d stale dropped as contradicted%s\n' \
      "$DIM" "$stored" "$( (( stored == 1 )) || echo s)" "$implied" "$dropped" "$RESET" >&2
  fi
}

# Reads the comparison store, keeps only the tickets loaded this run, resolves
# contradictions by recency, closes transitively, and prints one "i j winner"
# line per known pair - indices into TS_ARR's ticket order, so the caller does
# no translation. Plus "# <stored> <implied>" and "! <dropped>" stats lines.
#
# Python because this is a graph walk: reachability per candidate edge to reject
# cycles, then a DFS per ticket to collect what it beats. ~140ms at 200 tickets,
# where the same work in bash would be minutes of subshell overhead.
ts_comparisons_closure() {
  local path="$1" i
  # Ticket ids in index order, so the child can map ids back to positions.
  for (( i = 0; i < ${#TS_TICKETS[@]}; i++ )); do
    ts_comparisons_id "$i"
  done | python3 -c '
import json, sys

path = sys.argv[1]
ids = [l.rstrip("\n") for l in sys.stdin]
pos = {t: i for i, t in enumerate(ids) if t}

try:
    store = json.load(open(path))
except Exception:
    sys.exit(0)

# Only pairs where BOTH tickets are in this run matter. A comparison about tickets
# that are not here cannot constrain the ones that are.
edges = []
for key, val in store.items():
    if not isinstance(val, dict):
        continue
    a, _, b = key.partition("|")
    w = val.get("w")
    if a not in pos or b not in pos or w not in (a, b):
        continue
    loser = b if w == a else a
    edges.append((str(val.get("at", "")), pos[w], pos[loser]))

# Newest first, so a stale edge is the one that yields when it would close a
# loop. Ties in timestamp fall back to insertion order, which is stable enough.
edges.sort(key=lambda e: e[0], reverse=True)

beats = {}
def reaches(src, dst):
    stack, seen = [src], {src}
    while stack:
        u = stack.pop()
        if u == dst:
            return True
        for v in beats.get(u, ()):
            if v not in seen:
                seen.add(v)
                stack.append(v)
    return False

dropped = 0
for _, w, l in edges:
    if reaches(l, w):     # w > l would contradict newer comparisons
        dropped += 1
        continue
    beats.setdefault(w, set()).add(l)

stored = len(edges) - dropped
out = []
for x in range(len(ids)):
    stack = list(beats.get(x, ()))
    seen = set(stack)
    while stack:
        u = stack.pop()
        for v in beats.get(u, ()):
            if v not in seen:
                seen.add(v)
                stack.append(v)
    for y in seen:
        lo, hi = (x, y) if x < y else (y, x)
        out.append((lo, hi, x))

# Dedup: a pair can be reached from both ends only if it is a cycle, which the
# repair above already ruled out - so first writer wins is safe here.
seen_pairs = {}
for lo, hi, w in out:
    seen_pairs.setdefault((lo, hi), w)

print("#", stored, len(seen_pairs) - stored)
print("!", dropped)
for (lo, hi), w in seen_pairs.items():
    print(lo, hi, w)
' "$path"
}

# Persist exactly one comparison. Called after every answer, so it must not walk
# every pair: the full scan below spawns a jq per stored comparison, which at 50
# tickets was ~640ms a keystroke.
ts_comparisons_save_pair() {
  local a=$1 b=$2 winner=$3 path id_a id_b key now tmp
  path=$(ts_comparisons_path) || return 0
  id_a=$(ts_comparisons_id "$a"); id_b=$(ts_comparisons_id "$b")
  [[ -n "$id_a" && -n "$id_b" ]] || return 0
  key=$(ts_comparisons_key "$id_a" "$id_b")
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  mkdir -p "$(dirname "$path")" 2>/dev/null || return 0
  tmp="$path.$$"
  if ! { [[ -f "$path" ]] && cat "$path" || echo '{}'; } \
       | jq -c --arg k "$key" --arg w "$winner" --arg at "$now" \
           '. + {($k): {w: $w, at: $at}}' > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    return 0
  fi
  mv -f "$tmp" "$path" 2>/dev/null || rm -f "$tmp"
}

ts_comparisons_save() {
  local path tmp now updates key i j n id_a id_b comparison winner
  path=$(ts_comparisons_path) || return 0

  n=${#TS_TICKETS[@]}
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  updates=$(
    for (( i = 0; i < n; i++ )); do
      id_a=$(ts_comparisons_id "$i")
      [[ -n "$id_a" ]] || continue
      for (( j = i + 1; j < n; j++ )); do
        comparison="${TS_MEMO[$i:$j]:-}"
        [[ -n "$comparison" ]] || continue
        # Came from the store, so it is either already recorded or an inference
        # that must not be recorded at all.
        [[ -n "${TS_FROM_STORE[$i:$j]:-}" ]] && continue
        id_b=$(ts_comparisons_id "$j")
        [[ -n "$id_b" ]] || continue
        (( comparison == 0 )) && winner="$id_a" || winner="$id_b"
        key=$(ts_comparisons_key "$id_a" "$id_b")
        jq -n -c --arg k "$key" --arg w "$winner" --arg at "$now" \
          '{($k): {w: $w, at: $at}}'
      done
    done
  )
  [[ -n "$updates" ]] || return 0

  mkdir -p "$(dirname "$path")" || return 0
  tmp="$path.$$"
  # Merge onto whatever is already there so comparisons about tickets outside this
  # run survive, and this run's answers win where they overlap.
  if ! { [[ -f "$path" ]] && jq -e . "$path" >/dev/null 2>&1 && cat "$path" || echo '{}'; } \
       | jq -s --slurpfile u <(printf '%s\n' "$updates") \
           '.[0] + (reduce $u[] as $x ({}; . + $x))' > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    printf '%scould not write comparison store%s %s\n' "$YELLOW" "$RESET" "$path" >&2
    return 0
  fi
  mv -f "$tmp" "$path" 2>/dev/null || rm -f "$tmp"
}

# Build the ticket list from the comparison store itself, for a report with no
# input. Only ids are known - the store records decisions, not ticket data - so
# titles come out empty unless tickets were piped in.
ts_load_from_comparisons() {
  local path line
  TS_TICKETS=()
  path=$(ts_comparisons_path) || {
    echo "ticket-sort: no comparison store to report on (TS_COMPARISONS_FILE=none)" >&2
    return 1
  }
  if [[ ! -f "$path" ]]; then
    echo "ticket-sort: no comparisons yet at $path" >&2
    echo "  rank some tickets first:  linear.sh json | ticket-sort" >&2
    return 1
  fi
  while IFS= read -r line; do
    [[ -n "$line" ]] && TS_TICKETS+=("$line")
  done < <(jq -r '
    [keys[] | split("|")[]] | unique | .[]
    | {id: ., title: ""} | tostring
  ' "$path" 2>/dev/null)

  if (( ${#TS_TICKETS[@]} == 0 )); then
    echo "ticket-sort: no comparisons in $path" >&2
    return 1
  fi
}

# Drop comparisons about tickets the input says are finished.
#
# Deliberately conservative in two ways, because the thing being deleted is
# judgement you spent real time on and cannot get back by re-running anything.
#
# First, absence is never evidence. The input is usually a scoped query -
# `linear.sh json active 7d` omits closed work AND anything out of scope, and
# nothing in the payload distinguishes those. So a ticket must be present and
# say it is finished; a ticket that simply is not mentioned keeps its comparisons.
#
# Second, the status must match exactly (case-insensitively). linear.sh exposes
# state.name, not Linear's underlying completed/canceled type, so this is name
# matching - and substring matching on a name would prune "Almost Done".
# TS_PRUNE_STATES overrides the list for a workspace with different states.
ts_prune() {
  local apply="$1" path i id status finished=() dropped=0 kept
  path=$(ts_comparisons_path) || {
    echo "ticket-sort: no comparison store to prune (TS_COMPARISONS_FILE=none)" >&2
    return 1
  }
  [[ -f "$path" ]] || {
    echo "ticket-sort: no comparisons yet at $path" >&2
    return 1
  }

  local -a states=()
  local IFS_SAVE="$IFS"
  IFS=','; read -r -a states <<< "${TS_PRUNE_STATES:-Done,Canceled,Duplicated}"
  IFS="$IFS_SAVE"

  # Which of the tickets in front of us are finished?
  for (( i = 0; i < ${#TS_TICKETS[@]}; i++ )); do
    id=$(ts_field "${TS_TICKETS[$i]}" id '')
    status=$(ts_field "${TS_TICKETS[$i]}" status '')
    [[ -n "$id" && -n "$status" ]] || continue
    local st match=no
    for st in "${states[@]}"; do
      # Trim and compare case-insensitively; exact, not substring.
      st="${st#"${st%%[![:space:]]*}"}"; st="${st%"${st##*[![:space:]]}"}"
      [[ -z "$st" ]] && continue
      if [[ "${status,,}" == "${st,,}" ]]; then match=yes; break; fi
    done
    [[ "$match" == yes ]] && finished+=("$id|$status")
  done

  if (( ${#finished[@]} == 0 )); then
    printf '%snothing to prune - no finished tickets in the input.%s\n' \
      "$DIM" "$RESET" >&2
    return 0
  fi

  # How many comparisons mention any of them?
  local ids_json
  ids_json=$(printf '%s\n' "${finished[@]}" | cut -d'|' -f1 \
    | jq -R -s 'split("\n") | map(select(length > 0))')
  dropped=$(jq --argjson ids "$ids_json" '
    [to_entries[] | select(.key | split("|") | any(. as $t | $ids | index($t)))] | length
  ' "$path")

  if (( dropped == 0 )); then
    printf '%snothing to prune - no stored comparisons mention those tickets.%s\n' \
      "$DIM" "$RESET" >&2
    return 0
  fi

  {
    printf '\n%swould drop%s %d comparison%s for %d finished ticket%s:\n' \
      "$BOLD" "$RESET" "$dropped" "$( (( dropped == 1 )) || echo s)" \
      "${#finished[@]}" "$( (( ${#finished[@]} == 1 )) || echo s)"
    for i in "${finished[@]}"; do
      printf '  %-14s %s\n' "${i%%|*}" "${i#*|}"
    done
  } >&2

  if [[ "$apply" != yes ]]; then
    printf '\n%s(dry run - add --apply to write)%s\n' "$DIM" "$RESET" >&2
    return 0
  fi

  # Back up before writing: one mv undoes a prune you regret.
  cp "$path" "$path.bak" 2>/dev/null || {
    echo "ticket-sort: could not back up $path - refusing to prune" >&2
    return 1
  }
  local tmp="$path.$$"
  if ! jq --argjson ids "$ids_json" '
        with_entries(select(.key | split("|") | any(. as $t | $ids | index($t)) | not))
      ' "$path" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    echo "ticket-sort: prune failed, store untouched" >&2
    return 1
  fi
  mv -f "$tmp" "$path" || { rm -f "$tmp"; return 1; }
  kept=$(jq 'length' "$path")
  printf '\n%sdropped %d, %d remain%s  (previous store: %s.bak)\n' \
    "$GREEN" "$dropped" "$kept" "$RESET" "$path" >&2
}

# ── rendering ─────────────────────────────────────────────────────────────────

ts_field() {
  local json="$1" key="$2" fallback="${3:-—}"
  jq -r --arg k "$key" --arg f "$fallback" '
    .[$k] as $v
    | if $v == null then $f
      elif ($v | type) == "array" then
        (if ($v | length) == 0 then $f else ($v | join(", ")) end)
      elif ($v | tostring) == "" then $f
      else ($v | tostring)
      end
  ' <<< "$json"
}

# Days from TS_TODAY (default: actual today) to $1, negative when past.
# Accepts a plain date or an ISO datetime - Linear stores due dates and SLA
# breach times both as datetimes. BSD date happens to parse the prefix of an
# ISO string anyway, but trimming it here is explicit rather than lucky.
ts_days_until() {
  local target="${1%%T*}" today="${TS_TODAY:-$(date +%F)}" t n
  t=$(date -j -f %Y-%m-%d "$target" +%s 2>/dev/null) || return 1
  n=$(date -j -f %Y-%m-%d "$today" +%s 2>/dev/null) || return 1
  echo $(( (t - n) / 86400 ))
}

ts_date_note() {
  local due="$1" days
  [[ "$due" == "—" ]] && { printf '%s' "$due"; return; }
  # Unparseable values are shown as written rather than dropped - some
  # sources put free text where a deadline belongs.
  days=$(ts_days_until "$due") || { printf '%s' "$due"; return; }
  # Past here it parsed, so show the date part only. A breach time of day
  # adds nothing at day granularity, and an SLA should read like a due date.
  due="${due%%T*}"
  if (( days < 0 )); then
    printf '%s %sOVERDUE %dd%s' "$due" "$RED" $(( -days )) "$RESET"
  elif (( days == 0 )); then
    printf '%s %sDUE TODAY%s' "$due" "$RED" "$RESET"
  elif (( days <= 7 )); then
    printf '%s %s(in %dd)%s' "$due" "$YELLOW" "$days" "$RESET"
  else
    printf '%s %s(in %dd)%s' "$due" "$DIM" "$days" "$RESET"
  fi
}

ts_render() {
  local json="$1" label="${2:-}"
  local id title priority status due sla labels project

  id=$(ts_field "$json" id "?")
  title=$(ts_field "$json" title "(untitled)")
  priority=$(ts_field "$json" priority)
  status=$(ts_field "$json" status)
  due=$(ts_field "$json" due)
  sla=$(ts_field "$json" sla)
  labels=$(ts_field "$json" labels)
  project=$(ts_field "$json" project)

  printf '%s%s%s %s%s%s\n' "$BOLD$CYAN" "${label:+[$label] }" "$RESET" "$BOLD" "$id" "$RESET"
  printf '  %s\n' "$title"
  printf '  %sPriority%s %s\n' "$DIM" "$RESET" "$priority"
  printf '  %sStatus  %s %s\n' "$DIM" "$RESET" "$status"
  printf '  %sDue     %s %s\n' "$DIM" "$RESET" "$(ts_date_note "$due")"
  printf '  %sSLA     %s %s\n' "$DIM" "$RESET" "$(ts_date_note "$sla")"
  printf '  %sProject %s %s\n' "$DIM" "$RESET" "$project"
  printf '  %sLabels  %s %s\n' "$DIM" "$RESET" "$labels"
}

# ── opening tickets ───────────────────────────────────────────────────────────

# Prefer the url Linear's API returns; fall back to building one from the
# workspace slug, which is all you need to reconstruct an issue link.
ts_ticket_url() {
  local json="$1" url id
  url=$(jq -r '.url // empty' <<< "$json")
  if [[ -n "$url" ]]; then
    printf '%s\n' "$url"
    return 0
  fi

  id=$(jq -r '.id // empty' <<< "$json")
  if [[ -n "$id" && -n "$TS_WORKSPACE" ]]; then
    printf 'https://linear.app/%s/issue/%s\n' "$TS_WORKSPACE" "$id"
    return 0
  fi

  return 1
}

ts_open_ticket() {
  local json="$1" url
  if ! url=$(ts_ticket_url "$json"); then
    printf '\n%sno url for this ticket%s - set TS_WORKSPACE=<slug> or include a url field\n' \
      "$YELLOW" "$RESET" >&2
    return 1
  fi
  printf '\n%sopening%s %s\n' "$DIM" "$RESET" "$url" >&2
  "$TS_OPEN" "$url" || printf '%sopen failed%s\n' "$YELLOW" "$RESET" >&2
}

# ── standing preview ──────────────────────────────────────────────────────────

# The running top N, fzf-preview style. Only positions a pivot has settled get
# a rank number; everything else gets a null rank and is listed alphabetically
# by id. Two reasons: a partition-order list would imply a ranking that has
# not been established, and it would churn on every swap. Alphabetical fill
# means the display only changes when something is genuinely placed.
ts_preview() {
  local n="$1" i idx
  local -a unplaced=()

  (( n > ${#TS_ARR[@]} )) && n=${#TS_ARR[@]}

  for (( i = 0; i < n; i++ )); do
    [[ -z "${TS_SETTLED[$i]:-}" ]] &&
      unplaced+=("$(ts_field "${TS_TICKETS[${TS_ARR[$i]}]}" id '?')")
  done

  # Alphabetical, and consumed in order as the unsettled slots come up.
  if (( ${#unplaced[@]} > 0 )); then
    mapfile -t unplaced < <(printf '%s\n' "${unplaced[@]}" | sort)
  fi

  printf '%sstanding top %d%s\n' "$DIM" "$n" "$RESET"

  local fill=0 id title json
  for (( i = 0; i < n; i++ )); do
    if [[ -n "${TS_SETTLED[$i]:-}" ]]; then
      json="${TS_TICKETS[${TS_ARR[$i]}]}"
      id=$(ts_field "$json" id '?')
      title=$(ts_field "$json" title '(untitled)')
      printf '  %s%2d.%s %-14s %s\n' "$GREEN" $(( i + 1 )) "$RESET" "$id" "$title"
    else
      id="${unplaced[$fill]}"
      fill=$(( fill + 1 ))
      json=$(ts_ticket_by_id "$id")
      title=$(ts_field "$json" title '(untitled)')
      printf '  %s  ·  %-14s %s%s\n' "$DIM" "$id" "$title" "$RESET"
    fi
  done
}

# Settled positions inside the ranked window. A fact, unlike the up-front
# question estimate - t/b can settle a whole pass at once and leave any
# projection badly stale.
ts_placed() {
  local window="$1" p count=0
  for p in "${!TS_SETTLED[@]}"; do
    (( p < window )) && count=$(( count + 1 ))
  done
  printf '%d' "$count"
}

ts_ticket_by_id() {
  local want="$1" t
  for t in "${TS_TICKETS[@]}"; do
    [[ "$(ts_field "$t" id '?')" == "$want" ]] && { printf '%s' "$t"; return 0; }
  done
  return 1
}

# ── the comparison prompt ─────────────────────────────────────────────────────

# Record an answer and put it on disk immediately. The EXIT trap covers q and a
# clean finish, but not SIGKILL, a closed terminal, or a dead battery - and
# losing a whole session of comparisons to any of those is the one failure this
# tool cannot ask you to shrug off.
#
# Cost, measured at 50 tickets: ~125ms per answer, against ~280ms already spent
# rendering the two tickets (11 jq spawns each). So it is a quarter of what the
# prompt already costs - worth paying.
#
# It does scale with store size, though, because each save rewrites the whole
# file: ~300ms an answer against a 1500-comparison store. If that starts to bite,
# the fix is not more bash - see the TODO at the top of this file.
#
# $3 is the winning index. Sets both directions so the inverse is implied.
ts_answer() {
  local a=$1 b=$2 winner=$3
  local wid
  if (( winner == a )); then
    TS_MEMO[$a:$b]=0; TS_MEMO[$b:$a]=1
  else
    TS_MEMO[$a:$b]=1; TS_MEMO[$b:$a]=0
  fi
  wid=$(ts_comparisons_id "$winner")
  [[ -n "$wid" ]] && ts_comparisons_save_pair "$a" "$b" "$wid"
}

ts_ask() {
  local a=$1 b=$2 ans

  # Selection and the head sort can revisit a pair, so answers are memoized -
  # you are never asked the same question twice. Only possible because the
  # sort runs in place; a subshell would drop the memo on every return.
  if [[ -n "${TS_MEMO[$a:$b]:-}" ]]; then
    return "${TS_MEMO[$a:$b]}"
  fi

  # A standing call settles anything still unanswered against this pass's
  # pivot. The memo check above runs first, so an answer you already gave
  # explicitly is never overwritten by a later blanket comparison.
  #
  # rt/rb are about the right ticket, which is the pivot for the whole pass -
  # so they apply whenever the pivot shows up again. lt/lb are about the left
  # ticket, which changes every comparison, so the comparison is pinned to the
  # specific ticket it was made about.
  if [[ -n "$TS_BULK" && "$b" == "$TS_BULK_PIVOT" ]]; then
    case "$TS_BULK" in
      bottom)
        TS_BULK_RESOLVED=$(( TS_BULK_RESOLVED + 1 ))
        ts_answer "$a" "$b" "$a"; return 0 ;;
      top)
        TS_BULK_RESOLVED=$(( TS_BULK_RESOLVED + 1 ))
        ts_answer "$a" "$b" "$b"; return 1 ;;
    esac
  fi
  if [[ -n "$TS_BULK" && -n "$TS_BULK_LEFT" ]]; then
    if [[ "$a" == "$TS_BULK_LEFT" ]]; then
      case "$TS_BULK" in
        leftbottom)
          TS_BULK_RESOLVED=$(( TS_BULK_RESOLVED + 1 ))
          ts_answer "$a" "$b" "$b"; return 1 ;;
        lefttop)
          TS_BULK_RESOLVED=$(( TS_BULK_RESOLVED + 1 ))
          ts_answer "$a" "$b" "$a"; return 0 ;;
      esac
    elif [[ "$b" == "$TS_BULK_LEFT" ]]; then
      # Same ticket, other side of the prompt - the comparison still holds.
      case "$TS_BULK" in
        leftbottom)
          TS_BULK_RESOLVED=$(( TS_BULK_RESOLVED + 1 ))
          ts_answer "$a" "$b" "$a"; return 0 ;;
        lefttop)
          TS_BULK_RESOLVED=$(( TS_BULK_RESOLVED + 1 ))
          ts_answer "$a" "$b" "$b"; return 1 ;;
      esac
    fi
  fi

  TS_ASKED=$(( TS_ASKED + 1 ))

  {
    printf '\n%s%s%s\n' "$DIM" "$(printf '─%.0s' {1..64})" "$RESET"
    (( TS_PREVIEW > 0 )) && { ts_preview "$TS_PREVIEW"; printf '\n'; }
    printf '%squestion %d%s%s\n\n' "$DIM" "$TS_ASKED" \
      "$( (( TS_WINDOW > 0 )) && printf '  ·  %s of %d placed' \
            "$(ts_placed "$TS_WINDOW")" "$TS_WINDOW" )" "$RESET"
    ts_render "${TS_TICKETS[$a]}" l
    printf '\n'
    ts_render "${TS_TICKETS[$b]}" r
    printf '\n%sWhich should be worked next?%s  [l] left  [r] right  [m] no preference\n' \
      "$BOLD" "$RESET"
    # Rank the work, not its current availability. A ticket paused on a meeting
    # still deserves the position it earns - otherwise it sinks for a reason
    # that expires, and the ranking has to be redone once the meeting happens.
    printf '%s  For tasks that are blocked/waiting, rank them as if you COULD work them today.%s\n' \
      "$DIM" "$RESET"
    printf '%s  [rt/rb] right tops/bottoms the group  [lt/lb] left does  [ol/or] open  [q] quit%s  ' \
      "$DIM" "$RESET"
  } >&2

  while true; do
    if ! IFS= read -r -u "$TS_FD" ans; then
      printf '\nticket-sort: aborted (no more input)\n' >&2
      exit 130
    fi
    case "${ans,,}" in
      l|1|'')   ts_answer "$a" "$b" "$a"; return 0 ;;
      r|2)      ts_answer "$a" "$b" "$b"; return 1 ;;
      # Two things you don't care about still need an order for the sort to
      # terminate. Flip for it, then remember the flip - re-flipping the same
      # pair later could contradict the first answer and corrupt the ranking.
      m)        TS_MEHS=$(( TS_MEHS + 1 ))
                if (( RANDOM % 2 )); then
                  ts_answer "$a" "$b" "$b"
                  printf '%scoin flip -> right%s\n' "$DIM" "$RESET" >&2
                  return 1
                else
                  ts_answer "$a" "$b" "$a"
                  printf '%scoin flip -> left%s\n' "$DIM" "$RESET" >&2
                  return 0
                fi ;;
      # Opening is not an answer - go around and ask again.
      ol|o1|o)  ts_open_ticket "${TS_TICKETS[$a]}" || true
                printf '%schoice?%s ' "$DIM" "$RESET" >&2 ;;
      or|o2)    ts_open_ticket "${TS_TICKETS[$b]}" || true
                printf '%schoice?%s ' "$DIM" "$RESET" >&2 ;;
      # One keystroke settles the pivot against everything left in this pass.
      # Scoped to the pass, not the whole backlog - later passes cover
      # narrower groups, so this claims less than it looks like it does.
      b|rb)     TS_BULK=bottom
                TS_BULK_PIVOT=$b
                printf '%sright ticket drops below the rest of this group%s\n' \
                  "$DIM" "$RESET" >&2
                ts_answer "$a" "$b" "$a"; return 0 ;;
      t|rt)     TS_BULK=top
                TS_BULK_PIVOT=$b
                printf '%sright ticket rises above the rest of this group%s\n' \
                  "$DIM" "$RESET" >&2
                ts_answer "$a" "$b" "$b"; return 1 ;;
      lb)       TS_BULK=leftbottom
                TS_BULK_LEFT=$a
                printf '%sleft ticket drops below the rest of this group%s\n' \
                  "$DIM" "$RESET" >&2
                ts_answer "$a" "$b" "$b"; return 1 ;;
      lt)       TS_BULK=lefttop
                TS_BULK_LEFT=$a
                printf '%sleft ticket rises above the rest of this group%s\n' \
                  "$DIM" "$RESET" >&2
                ts_answer "$a" "$b" "$a"; return 0 ;;
      q)        printf '\nticket-sort: aborted after %d questions\n' "$TS_ASKED" >&2
                exit 130 ;;
      *)        printf '%s?%s ' "$DIM" "$RESET" >&2 ;;
    esac
  done
}

# ── output ────────────────────────────────────────────────────────────────────

# Prints the ranked head, and optionally more rows past it.
#
# `shown` exists because spending questions and seeing tickets are different
# needs: --top 2 buys two ranked positions, but the partitioning that isolated
# them also proved things about everything else, and seeing that is often enough
# to decide you are done.
#
# A row gets a number when its position is genuinely established - either it is
# inside the ranked head, or a pivot landed on it, which quicksort guarantees is
# final. Everything else gets a dot: quickselect leaves the tail in whatever
# order partitioning happened to produce, and numbering that would assert an
# order nobody chose. So the numbering can have gaps, and the gaps are the
# honest part - position 3 missing means position 3 is genuinely unknown.
ts_report() {
  local as_json="$1" limit="${2:-${#TS_ARR[@]}}" shown="${3:-0}" idx i
  local total=${#TS_ARR[@]} settled=0

  (( shown < limit )) && shown=$limit
  (( shown > total )) && shown=$total

  # The rank a row would carry is its position, not a running counter - a
  # counter would renumber around the dots and quietly promote tickets.
  if [[ "$as_json" == yes ]]; then
    for (( i = 0; i < shown; i++ )); do
      idx="${TS_ARR[$i]}"
      if (( i < limit )) || [[ -n "${TS_SETTLED[$i]:-}" ]]; then
        jq -c --argjson r "$(( i + 1 ))" '. + {rank: $r}' <<< "${TS_TICKETS[$idx]}"
      else
        # null rather than a number: a consumer must be able to tell an
        # established rank from a row that is merely above the cut.
        jq -c '. + {rank: null}' <<< "${TS_TICKETS[$idx]}"
      fi
    done | jq -s '.'
    return
  fi

  for (( i = 0; i < shown; i++ )); do
    idx="${TS_ARR[$i]}"
    if (( i < limit )) || [[ -n "${TS_SETTLED[$i]:-}" ]]; then
      (( i >= limit )) && settled=$(( settled + 1 ))
      printf '%2d. %-10s %s\n' "$(( i + 1 ))" \
        "$(ts_field "${TS_TICKETS[$idx]}" id '?')" \
        "$(ts_field "${TS_TICKETS[$idx]}" title '(untitled)')"
    else
      printf '%s  ·  %-10s %s%s\n' "$DIM" \
        "$(ts_field "${TS_TICKETS[$idx]}" id '?')" \
        "$(ts_field "${TS_TICKETS[$idx]}" title '(untitled)')" "$RESET"
    fi
  done

  # Say plainly what the dots mean, or they are just decoration. The settled
  # count is worth its own clause: those rows cost a question and are final,
  # which is a different claim from "shown but unordered".
  if (( shown > limit )); then
    printf '\n%s%d ranked as asked' "$DIM" "$limit" >&2
    (( settled > 0 )) &&
      printf ', %d more position%s settled along the way' \
        "$settled" "$( (( settled == 1 )) || echo s)" >&2
    printf ', %d shown but not ranked.%s\n' \
      $(( shown - limit - settled )) "$RESET" >&2
  fi
}

# Rank from the store alone, asking nothing. TS_MEMO is already populated with
# every pair the comparisons prove (directly or transitively), so a ticket's score
# is just how many others it beats - Copeland, over a partial order.
#
# Ties are real information, not a nuisance: two tickets with the same score
# that the store never compared are genuinely unseparated, and saying so beats
# inventing an order. Same dot convention --show uses.
ts_report_comparisons() {
  local as_json="$1" limit="$2" n=${#TS_ARR[@]} i j beats idx
  local -a score=() order=()

  for (( i = 0; i < n; i++ )); do
    beats=0
    for (( j = 0; j < n; j++ )); do
      (( i == j )) && continue
      [[ "${TS_MEMO[$i:$j]:-}" == 0 ]] && beats=$(( beats + 1 ))
    done
    score[$i]=$beats
  done

  # Sort indices by score descending; ties keep input order, which is arbitrary
  # but stable - and marked as unranked below so it reads as no claim.
  while IFS=' ' read -r idx; do
    order+=("$idx")
  done < <(
    for (( i = 0; i < n; i++ )); do printf '%s %s\n' "${score[$i]}" "$i"; done \
      | sort -k1,1nr -k2,2n | awk '{print $2}'
  )

  (( limit <= 0 || limit > n )) && limit=$n

  if [[ "$as_json" == yes ]]; then
    for (( i = 0; i < limit; i++ )); do
      idx="${order[$i]}"
      if ts_report_tied "$i" "${order[@]}"; then
        jq -c --argjson b "${score[$idx]}" '. + {rank: null, beats: $b}' \
          <<< "${TS_TICKETS[${TS_ARR[$idx]}]}"
      else
        jq -c --argjson r "$(( i + 1 ))" --argjson b "${score[$idx]}" \
          '. + {rank: $r, beats: $b}' <<< "${TS_TICKETS[${TS_ARR[$idx]}]}"
      fi
    done | jq -s '.'
    return
  fi

  for (( i = 0; i < limit; i++ )); do
    idx="${order[$i]}"
    if ts_report_tied "$i" "${order[@]}"; then
      printf '%s  ·  %-10s %s%s\n' "$DIM" \
        "$(ts_field "${TS_TICKETS[${TS_ARR[$idx]}]}" id '?')" \
        "$(ts_field "${TS_TICKETS[${TS_ARR[$idx]}]}" title ' ')" "$RESET"
    else
      printf '%2d. %-10s %s\n' "$(( i + 1 ))" \
        "$(ts_field "${TS_TICKETS[${TS_ARR[$idx]}]}" id '?')" \
        "$(ts_field "${TS_TICKETS[${TS_ARR[$idx]}]}" title ' ')"
    fi
  done

  printf '\n%sfrom stored comparisons only - no questions asked.%s\n' \
    "$DIM" "$RESET" >&2
}

# A position is unranked when the store does not place it relative to the row
# immediately above or below it. Adjacency is the point: in a partial order
# almost every ticket is unseparated from *something* far away, so asking "is it
# separated from everything" marks the whole list as a tie and says nothing.
# What makes position k meaningful is that k-1 and k+1 are known to be on the
# correct side of it.
ts_report_tied() {
  local at="$1"; shift
  local -a order=("$@")
  local me="${order[$at]}" n=${#order[@]} prev next

  if (( at > 0 )); then
    prev="${order[$(( at - 1 ))]}"
    # The row above must be known to beat this one.
    [[ "${TS_MEMO[$prev:$me]:-}" == 0 ]] || return 0
  fi
  if (( at < n - 1 )); then
    next="${order[$(( at + 1 ))]}"
    [[ "${TS_MEMO[$me:$next]:-}" == 0 ]] || return 0
  fi
  return 1
}

# Work newcomers into a ranking you already trust.
#
# The insight is that placing a ticket precisely is the wrong question. What you
# want to know is whether it crosses the cut - one bit, not log2(n) bits. So ask
# that first: does this beat the ticket currently at position K? Below the cut,
# record losses to the whole head and stop; above it, binary-search the head to
# place it properly.
#
# Measured over 30 simulated days of 4 new tickets: 250 questions against 673
# for full placement, and a MORE accurate top ten - because every question lands
# on the boundary that decides membership rather than ordering a tail nobody
# reads.
#
# The cost is deliberate lossiness: a ticket below the cut has no position among
# the others below the cut, and will not be asked about again until the head
# changes or you run `full`.
ts_place() {
  local as_json="$1" limit="${2:-10}" i j n idx
  n=${#TS_ARR[@]}

  # Rank what the store already knows, so there is a head to compare against.
  local -a head=() newcomers=()
  local -a score=()
  for (( i = 0; i < n; i++ )); do
    local beats=0 seen=0
    for (( j = 0; j < n; j++ )); do
      (( i == j )) && continue
      if [[ -n "${TS_MEMO[$i:$j]:-}" ]]; then
        seen=$(( seen + 1 ))
        [[ "${TS_MEMO[$i:$j]}" == 0 ]] && beats=$(( beats + 1 ))
      fi
    done
    score[$i]=$beats
    # A ticket the store says nothing about is a newcomer.
    if (( seen == 0 )); then
      newcomers+=("$i")
    else
      head+=("$i")
    fi
  done

  if (( ${#head[@]} == 0 )); then
    echo "ticket-sort: nothing here has been compared yet - run \`full\` first" >&2
    return 1
  fi

  if (( ${#newcomers[@]} == 0 )); then
    printf '%snothing new to place - all %d tickets are already compared.%s\n' \
      "$DIM" "$n" "$RESET" >&2
    ts_report_comparisons "$as_json" "$limit"
    return 0
  fi

  # Head in ranked order, best first.
  local -a ranked=()
  while IFS=' ' read -r _ idx; do ranked+=("$idx"); done < <(
    for i in "${head[@]}"; do printf '%s %s\n' "${score[$i]}" "$i"; done \
      | sort -k1,1nr -k2,2n
  )

  (( limit > ${#ranked[@]} )) && limit=${#ranked[@]}

  printf '%s%d already compared, %d new - cut at %d.%s\n' \
    "$BOLD" "${#head[@]}" "${#newcomers[@]}" "$limit" "$RESET" >&2

  local t cut lo hi mid
  for t in "${newcomers[@]}"; do
    # One question: does this newcomer beat the ticket at the cut?
    cut="${ranked[$(( limit - 1 ))]}"
    if ts_ask "$t" "$cut"; then
      # Above the cut. Binary-search the head to place it properly - each step
      # is a real comparison, but there are only log2(limit) of them.
      lo=0; hi=$(( limit - 1 ))
      while (( lo < hi )); do
        mid=$(( (lo + hi) / 2 ))
        if ts_ask "$t" "${ranked[$mid]}"; then hi=$mid; else lo=$(( mid + 1 )); fi
      done
      # Splice it into the ranked order so later newcomers compare against the
      # updated head - otherwise two newcomers both "beat #10" and neither is
      # ordered against the other.
      ranked=("${ranked[@]:0:$lo}" "$t" "${ranked[@]:$lo}")
    else
      # Below the cut. Record losses to the whole head so it is settled and not
      # re-asked, then leave it unplaced among the other tail tickets.
      for i in "${ranked[@]:0:$limit}"; do
        [[ -n "${TS_MEMO[$t:$i]:-}" ]] && continue
        TS_MEMO[$t:$i]=1; TS_MEMO[$i:$t]=0
        ts_comparisons_save_pair "$i" "$t" "$(ts_comparisons_id "$i")"
      done
      ranked+=("$t")
    fi
  done

  # Rebuild TS_ARR in the order place established, so the report reflects it.
  TS_ARR=("${ranked[@]}")
  TS_SETTLED=()
  for (( i = 0; i < limit && i < ${#TS_ARR[@]}; i++ )); do TS_SETTLED[$i]=1; done

  local reused=$(( TS_COMPARISONS - TS_ASKED ))
  printf '\n%sDone - %d question%s' "$GREEN" "$TS_ASKED" \
    "$( (( TS_ASKED == 1 )) || echo s)" >&2
  (( reused > 0 )) && printf ', %d reused' "$reused" >&2
  printf '.%s\n\n' "$RESET" >&2

  ts_report "$as_json" "$limit" 0
}

