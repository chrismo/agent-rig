#!/bin/bash
# Segment: model name and reasoning effort level
export ASDF_SUPERDB_VERSION=0.4.0

muted_green="\033[2;32m"
color_reset="\033[2;37m"

input="${CLAUDE_STATUS_INPUT:-/tmp/claude-status-input.json}"

model_name=$(super -f line -c 'coalesce(model.display_name, "")' "$input" 2>/dev/null)
if [[ -z "$model_name" ]]; then
  model_name="Claude"
fi

effort=""
# Statusline input now includes effort.level directly (as of ~2.1.7x).
effort=$(super -f line -c 'coalesce(effort.level, "")' "$input" 2>/dev/null)
# Env var override
if [[ -z "$effort" && -n "${CLAUDE_CODE_EFFORT_LEVEL:-}" ]]; then
  effort="$CLAUDE_CODE_EFFORT_LEVEL"
fi
# Fall back to settings.json.
# HEADS UP: Claude Code only writes effortLevel to settings.json when it's
# NOT the default. So if the default changes (5 notches as of ~2.1.7x:
# low/medium/high/xhigh/max, default high), this field will be absent and
# we fall through to the empty case below. Update the empty-string default
# in the case statement to match.
if [[ -z "$effort" ]]; then
  settings_path="${CLAUDE_SETTINGS_PATH:-$HOME/.claude/settings.json}"
  effort=$(super -f line -c 'coalesce(effortLevel, "")' "$settings_path" 2>/dev/null)
fi

dim="\033[38;5;238m"  # dark grey
lit="${muted_green}"
case "$(printf '%s' "$effort" | tr '[:upper:]' '[:lower:]')" in
  low)    bars="${lit}▌${dim}▌▌▌▌${color_reset}" ;;
  medium) bars="${lit}▌▌${dim}▌▌▌${color_reset}" ;;
  high)   bars="${lit}▌▌▌${dim}▌▌${color_reset}" ;;
  xhigh)  bars="${lit}▌▌▌▌${dim}▌${color_reset}" ;;
  max)    bars="${lit}▌▌▌▌▌${color_reset}" ;;
  "")     bars="${lit}▌▌▌${dim}▌▌${color_reset}" ;;  # default: high
  *)      bars="$effort" ;;
esac

printf "%s %b" "$model_name" "$bars"
