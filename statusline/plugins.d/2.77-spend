#!/bin/bash
# Segment: credit spend and its pace against the UTC day.
#
# Layout:  <pct>% <used>/<limit> | 24h [bar] <dur>
#
# This is a shim. The segment is built by claude-daily-spend-statusline.sh in
# the claude-plugins marketplace repo, and this plugin only shells out to it
# and prints what comes back. Nothing about the bar, the colours or the
# countdown is decided here — read the upstream script for any of that.
#
# The arrangement is deliberate. The way to notice that script breaking is to
# run it, not to keep a parallel copy here that drifts. So this machine's status line
# renders from the artifact an outside user gets: a regression upstream shows
# up in this prompt before anyone reports it.
#
# The two segments this replaces (2.77 spend, 2.78 daily bar) were one plugin
# each, joined by the runner. Upstream emits both as one string with its own
# " | " in the middle, so it is one plugin now and 2.78 is gone. Keeping the
# split would have meant cutting upstream's output apart on a separator this
# repo does not control.
#
# The "24h" half is only true while something ratchets the monthly credit
# limit up by one day's worth at each UTC midnight — the API has no native
# daily limit. That ratchet is a third moving part, in neither this repo nor
# the marketplace one. If it stops running, this segment keeps rendering and
# starts lying: the percent becomes percent-of-month.
#
# bin/claude-spend is no longer in this path. It stays as a CLI on PATH —
# `claude-spend` for a one-off reading — but the status line does not use it,
# and upstream does its own fetching and caching (jq, not SuperDB, so the
# script has no dependency beyond what an outside user already has).
#
# Silent on any failure. A status line that breaks the prompt is worse than a
# status line missing a segment.

UPSTREAM="${AGENT_RIG_SPEND_STATUSLINE:-$HOME/dev/claude-plugins/scripts/claude-daily-spend-statusline.sh}"

[[ -f "$UPSTREAM" && -x "$UPSTREAM" ]] || exit 0

# `timeout` is not in the macOS base system, only in coreutils, so it is used
# when present and skipped when not. Upstream caps its own curl at 20s, but
# the cap is upstream's promise rather than this repo's, and a status line
# renders on every keystroke: a hang wedges the prompt instead of merely
# blanking a segment.
timeout_bin=$(command -v timeout || command -v gtimeout)
timeout_secs="${AGENT_RIG_SPEND_TIMEOUT:-10}"

if [[ -n "$timeout_bin" ]]; then
  segment=$("$timeout_bin" "$timeout_secs" "$UPSTREAM" 2>/dev/null) || exit 0
else
  segment=$("$UPSTREAM" 2>/dev/null) || exit 0
fi

[[ -n "$segment" ]] || exit 0

# Upstream emits one line. If it ever emits more, the runner would read the
# extra newlines as line breaks in the status line and mangle the layout, so
# they are folded into the one segment this plugin promises to be.
#
# \r is folded for the same reason and is the worse of the two: a stray
# carriage return does not add a line, it moves the cursor back to the start
# of this one and overwrites the segments already printed to its left.
#
# Substitution rather than `tr`, to avoid a fork per keystroke. ${var//x/y} is
# bash 3.2 — it is ${var,,} and friends that need 4.x.
segment=${segment//$'\n'/ }
segment=${segment//$'\r'/ }

# Whitespace-only survives the -n check above and renders as an empty segment
# with a stray " | " join around it.
[[ -n "${segment//[[:space:]]/}" ]] || exit 0

printf '%s\n' "$segment"
