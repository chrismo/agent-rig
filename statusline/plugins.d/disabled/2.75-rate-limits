#!/bin/bash
# Segment: rate limit usage (5-hour and 7-day windows)
export ASDF_SUPERDB_VERSION=0.3.0
input="${CLAUDE_STATUS_INPUT:-/tmp/claude-status-input.json}"

muted_green="\033[2;32m"
muted_yellow="\033[2;33m"
muted_red="\033[2;31m"
color_reset="\033[2;37m"

FIVE_HOUR_SECONDS=18000
SEVEN_DAY_SECONDS=604800

five_hour=$(super -f line -c 'coalesce(cast(rate_limits.five_hour.used_percentage, <int64>), "")' "$input" 2>/dev/null)
five_hour_resets=$(super -f line -c 'coalesce(cast(rate_limits.five_hour.resets_at, <int64>), "")' "$input" 2>/dev/null)
seven_day=$(super -f line -c 'coalesce(cast(rate_limits.seven_day.used_percentage, <int64>), "")' "$input" 2>/dev/null)
seven_day_resets=$(super -f line -c 'coalesce(cast(rate_limits.seven_day.resets_at, <int64>), "")' "$input" 2>/dev/null)

# Skip entirely if no rate limit data
if [[ -z "$five_hour" && -z "$seven_day" ]]; then
  exit 0
fi

# pace_x100: returns (used / expected) × 100 as integer, or empty when there
# isn't enough timing info to compute it.
pace_x100() {
  local pct=$1 resets_at=$2 window_seconds=$3

  if [[ -z "$resets_at" ]]; then
    echo ""
    return
  fi

  local now elapsed
  now=$(date +%s)
  elapsed=$(( window_seconds - (resets_at - now) ))

  if (( elapsed <= 0 )); then
    echo ""
    return
  fi

  echo $(( pct * window_seconds / elapsed ))
}

# Color: red ≥90 % absolute, yellow at/over pace, green under pace.
colorize() {
  local pct=$1 pace=$2

  if (( pct >= 90 )); then
    echo "$muted_red"
    return
  fi

  if [[ -z "$pace" ]]; then
    if (( pct >= 70 )); then echo "$muted_yellow"; else echo "$muted_green"; fi
    return
  fi

  if (( pace >= 100 )); then
    echo "$muted_yellow"
  else
    echo "$muted_green"
  fi
}

# Wedge fills as the pace ratio climbs. ◑ ≈ on pace, ○ under, ● way over.
wedge() {
  local pct=$1 pace=$2

  if [[ -z "$pace" ]]; then
    if   (( pct >= 90 )); then echo "●"
    elif (( pct >= 70 )); then echo "◕"
    elif (( pct >= 40 )); then echo "◑"
    elif (( pct >= 10 )); then echo "◔"
    else                       echo "○"
    fi
    return
  fi

  if   (( pace <  40 )); then echo "○"
  elif (( pace <  80 )); then echo "◔"
  elif (( pace < 120 )); then echo "◑"
  elif (( pace < 160 )); then echo "◕"
  else                        echo "●"
  fi
}

# Use SuperDB to compute remaining duration from resets_at timestamp
format_remaining() {
  local field=$1
  local dur
  dur=$(super -f line -c "values cast(bucket(cast(${field}.resets_at * 1000000000, <time>) - now(), 1m), <string>)" "$input" 2>/dev/null)
  if [[ -z "$dur" || "$dur" == -* ]]; then
    echo "now"
  else
    echo "$dur"
  fi
}

segments=""
if [[ -n "$five_hour" ]]; then
  pace=$(pace_x100 "$five_hour" "$five_hour_resets" "$FIVE_HOUR_SECONDS")
  c=$(colorize "$five_hour" "$pace")
  w=$(wedge "$five_hour" "$pace")
  remaining=$(format_remaining "rate_limits.five_hour")
  segments="${c}5h ${w} ${five_hour}% (${remaining})${color_reset}"
fi
if [[ -n "$seven_day" ]]; then
  pace=$(pace_x100 "$seven_day" "$seven_day_resets" "$SEVEN_DAY_SECONDS")
  c=$(colorize "$seven_day" "$pace")
  w=$(wedge "$seven_day" "$pace")
  remaining=$(format_remaining "rate_limits.seven_day")
  if [[ -n "$segments" ]]; then
    segments+=" | "
  fi
  segments+="${c}7d ${w} ${seven_day}% (${remaining})${color_reset}"
fi

echo -e "$segments"
