#!/bin/bash

# Set tab status for the current worktree
#
# Usage:
#   tab-status waiting   # 🟡 waiting on external (data team, PR review, etc.)
#   tab-status active    # 🟢 actively working
#   tab-status pr        # 🟣 PR is open; return after review/merge to clean up
#   tab-status paused    # 🔵 paused, will return later
#   tab-status blocked   # 🔴 blocked, needs attention
#   tab-status clear     # remove status (and manual hold)
#   tab-status           # show current status
#   tab-status --hook active  # hook mode: skips if manual hold is set
#   tab-status --title        # output OSC title escape sequence for current status
#
# Status is stored per-worktree in ~/.claude/tab-status/<worktree>
# The set-title.sh script reads this and prepends emoji to tab title.
#
# Manual vs hook mode:
#   Manual calls (no --hook) set a .manual marker that prevents hooks
#   from overwriting the status. Use "clear" to release the hold.

STATUS_DIR="${STATUS_DIR:-$HOME/.claude/tab-status}"

# Get worktree name (directory name)
get_worktree() {
  basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
}

# Map status to emoji
status_emoji() {
  case "$1" in
    waiting) echo "🟡" ;;
    active)  echo "🟢" ;;
    idle)    echo "⚪" ;;
    pr)      echo "🟣" ;;
    paused)  echo "🔵" ;;
    blocked) echo "🔴" ;;
    *)       echo "" ;;
  esac
}

# Current Claude session name (agentName), set by /rename or `claude --name`.
# The name lives in the session transcript as the LAST record of
# type "agent-name" (records are appended, so a mid-session rename adds a new
# one). The transcript path comes from either:
#   - TAB_STATUS_TRANSCRIPT (tests / manual use), or
#   - the hook JSON Claude pipes to stdin (transcript_path field).
# We only read stdin when it's not a TTY, so a human running `tab-status
# --title` at a prompt never blocks on `cat`. Transcripts can be large (MBs),
# so we read from the END (tail -r) and stop at the first match. macOS-only
# (tail -r is BSD); this repo is macOS-only (Ghostty/AppleScript/lsof).
# Prints the name, or nothing when there is no name.
get_agent_name() {
  local transcript="" hook_json
  if [[ -n "${TAB_STATUS_TRANSCRIPT:-}" ]]; then
    transcript="$TAB_STATUS_TRANSCRIPT"
  elif [[ ! -t 0 ]]; then
    hook_json=$(cat 2>/dev/null)
    transcript=$(printf '%s' "$hook_json" \
      | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
  fi

  [[ -z "$transcript" || ! -f "$transcript" ]] && return 0

  tail -r "$transcript" 2>/dev/null \
    | grep -m1 -E '"type"[[:space:]]*:[[:space:]]*"agent-name"' \
    | sed -n 's/.*"agentName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

# Compute the tab title string (pure — no side effects, no terminal writes).
# Format: "{emoji }{dir} ({label})" where label is the git branch, except on the
# default branch (main/master) where it becomes the Claude session name when one
# exists. Outside a git repo: "{emoji }{dir}".
compute_title() {
  local worktree dir_name branch emoji prefix label agent_name
  worktree=$(get_worktree)
  local status_file="$STATUS_DIR/$worktree"

  if [[ -f "$status_file" ]]; then
    emoji=$(status_emoji "$(cat "$status_file")")
    [[ -n "$emoji" ]] && prefix="$emoji "
  fi

  dir_name="$worktree"
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    label="$branch"
    # On the default branch the branch name is uninformative (many tabs read
    # "(main)"); swap in the session name when one exists.
    if [[ "$branch" == "main" || "$branch" == "master" ]]; then
      agent_name=$(get_agent_name)
      [[ -n "$agent_name" ]] && label="$agent_name"
    fi
    printf '%s%s (%s)' "$prefix" "$dir_name" "$label"
  else
    printf '%s%s' "$prefix" "$dir_name"
  fi
}

# Resolve this process's Ghostty pane pts by walking up the process tree to the
# first ancestor with a real controlling terminal (ttysNNN). Hooks run with no
# controlling terminal of their own (so `> /dev/tty` fails), but the claude
# process above us does have the pane's pts. Prints "/dev/ttysNNN" or fails.
resolve_pts() {
  local pid="$PPID" tty
  while [[ "$pid" -gt 1 ]]; do
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    if [[ "$tty" == ttys* ]]; then
      printf '/dev/%s' "$tty"
      return 0
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
  return 1
}

# Deliver the title as a persistent Ghostty TAB title (survives focus changes
# between splits, unlike a per-surface OSC title).
#
# Why not just `printf '\e]0;..' > /dev/tty`: hooks have no controlling
# terminal, so /dev/tty can't be opened. We instead:
#   1. resolve our pane's pts and mark the surface with a unique sentinel (OSC),
#   2. ask Ghostty (1.3.1+) to find that terminal and set its tab title via
#      `perform action set_tab_title:<title>` (osascript works without a tty),
#   3. restore the surface title to the real title (so it's correct even if the
#      osascript step is unavailable — graceful fallback to a surface title).
# A per-pts cache skips the (expensive) osascript when the title is unchanged.
deliver_title() {
  local title="$1"
  local pts; pts=$(resolve_pts) || return 0
  [[ -w "$pts" ]] || return 0

  mkdir -p "$STATUS_DIR"
  local cache="$STATUS_DIR/.delivered-$(basename "$pts")"
  if [[ -f "$cache" && "$(cat "$cache" 2>/dev/null)" == "$title" ]]; then
    return 0
  fi

  local sentinel="__tabstatus__$(basename "$pts")__$$"
  printf '\e]0;%s\a' "$sentinel" > "$pts" 2>/dev/null || return 0

  # Title passed via argv (not interpolated into the script) to avoid quoting
  # issues with spaces/parens in the title.
  osascript - "$sentinel" "$title" >/dev/null 2>&1 <<'OSA'
on run argv
  set sentinel to item 1 of argv
  set theTitle to item 2 of argv
  tell application id "com.mitchellh.ghostty"
    set matches to {}
    repeat 12 times
      set matches to (every terminal whose name is sentinel)
      if (count of matches) > 0 then exit repeat
      delay 0.03
    end repeat
    if (count of matches) is 0 then return
    perform action ("set_tab_title:" & theTitle) on (item 1 of matches)
  end tell
end run
OSA

  # Restore the surface title to the real title (masked by the tab title when
  # set_tab_title succeeded; the visible fallback when it didn't).
  printf '\e]0;%s\a' "$title" > "$pts" 2>/dev/null || true

  printf '%s' "$title" > "$cache" 2>/dev/null || true
}

# ── Background-command detection ────────────────────────────────────────────────
#
# Claude Code runs EVERY Bash tool call detached in its own session (setsid),
# sourcing ~/.claude/shell-snapshots/snapshot-*.sh. Foreground and background
# commands are process-wise identical (same signature, TTY "??", session
# leader) — the ONLY difference is lifetime: a foreground command exists just
# while Claude is mid-turn (blocked on it). So at Stop time, when Claude is no
# longer running anything in the foreground, any live snapshot-child of this
# session's `claude` pid is necessarily a *backgrounded* command. The command's
# PPID is exactly that claude pid, so detection is naturally per-session.

SNAPSHOT_SIG="shell-snapshots/snapshot"

# Walk the PPID chain from $1 (default $$) up to the first ancestor whose command
# starts with "claude". Prints that pid, or nothing.
find_claude_ancestor() {
  local pid="${1:-$$}" cmd
  while [[ "$pid" -gt 1 ]]; do
    cmd=$(ps -o command= -p "$pid" 2>/dev/null)
    if [[ "$cmd" == claude* ]]; then
      printf '%s' "$pid"
      return 0
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
  return 1
}

# Ancestor pids of $1 (default $$) up to and including the claude pid, one per
# line. These are "self": the running hook's own shell is itself a snapshot-child
# of claude and must not be mistaken for a backgrounded command.
self_chain() {
  local pid="${1:-$$}" cmd
  while [[ "$pid" -gt 1 ]]; do
    printf '%s\n' "$pid"
    cmd=$(ps -o command= -p "$pid" 2>/dev/null)
    [[ "$cmd" == claude* ]] && return 0
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
}

# Pure core (testable): read `ps -axo pid=,ppid=,command=` lines from stdin and
# print the pid of every snapshot-child of the claude pid that isn't excluded.
#   $1 = claude pid
#   $2 = newline-separated pids to exclude (the self chain)
filter_bg_commands() {
  local claude_pid="$1" exclude="$2" pid ppid rest
  while read -r pid ppid rest; do
    [[ "$ppid" == "$claude_pid" ]] || continue
    [[ "$rest" == *"$SNAPSHOT_SIG"* ]] || continue
    case $'\n'"$exclude"$'\n' in
      *$'\n'"$pid"$'\n'*) continue ;;
    esac
    printf '%s\n' "$pid"
  done
}

# Does THIS session have a backgrounded command running right now? (exit 0 = yes)
# Test seam: TAB_STATUS_FAKE_BG=1 forces yes, =0 forces no.
has_bg_command() {
  if [[ -n "${TAB_STATUS_FAKE_BG:-}" ]]; then
    [[ "$TAB_STATUS_FAKE_BG" == 1 ]]
    return
  fi
  local claude_pid
  claude_pid=$(find_claude_ancestor) || return 1
  local found
  found=$(ps -axo pid=,ppid=,command= | filter_bg_commands "$claude_pid" "$(self_chain)")
  [[ -n "$found" ]]
}

# Decide the Stop status. A live bg command — or a standing reminder that one
# ran — keeps the tab active (green); otherwise it settles to idle.
#   $1 = bg present (1/0)   $2 = reminder present (1/0)
resolve_stop_status() {
  if [[ "$1" == 1 || "$2" == 1 ]]; then
    echo active
  else
    echo idle
  fi
}

main() {
  local worktree wt_status status_file manual_file reminder_file hook_mode=false

  # Set the Ghostty tab title for the current session/worktree.
  if [[ "${1:-}" == "--title" ]]; then
    deliver_title "$(compute_title)"
    return
  fi

  # Print the computed title string without delivering it (tests / debugging).
  if [[ "${1:-}" == "--print-title" ]]; then
    compute_title
    echo
    return
  fi

  # Check for --hook flag
  if [[ "${1:-}" == "--hook" ]]; then
    hook_mode=true
    shift
  fi

  worktree=$(get_worktree)
  status_file="$STATUS_DIR/$worktree"
  manual_file="$STATUS_DIR/$worktree.manual"
  # Marker that a backgrounded command ran during this idle stretch. It keeps the
  # tab green ("go back, work's still cooking") even after the command finishes,
  # and is cleared only when the user re-engages (UserPromptSubmit -> engage) so
  # Claude's own autonomous continuation (PostToolUse -> active) can't drop it.
  reminder_file="$STATUS_DIR/$worktree.bgreminder"

  mkdir -p "$STATUS_DIR"

  # Resolve Stop-hook pseudo-actions into a concrete status, managing the
  # background-command reminder marker.
  local action="${1:-}" reminder_action=none
  case "$action" in
    stop)
      # Respect manual hold before the (mildly expensive) process scan.
      if [[ "$hook_mode" == true ]] && [[ -f "$manual_file" ]]; then
        return 1
      fi
      local bg=0 rem=0
      has_bg_command && bg=1
      [[ -f "$reminder_file" ]] && rem=1
      action=$(resolve_stop_status "$bg" "$rem")
      [[ "$action" == active ]] && reminder_action=set
      ;;
    engage)
      # The user is back: behave like `active`, but drop the bg reminder so a
      # later quiet Stop can finally settle to idle.
      action=active
      reminder_action=clear
      ;;
  esac

  case "$action" in
    "")
      # Show current status
      if [[ -f "$status_file" ]]; then
        local current
        current=$(cat "$status_file")
        local suffix=""
        [[ -f "$manual_file" ]] && suffix=" (manual hold)"
        echo "$(status_emoji "$current") $current$suffix"
      else
        echo "(no status set)"
      fi
      ;;
    clear)
      rm -f "$status_file" "$manual_file" "$reminder_file"
      echo "Status cleared for $worktree"
      ;;
    waiting|active|idle|pr|paused|blocked)
      # In hook mode, respect manual hold
      if [[ "$hook_mode" == true ]] && [[ -f "$manual_file" ]]; then
        return 1
      fi

      echo "$action" > "$status_file"

      case "$reminder_action" in
        set)   touch "$reminder_file" ;;
        clear) rm -f "$reminder_file" ;;
      esac

      # Manual calls set the hold, hook calls clear it
      if [[ "$hook_mode" == true ]]; then
        rm -f "$manual_file"
      else
        touch "$manual_file"
      fi

      echo "$(status_emoji "$action") $worktree → $action"
      ;;
    *)
      echo "Usage: tab-status [--hook] [waiting|active|pr|paused|blocked|clear]"
      echo ""
      echo "  waiting  🟡  permission prompt / urgent input needed"
      echo "  active   🟢  actively working"
      echo "  idle     ⚪  your turn, no rush"
      echo "  pr       🟣  PR open; return after review/merge to clean up"
      echo "  paused   🔵  parked, will return later"
      echo "  blocked  🔴  can't proceed, external dependency"
      echo "  clear       remove status and manual hold"
      echo ""
      echo "  --hook      hook mode: skip if manual hold is set"
      exit 1
      ;;
  esac

  # Trigger title refresh (calls ghostty_title if available)
  if type ghostty_title &>/dev/null; then
    ghostty_title
  fi
}

# Guard: when sourced (e.g. by bats), define functions but don't run main.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0 2>/dev/null || true
fi

main "$@"
